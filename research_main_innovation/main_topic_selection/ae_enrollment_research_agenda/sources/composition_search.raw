        <span>&nbsp;[<a href="https://arxiv.org/pdf/2608.08516">pdf</a>, <a href="https://arxiv.org/ps/2608.08516">ps</a>, <a href="https://arxiv.org/format/2608.08516">other</a>]&nbsp;</span>
