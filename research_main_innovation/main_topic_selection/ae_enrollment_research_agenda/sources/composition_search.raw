        <span>&nbsp;[<a href="https://arxiv.org/pdf/2603.01564">pdf</a>, <a href="https://arxiv.org/ps/2603.01564">ps</a>, <a href="https://arxiv.org/format/2603.01564">other</a>]&nbsp;</span>
