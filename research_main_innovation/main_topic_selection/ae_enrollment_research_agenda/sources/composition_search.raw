  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2604.24920">arXiv:2604.24920</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2604.24920">pdf</a>, <a href="https://arxiv.org/ps/2604.24920">ps</a>, <a href="https://arxiv.org/format/2604.24920">other</a>]&nbsp;</span>
