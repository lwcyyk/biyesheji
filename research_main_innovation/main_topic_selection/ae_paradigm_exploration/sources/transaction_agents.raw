        <span>&nbsp;[<a href="https://arxiv.org/pdf/2608.22476">pdf</a>, <a href="https://arxiv.org/ps/2608.22476">ps</a>, <a href="https://arxiv.org/format/2608.22476">other</a>]&nbsp;</span>
