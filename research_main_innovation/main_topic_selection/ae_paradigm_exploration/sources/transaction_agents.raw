  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2608.13900">arXiv:2608.13900</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2608.13900">pdf</a>, <a href="https://arxiv.org/ps/2608.13900">ps</a>, <a href="https://arxiv.org/format/2608.13900">other</a>]&nbsp;</span>
