        <span>&nbsp;[<a href="https://arxiv.org/pdf/2609.08472">pdf</a>, <a href="https://arxiv.org/ps/2609.08472">ps</a>, <a href="https://arxiv.org/format/2609.08472">other</a>]&nbsp;</span>
