        <span>&nbsp;[<a href="https://arxiv.org/pdf/2608.11351">pdf</a>, <a href="https://arxiv.org/ps/2608.11351">ps</a>, <a href="https://arxiv.org/format/2608.11351">other</a>]&nbsp;</span>
