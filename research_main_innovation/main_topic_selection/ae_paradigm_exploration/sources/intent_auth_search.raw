        <span>&nbsp;[<a href="https://arxiv.org/pdf/2610.27465">pdf</a>, <a href="https://arxiv.org/ps/2610.27465">ps</a>, <a href="https://arxiv.org/format/2610.27465">other</a>]&nbsp;</span>
