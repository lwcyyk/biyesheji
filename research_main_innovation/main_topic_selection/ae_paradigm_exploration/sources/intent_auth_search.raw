      <a href="/search/?searchtype=author&amp;query=Cheng%2C+Y">Yiming Cheng</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yao%2C+Y">Yizhi Yao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhang%2C+K">Kaijie Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Tang%2C+C">Cheng Tang</a>, 
      
