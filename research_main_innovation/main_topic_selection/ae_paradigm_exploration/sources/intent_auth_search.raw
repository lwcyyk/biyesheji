        <span>&nbsp;[<a href="https://arxiv.org/pdf/2610.16867">pdf</a>, <a href="https://arxiv.org/ps/2610.16867">ps</a>, <a href="https://arxiv.org/format/2610.16867">other</a>]&nbsp;</span>
