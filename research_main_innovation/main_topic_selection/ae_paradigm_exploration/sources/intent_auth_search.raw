        <span>&nbsp;[<a href="https://arxiv.org/pdf/2610.41453">pdf</a>, <a href="https://arxiv.org/ps/2610.41453">ps</a>, <a href="https://arxiv.org/format/2610.41453">other</a>]&nbsp;</span>
