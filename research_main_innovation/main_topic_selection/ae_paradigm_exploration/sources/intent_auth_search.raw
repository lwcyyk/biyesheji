  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2610.21394">arXiv:2610.21394</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2610.21394">pdf</a>, <a href="https://arxiv.org/ps/2610.21394">ps</a>, <a href="https://arxiv.org/format/2610.21394">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
