  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2610.20195">arXiv:2610.20195</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2610.20195">pdf</a>, <a href="https://arxiv.org/ps/2610.20195">ps</a>, <a href="https://arxiv.org/format/2610.20195">other</a>]&nbsp;</span>
