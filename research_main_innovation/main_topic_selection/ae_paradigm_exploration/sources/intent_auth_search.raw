        <span>&nbsp;[<a href="https://arxiv.org/pdf/2610.36584">pdf</a>, <a href="https://arxiv.org/ps/2610.36584">ps</a>, <a href="https://arxiv.org/format/2610.36584">other</a>]&nbsp;</span>
