        <span>&nbsp;[<a href="https://arxiv.org/pdf/2605.16265">pdf</a>, <a href="https://arxiv.org/ps/2605.16265">ps</a>, <a href="https://arxiv.org/format/2605.16265">other</a>]&nbsp;</span>
