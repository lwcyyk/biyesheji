        <span>&nbsp;[<a href="https://arxiv.org/pdf/2606.09935">pdf</a>, <a href="https://arxiv.org/ps/2606.09935">ps</a>, <a href="https://arxiv.org/format/2606.09935">other</a>]&nbsp;</span>
