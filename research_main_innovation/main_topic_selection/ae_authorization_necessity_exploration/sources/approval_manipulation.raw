        <span>&nbsp;[<a href="https://arxiv.org/pdf/2606.13757">pdf</a>, <a href="https://arxiv.org/ps/2606.13757">ps</a>, <a href="https://arxiv.org/format/2606.13757">other</a>]&nbsp;</span>
