ark:#89DDFF"> &quot;</span><span data-fern-style="color:#22863A;--shiki-dark:#C3E88D">2023-10-27T10:00:05Z</span><span data-fern-style="color:#22863A;--shiki-dark:#89DDFF">&quot;</span><span data-fern-style="color:#212121;--shiki-dark:#89DDFF">,</span></span></span></div><div class="code-block-line"><span class="code-block-line-content"><span class="line"><span data-fern-style="color:#D32F2F;--shiki-dark:#89DDFF">    &quot;</span><span data-fern-style="color:#D32F2F;--shiki-dark:#FFCB6B">created_at</span><span data-fern-style="color:#D32F2F;--shiki-dark:#89DDFF">&quot;</span><span data-fern-style="color:#212121;--shiki-dark:#89DDFF">:</span><span data-fern-style="color:#22863A;--shiki-dark:#89DDFF"> &quot;</span><span data-fern-style="color:#22863A;--shiki-dark:#C3E88D">2023-10-27T10:00:00Z</span><span data-fern-style="color:#22863A;--shiki-dark:#89DDFF">&quot;</span></span></span></div><div class="code-block-line"><span class="code-block-line-content"><span class="line"><span data-fern-style="color:#24292EFF;--shiki-dark:#89DDFF">  }</span></span></span></div><div class="code-block-line"><span class="code-block-line-content"><span class="line"><span data-fern-style="color:#24292EFF;--shiki-dark:#89DDFF">}</span></span></span></div></div></div></div></div></div></div></pre></div><!--/$-->
<h3 id="field-descriptions" class="max-md:pr-4" data-state="closed" data-fern-style="cursor:pointer">Field Descriptions</h3>
<ul class="[&amp;&gt;li]:relative [&amp;&gt;li]:before:text-(color:--grayscale-a10) mb-3 list-none pl-3 [&amp;&gt;li]:pl-3 [&amp;&gt;li]:before:absolute [&amp;&gt;li]:before:ml-[-22px] [&amp;&gt;li]:before:mt-[-1px] [&amp;&gt;li]:before:content-[&#x27;⦁&#x27;] [&amp;&gt;li]:before:self-center">
<li class=""><strong class="font-semibold"><code>event_type</code></strong> (<code>string</code>): The event type (e.g. <code>message.received</code>, <code>message.sent</code>, <code>message.delivered</code>). Payload structure varies by event—see <a data-astro-prefetch="viewport" class="fern-mdx-link" href="/events">Webhook Events</a> for each event’s shape.</li>
<li class=""><strong class="font-semibold"><code>event_id</code></strong> (<code>string</code>): A unique identifier for the event. It stays the same across retries and redeliveries of the event, and across every webhook that receives it, so use it as your deduplication key. Its format varies by event type; treat it as an opaque string.</li>
<li class=""><strong class="font-semibold"><code>message</code></strong> (<code>object</code>): A dictionary containing the full details of the received email message.<!-- -->
<ul class="[&amp;&gt;li]:relative [&amp;&gt;li]:before:text-(color:--grayscale-a10) mb-3 list-none pl-3 [&amp;&gt;li]:pl-3 [&amp;&gt;li]:before:absolute [&amp;&gt;li]:before:ml-[-22px] [&amp;&gt;li]:before:mt-[-1px] [&amp;&gt;li]:before:content-[&#x27;⦁&#x27;] [&amp;&gt;li]:before:self-center">
<li class=""><strong class="font-semibold"><code>from_</code></strong> (<code>array&lt;string&gt;</code>): The sender’s email address. Note the trailing underscore to avoid conflict with the Python keyword.</li>
<li class=""><strong class="font-semibold"><code>organization_id</code></strong> (<code>string</code>): The ID of your organization.</li>
<li class=""><strong class="font-semibold"><code>inbox_id</code></strong> (<code>string</code>): The ID of the inbox that received the message.</li>
<li class=""><strong class="font-semibold"><code>thread_id</code></strong> (<code>string</code>): The ID of the conversation thread.</li>
<li class=""><strong class="font-semibold"><code>message_id</code></strong> (<code>string</code>): The unique ID of this specific message.</li>
<li class=""><strong class="font-semibold"><code>labels</code></strong> (<code>array&lt;string&gt;</code>): Labels associated with the message (e.g., <code>received</code>, <code>sent</code>).</li>
<li class=""><strong class="font-semibold"><code>subject</code></strong> (<code>string</code>): The subject line of the email.</li>
<li class=""><strong class="font-semibold"><code>preview</code></strong> (<code>string</code>): A short plain-text preview of the email body.</li>
<li class=""><strong class="font-semibold"><code>text</code></strong> (<code>string</code>): The plain-text body of the email. Omitted when the stored body exceeds the <a data-astro-prefetch="false" class="fern-mdx-link" href="/webhooks-overview#payload-size-limit">64 KiB inline limit</a>; read <code>body_url</code> or fetch the full message via the API instead.</li>
<li class=""><strong class="font-semibold"><code>html</code></strong> (<code>string</code>): The HTML body of the email, if present. Omitted when the stored body exceeds the <a data-astro-prefetch="false" class="fern-mdx-link" href="/webhooks-overview#payload-size-limit">64 KiB inline limit</a>; read <code>body_url</code> or fetch the full message via the API instead.</li>
<li class=""><strong class="font-semibold"><code>body_url</code></strong> (<code>string</code>): Present only when the body was omitted. A pre-signed URL to the stored body, valid until <code>body_expires_at</code> (one hour).</li>
<li class=""><strong class="font-semibold"><code>attachments</code></strong> (<code>array&lt;object&gt;</code>): A list of attachment metadata, each with its own <code>attachment_id</code>, <code>filename</code>, <code>content_type</code>, <code>size</code>, and <code>inline</code> status. Attachment content is not included in the webhook payload; download attachments through the API.</li>
<li class=""><strong class="font-semibold"><code>in_reply_to</code></strong> (<code>string</code>): The <code>message_id</code> of the email this message is a reply to, if applicable.</li>
</ul>
</li>
</ul>
<h2 id="delivery-retries-and-missed-events" class="max-md:pr-4" data-state="closed" data-fern-style="cursor:pointer">Delivery, retries, and missed events</h2>
<h3 id="retries-and-disabled-endpoints" class="max-md:pr-4" data-state="closed" data-fern-style="cursor:pointer">Retries and disabled endpoints</h3>
<p>A delivery attempt succeeds when your endpoint responds with a <code>2xx</code> status within 15 seconds. Any other status, including a redirect, or a slower response counts as a failure. AgentMail retries a failed delivery on this schedule: immediately, then after 5 seconds, 5 minutes, 30 minutes, 2 hours, 5 hours, 10 hours, and 10 hours. That is 8 attempts over about 27.5 hours, after which the event is marked failed for that endpoint.</p>
<p>If every delivery to an endpoint keeps failing for 5 days, the endpoint is disabled automatically. AgentMail does not notify you when this happens: the only signal is that the webhook’s <code>enabled</code> field reads <code>false</code> when you get or list it, so check it from your monitoring. Fix the endpoint, then re-enable it by updating the webhook with <code>&quot;enabled&quot;: true</code>. Events that occurred while it was disabled are not redelivered.</p>
<h3 id="duplicates-and-ordering" class="max-md:pr-4" data-state="closed" data-fern-style="cursor:pointer">Duplicates and ordering</h3>
<p>Delivery is at least once, so your endpoint can receive the same event more than once. Deduplicate on <code>event_id</code>: it is the same on every retry of an event and on every webhook that receives it. The <code>svix-id</code> header stays the same across retries to one webhook, but differs between webhooks registered at different levels (organization, pod, inbox), so do not use it to deduplicate across webhooks.</p>
<p>Events are not guaranteed to arrive in order. Order them by the timestamps in the payload, not by arrival time.</p>
<h3 id="recovering-missed-events" class="max-md:pr-4" data-state="closed" data-fern-style="cursor:pointer">Recovering missed events</h3>
<p>If your endpoint was down or disabled, catch up from the API instead of waiting for redelivery:</p>
<ul class="[&amp;&gt;li]:relative [&amp;&gt;li]:before:text-(color:--grayscale-a10) mb-3 list-none pl-3 [&amp;&gt;li]:pl-3 [&amp;&gt;li]:before:absolute [&amp;&gt;li]:before:ml-[-22px] [&amp;&gt;li]:before:mt-[-1px] [&amp;&gt;li]:before:content-[&#x27;⦁&#x27;] [&amp;&gt;li]:before:self-center">
<li class=""><strong class="font-semibold"><a data-astro-prefetch="viewport" class="fern-mdx-link" href="/api-reference/inboxes/messages/list">List messages</a></strong> with <code>after</code> set to the time of the last event you processed and <code>ascending</code> set to <code>true</code>. Add <code>include_spam</code>, <code>include_blocked</code>, or <code>include_unauthenticated</code> if you subscribe to those events. To skip messages you already handled from webhooks, match on <code>inbox_id</code> plus <code>message_id</code>, not <code>message_id</code> alone: one email sent to several of your inboxes is a separate message in each.</li>
<li class=""><strong class="font-semibold">The <a data-astro-prefetch="viewport" class="fern-mdx-link" href="/api-reference/inboxes/events/list">inbox events feed</a></strong> (<code>GET /inboxes/{inbox_id}/events</code>), which records a <code>label.added</code> event for each label on every new message, including <code>received</code>.</li>
<li class=""><strong class="font-semibold"><a data-astro-prefetch="viewport" class="fern-mdx-link" href="/webhook-polling">Polling webhooks</a></strong> for agents that are often offline. A polling webhook queues events until your agent fetches them, so events wait instead of failing, but it only holds events from after it was created. Polling webhooks are available in the US region only for now.</li>
</ul>
<h2 id="copy-for-cursor--claude" class="max-md:pr-4" data-state="closed" data-fern-style="cursor:pointer">Copy for Cursor / Claude</h2>
<p>Copy one of the blocks below into Cursor or Claude for complete Webhooks API knowledge in one shot.</p>
