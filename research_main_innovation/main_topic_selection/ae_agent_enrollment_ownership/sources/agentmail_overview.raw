r:--grayscale-a12)" data-fern-style="padding-left:0px">Updating event_types on a webhook</a></li><li class="toc-item" data-depth="0" data-toc-state="inactive" data-fern-style="--toc-depth:0"><span aria-hidden="true" class="toc-track"></span><span aria-hidden="true" class="toc-fill"></span><a href="#custom-delivery-headers" class="block break-words text-sm transition-colors hover:transition-none focus-visible:outline-none focus-visible:transition-none text-(color:--grayscale-a11) hover:text-(color:--grayscale-a12) focus-visible:text-(color:--grayscale-a12)" data-fern-style="padding-left:0px">Custom delivery headers</a></li><li class="toc-item" data-depth="0" data-toc-state="inactive" data-fern-style="--toc-depth:0"><span aria-hidden="true" class="toc-track"></span><span aria-hidden="true" class="toc-fill"></span><a href="#scoping-a-webhook-to-a-pod-or-inbox" class="block break-words text-sm transition-colors hover:transition-none focus-visible:outline-none focus-visible:transition-none text-(color:--grayscale-a11) hover:text-(color:--grayscale-a12) focus-visible:text-(color:--grayscale-a12)" data-fern-style="padding-left:0px">Scoping a webhook to a pod or inbox</a></li><li class="toc-item" data-depth="0" data-toc-state="inactive" data-fern-style="--toc-depth:0"><span aria-hidden="true" class="toc-track"></span><span aria-hidden="true" class="toc-fill"></span><a href="#the-webhook-workflow" class="block break-words text-sm transition-colors hover:transition-none focus-visible:outline-none focus-visible:transition-none text-(color:--grayscale-a11) hover:text-(color:--grayscale-a12) focus-visible:text-(color:--grayscale-a12)" data-fern-style="padding-left:0px">The Webhook Workflow</a></li><li class="toc-item" data-depth="0" data-toc-state="inactive" data-step-out="" data-fern-style="--toc-depth:0"><span aria-hidden="true" class="toc-track"></span><span aria-hidden="true" class="toc-fill"></span><svg aria-hidden="true" focusable="false" class="toc-connector toc-connector