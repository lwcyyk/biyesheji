on-none text-(color:--grayscale-a11) hover:text-(color:--grayscale-a12) focus-visible:text-(color:--grayscale-a12)" data-fern-style="padding-left:12px">Field Descriptions</a></li><li class="toc-item" data-depth="0" data-toc-state="inactive" data-step-in="" data-step-out="" data-fern-style="--toc-depth:0"><span aria-hidden="true" class="toc-track"></span><span aria-hidden="true" class="toc-fill"></span><svg aria-hidden="true" focusable="false" class="toc-connector toc-connector-track" width="14" height="16" viewBox="0 0 14 16" data-fern-style="--toc-connector-depth:0"><path d="M1 0C1 8 13 8 13 16"></path></svg><svg aria-hidden="true" focusable="false" class="toc-connector toc-connector-fill" width="14" height="16" viewBox="0 0 14 16" data-fern-style="--toc-connector-depth:0"><path d="M1 0C1 8 13 8 13 16"></path></svg><a href="#delivery-retries-and-missed-events" class="block break-words text-sm transition-colors hover:transition-none focus-visible:outline-none focus-visible:transition-none text-(color:--grayscale-a11) hover:text-(color:--grayscale-a12) focus-visible:text-(color:--grayscale-a12)" data-fern-style="padding-left:0px">Delivery, retries, and missed events</a></li><li class="toc-item" data-depth="1" data-toc-state="inactive" data-step-in="" data-fern-style="--toc-depth:1"><span aria-hidden="true" class="toc-track"></span><span aria-hidden="true" class="toc-fill"></span><a href="#retries-and-disabled-endpoints" class="block break-words text-sm transition-colors hover:transition-none focus-visible:outline-none focus-visible:transition-none text-(color:--grayscale-a11) hover:text-(color:--grayscale-a12) focus-visible:text-(color:--grayscale-a12)" data-fern-style="padding-left:12px">Retries and disabled endpoints</a></li><li class="toc-item" data-depth="1" data-toc-state="inactive" data-fern-style="--toc-depth:1"><span aria-hidden="true" class="toc-track"></span><span aria-hidden="true" class="toc-fill"></span><a href="#duplicates-and-ordering" class="block break-words text-sm transition-colors hover:transition-none focus-visible:outline-none focus-visible:transition-none text-(color:--grayscale-a11) hover:text-(color:--grayscale-a12) focus-visible:text-(color:--grayscale-a12)" data-fern-style="padding-left:12px">Duplicates and ordering</a></li><li class="toc-item" data-depth="1" data-toc-state="inactive" data-step-out="" data-fern-style="--toc-depth:1"><span aria-hidden="true" class="toc-track"></span><span aria-hidden="true" class="toc-fill"></span><svg aria-hidden="true" focusable="false" class="toc-connector toc-connector-track" width="14" height="16" viewBox="0 0 14 16" data-fern-style="--toc-connector-depth:0"><path d="M13 0C13 8 1 8 1 16"></path></svg><svg aria-hidden="true" focusable="false" class="toc-connector toc-connector-fill" width="14" height="16" viewBox="0 0 14 16" data-fern-style="--toc-connector-depth:0"><path d="M13 0C13 8 1 8 1 16"></path></svg><a href="#recovering-missed-events" class="block break-words text-sm transition-colors hover:transition-none focus-visible:outline-none focus-visible:transition-none text-(color:--grayscale-a11) hover:text-(color:--grayscale-a12) focus-visible:text-(color:--grayscale-a12)" data-fern-style="padding-left:12px">Recovering missed events</a></li><li class="toc-item" data-depth="0" data-toc-state="inactive" data-step-in="" data-fern-style="--toc-depth:0"><span aria-hidden="true" class="toc-track"></span><span aria-hidden="true" class="toc-fill"></span><a href="#copy-for-cursor--claude" class="block break-words text-sm transition-colors hover:transition-none focus-visible:outline-none focus-visible:transition-none text-(color:--grayscale-a11) hover:text-(color:--grayscale-a12) focus-visible:text-(color:--grayscale-a12)" data-fern-style="padding-left:0px">Copy for Cursor / Claude</a></li><li class="toc-item" data-depth="0" data-toc-state="inactive" data-fern-style="--toc-depth:0"><span aria-hidden="true" class="toc-track"></span><span aria-hidden="true" class="toc-fill"></span><a href="#next-steps" class="block break-words text-sm transition-colors hover:transition-none focus-visible:outline-none focus-visible:transition-none text-(color:--grayscale-a11) hover:text-(color:--grayscale-a12) focus-visible:text-(color:--grayscale-a12)" data-fern-style="padding-left:0px">Next Steps</a></li></ul><div data-visible="false" aria-hidden="true" class="fern-back-to-top border-border-default ml-3.5 mt-6 border-t pt-4 transition-opacity duration-200 data-[visible=false]:pointer-events-none data-[visible=false]:opacity-0 data-[visible=true]:opacity-100"><button type="button" aria-label="Scroll to top" tabindex="-1" class="text-(color:--grayscale-a11) hover:text-(color:--grayscale-a12) focus-visible:ring-(color:--accent) focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-offset-2 inline-flex cursor-pointer items-center gap-1.5 rounded-sm text-sm">Scroll to top<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up size-4" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></div><!--astro:end--></astro-island></div></aside><div class="fern-layout-content-wrapper min-w-0 flex-1"><div class="fern-layout-guide transition-all duration-500 ease-out"><astro-island uid="frFmt" prefix="r16" component-url="/_astro/layout.CAsVvh11.js" component-export="SetLayout" renderer-url="/_astro/client.Gqj9Jzy6.js" props="{&quot;value&quot;:[0,&quot;guide&quot;]}" ssr client="idle" opts="{&quot;name&quot;:&quot;SetLayout&quot;,&quot;value&quot;:true}"></astro-island><article class="w-content-width max-w-full mx-auto"><header class="my-8 space-y-2"><astro-island uid="1ymMh6" prefix="r17" component-url="/_astro/PageHeaderIsland.Cbs2K8Wg.js" component-export="default" renderer-url="/_astro/client.Gqj9Jzy6.js" props="{&quot;alwaysShowTags&quot;:[0,true],&quot;outerHeader&quot;:[0,true],&quot;title&quot;:[0,&quot;Webhooks Overview&quot;],&quot;titleCode&quot;:[0],&quot;titleIconFallback&quot;:[0],&quot;subtitle&quot;:[0,&quot;Get real-time notifications for email events.&quot;],&quot;subtitleCode&quot;:[0],&quot;subtitleIconFallback&quot;:[0],&quot;breadcrumb&quot;:[1,[[0,{&quot;title&quot;:[0,&quot;Webhooks&quot;],&quot;pointsTo&quot;:[0,&quot;webhooks-overview&quot;]}]]],&quot;domain&quot;:[0,&quot;docs.agentmail.to&quot;],&quot;slug&quot;:[0,&quot;webhooks-overview&quot;],&quot;lang&quot;:[0,&quot;en&quot;],&quot;basepath&quot;:[0,&quot;&quot;],&quot;currentLocale&quot;:[0],&quot;markdown&quot;:[0,&quot;---\n\ntitle: Webhooks Overview\nsubtitle: Get real-time notifications for email events.\nslug: webhooks-overview\ndescription: &gt;-\nLearn how to use Webhooks to build responsive, event-driven email agents with\nAgentMail.\n----------\n\nWebhooks are the best way to get real-time information about what&#39;s happening with your emails. Instead of constantly asking the AgentMail API if there&#39;s a new email (a process called polling), you can register a URL, and we will send you a `POST` request with the details as soon as an event happens.\n\nThis event-driven approach is more efficient and allows you to build fast, responsive agents that can react instantly to incoming messages.\n\n## Why Use Webhooks?\n\n* **Real-Time Speed:** Build conversational agents that can reply to incoming emails in seconds.\n* **Efficiency:** Eliminates the need for constant polling, which saves you computational resources and simplifies your application logic.\n\n&lt;Callout intent=\&quot;info\&quot; title=\&quot;Prefer a simpler setup?\&quot;&gt;\n  If you don&#39;t want to expose a public URL or set up ngrok, [WebSockets](/websockets) let you receive the same events over a persistent connection with no external tooling required. If your agent cannot stay connected either, a [polling webhook](/webhook-polling) queues the events for you to fetch whenever it runs.\n&lt;/Callout&gt;\n\n## Available Events\n\nAgentMail supports twenty webhook event types. When creating a webhook, you list the event types it should receive in `event_types`. The field is required and must name at least one type: there is no \&quot;all events\&quot; default, and a create request without it returns a `400`. See [Webhook Events](/events) for full payload details.\n\n**Message events:**\n\n* **`message.received`** — New email received and processed in one of your inboxes\n* **`message.received.spam`** — A message was received and classified as spam (requires `label_spam_read` permission)\n* **`message.received.blocked`** — A message was received and matched a block list entry (requires `label_blocked_read` permission)\n* **`message.received.unauthenticated`** — A message was delivered with the `unauthenticated` label: none of SPF, DKIM, or DMARC passed, or DMARC failed under the sender&#39;s `none` policy (requires `label_unauthenticated_read` permission)\n* **`message.sent`** — Message successfully sent from your inbox\n* **`message.delivered`** — Delivery confirmed by the recipient&#39;s mail server\n* **`message.bounced`** — Message failed to deliver and bounced back\n* **`message.complained`** — Recipient marked your message as spam\n* **`message.rejected`** — Message rejected before send (validation or policy)\n* **`message.opened`** — A tracked message was opened for the first time (requires [open tracking](/open-tracking))\n* **`message.security.completed`** — [Agent Armor](/agent-armor) reached a verdict on a received message, in Monitor mode (requires `message_read`)\n* **`message.security.review`** — Agent Armor in [Hold mode](/agent-armor#hold-mode) held a received message for review (requires `message_read`)\n* **`message.security.override`** — someone released a message Agent Armor held (requires `message_read`)\n\n**Domain events:**\n\n* **`domain.verified`** — Custom domain successfully verified\n\n**Calendar events** (require `calendar_event_read`; see [Calendar Webhooks](/calendar-webhooks)):\n\n* **`calendar.event.created`** — A calendar event was created, or a date of a recurring event was edited for the first time\n* **`calendar.event.updated`** — A calendar event, or one or more dates of a recurring event, changed or were cancelled\n* **`calendar.event.deleted`** — A one-off or recurring calendar event was deleted\n* **`calendar.event.responded`** — An attendee&#39;s response to an invitation changed\n* **`calendar.event.starting`** — A calendar event, or one date of a recurring event, started\n* **`calendar.event.ending`** — A calendar event, or one date of a recurring event, ended\n\n&lt;Callout intent=\&quot;info\&quot;&gt;\n  Spam, blocked, and unauthenticated events are excluded by default. To receive them, explicitly include `message.received.spam`, `message.received.blocked`, or `message.received.unauthenticated` in the `event_types` list when creating a webhook. These messages are no longer sent as `message.received`.\n&lt;/Callout&gt;\n\n## Updating `event_types` on a webhook\n\nWhen you [update a webhook](/api-reference/webhooks/update), you can change which events it receives by sending `event_types` on `PATCH`:\n\n* **Non-empty array:** Replaces the webhook&#39;s subscribed event types **in full** (same idea as create: you set the whole list, not a diff). If you send only one type, the webhook will only receive that type afterward.\n* **Omitted:** Leaves the current event types unchanged.\n* **Empty array:** Rejected with a `400`. To keep the current event types, omit the field instead. A webhook always has at least one event type; to stop all deliveries, set `enabled` to `false` or delete the webhook.\n\nSubscribing to `message.received.spam`, `message.received.blocked`, or `message.received.unauthenticated` on update still requires the same [label permissions](/permissions) as on create.\n\nSending `\&quot;enabled\&quot;: true` re-enables a disabled webhook, including one disabled after repeated failed deliveries (see [Retries and disabled endpoints](#retries-and-disabled-endpoints)). Re-enabling needs the read permission for every restricted event type the webhook subscribes to: `label_spam_read`, `label_blocked_read`, or `label_unauthenticated_read` for the received variants, `message_read` for `message.security.*`, and `calendar_event_read` for `calendar.event.*`.\n\n## Custom delivery headers\n\nAdd custom HTTP headers when you create a webhook to authenticate AgentMail deliveries with your endpoint or pass routing metadata. The values are write-only: AgentMail sends them with each delivery but never returns them in a webhook response.\n\nUse `get_headers` to list the configured header names without exposing their values. Use the separate `update_headers` method to rotate values, add keys, and remove keys atomically. An update must set at least one header or name at least one header to remove, and the same header cannot appear in both operations regardless of casing.\n\n&lt;CodeBlocks&gt;\n  ```python title=\&quot;Python\&quot;\n  webhook = client.webhooks.create(\n      url=\&quot;https://your-server.com/webhooks\&quot;,\n      event_types=[\&quot;message.received\&quot;],\n      headers={\&quot;Authorization\&quot;: \&quot;Bearer hook-secret\&quot;, \&quot;X-Environment\&quot;: \&quot;production\&quot;},\n  )\n\n  configured = client.webhooks.get_headers(webhook.webhook_id)\n  client.webhooks.update_headers(\n      webhook.webhook_id,\n      headers={\&quot;Authorization\&quot;: \&quot;Bearer rotated-secret\&quot;},\n      remove_headers=[\&quot;X-Environment\&quot;],\n  )\n  ```\n\n  ```typescript title=\&quot;TypeScript\&quot;\n  const webhook = await client.webhooks.create({\n    url: \&quot;https://your-server.com/webhooks\&quot;,\n    eventTypes: [\&quot;message.received\&quot;],\n    headers: { Authorization: \&quot;Bearer hook-secret\&quot;, \&quot;X-Environment\&quot;: \&quot;production\&quot; },\n  });\n\n  const configured = await client.webhooks.getHeaders(webhook.webhookId);\n  await client.webhooks.updateHeaders(webhook.webhookId, {\n    headers: { Authorization: \&quot;Bearer rotated-secret\&quot; },\n    removeHeaders: [\&quot;X-Environment\&quot;],\n  });\n  ```\n&lt;/CodeBlocks&gt;\n\nThe same `headers` create field and `get_headers` / `update_headers` methods are available under `pods.webhooks` and `inboxes.webhooks`. Store header values in a secret manager and rotate them with `update_headers`; retrieving the configured names cannot recover a lost value.\n\n## Scoping a webhook to a pod or inbox\n\nBy default a webhook is registered at the organization level. You can limit it to a [pod](/core-concepts/pods) or inbox in two ways. Both receive the same events; they differ in who owns the webhook:\n\n* **From the organization endpoint:** pass `pod_ids` or `inbox_ids` when you `webhooks.create` (and add or remove them later with `add_pod_ids` / `add_inbox_ids` on update). The webhook still belongs to the organization, so pod- and inbox-scoped API keys cannot see or change it. Use this when one webhook should cover several pods, or when the pod&#39;s own users should not manage it.\n* **From the scoped endpoints:** call `pods.webhooks.create(pod_id, ...)` or `inboxes.webhooks.create(inbox_id, ...)`. The pod or inbox comes from the path, so you don&#39;t pass `pod_ids` / `inbox_ids` in the body. A pod-scoped webhook receives events for the whole pod (optionally narrowed to specific inboxes with `inbox_ids`); an inbox-scoped webhook is fixed to that inbox: it can change its `event_types` and `enabled`, but not which inboxes or pods it covers. The webhook belongs to that pod or inbox.\n\nThe scoped endpoints are the natural fit for [pod- or inbox-scoped API keys](/permissions): such a key can manage only its own webhooks, and a scoped webhook must always keep at least one pod or inbox subscription.\n\nA webhook receives an event that matches any of its pods or inboxes. A pod covers every inbox in it, so adding one of that pod&#39;s inboxes does not narrow the webhook. To receive only specific inboxes, create the webhook with `inbox_ids` and no pod. A webhook can list at most 10 pods and inboxes combined; for example, 6 inboxes and 6 pods is rejected with `limit_exceeded`.\n\n&lt;CodeBlocks&gt;\n  ```python title=\&quot;Python\&quot;\n  # webhook scoped to a single pod\n  client.pods.webhooks.create(\n      pod_id=\&quot;pod_abc123\&quot;,\n      url=\&quot;https://your-server.com/webhooks\&quot;,\n      event_types=[\&quot;message.received\&quot;],\n  )\n\n  # webhook scoped to a single inbox\n  client.inboxes.webhooks.create(\n      inbox_id=\&quot;agent@domain.com\&quot;,\n      url=\&quot;https://your-server.com/webhooks\&quot;,\n      event_types=[\&quot;message.received\&quot;],\n  )\n  ```\n\n  ```typescript title=\&quot;TypeScript\&quot;\n  // webhook scoped to a single pod\n  await client.pods.webhooks.create(\&quot;pod_abc123\&quot;, {\n    url: \&quot;https://your-server.com/webhooks\&quot;,\n    eventTypes: [\&quot;message.received\&quot;],\n  });\n\n  // webhook scoped to a single inbox\n  await client.inboxes.webhooks.create(\&quot;agent@domain.com\&quot;, {\n    url: \&quot;https://your-server.com/webhooks\&quot;,\n    eventTypes: [\&quot;message.received\&quot;],\n  });\n  ```\n\n  ```bash title=\&quot;CLI\&quot;\n  # webhook scoped to a single pod\n  agentmail pods webhooks create \\\n    --pod-id pod_abc123 \\\n    --url https://your-server.com/webhooks \\\n    --event-types message.received\n\n  # webhook scoped to a single inbox\n  agentmail inboxes webhooks create \\\n    --inbox-id agent@domain.com \\\n    --url https://your-server.com/webhooks \\\n    --event-types message.received\n  ```\n&lt;/CodeBlocks&gt;\n\n## The Webhook Workflow\n\nThe process is straightforward:\n\n&lt;Steps&gt;\n  &lt;Step title=\&quot;1. Create a Webhook Endpoint\&quot;&gt;\n    This is a public URL on your server that can accept `POST` requests. For local development, a tool like `ngrok` is perfect for creating a secure, public URL that tunnels to your local machine. Your endpoint should immediately return a `200 OK` response to acknowledge receipt and process the payload in the background to avoid timeouts.\n  &lt;/Step&gt;\n\n  &lt;Step title=\&quot;2. Register the Endpoint with AgentMail\&quot;&gt;\n    You can register your URL using the AgentMail API. When you create a webhook, you&#39;ll specify your endpoint&#39;s URL as well as event types you want to receive.\n\n    &lt;CodeBlocks&gt;\n      ```python\n      client.webhooks.create(\n          url=\&quot;https://&lt;your-ngrok-url&gt;.ngrok-free.app/webhooks\&quot;,\n          event_types=[\&quot;message.received\&quot;, \&quot;message.sent\&quot;],\n      )\n      ```\n\n      ```typescript\n      await client.webhooks.create({\n          url: \&quot;https://&lt;your-ngrok-url&gt;.ngrok-free.app/webhooks\&quot;,\n          eventTypes: [\&quot;message.received\&quot;, \&quot;message.sent\&quot;],\n      });\n      ```\n\n      ```bash title=\&quot;CLI\&quot;\n      # register a webhook endpoint\n      agentmail webhooks create \\\n        --url https://&lt;your-ngrok-url&gt;.ngrok-free.app/webhooks \\\n        --event-types message.received \\\n        --event-types message.sent\n      ```\n    &lt;/CodeBlocks&gt;\n\n    `event_types` is required: list every event type the webhook should receive. Spam, blocked, and unauthenticated events must always be explicitly included.\n  &lt;/Step&gt;\n\n  &lt;Step title=\&quot;3. AgentMail Sends Events\&quot;&gt;\n    When an event occurs (e.g. a new message is received, a message is delivered, or a domain is verified), AgentMail sends a `POST` request with a JSON payload to your registered URL.\n  &lt;/Step&gt;\n&lt;/Steps&gt;\n\n## Payload Structure\n\nWhen AgentMail sends a webhook, the payload includes `event_type` and `event_id`, plus event-specific data. The example below shows a `message.received` payload; other events use different top-level objects (`send`, `delivery`, `bounce`, etc.). See [Webhook Events](/events) for each event&#39;s payload shape.\n\n### Payload size limit\n\n`message.received` and its spam, blocked, and unauthenticated variants include the message body inline only when the stored body is **64 KiB or smaller**. The stored body holds the plain-text and HTML bodies together with their extracted reply content, so the HTML alone can be noticeably smaller than 64 KiB before the limit is reached. Inline images embedded in the HTML (such as base64-encoded data URIs) count toward it and are a common reason for reaching it.\n\nAbove the limit, the payload omits `text`, `html`, `extracted_text`, and `extracted_html`, and carries two fields instead:\n\n* **`body_url`**: a pre-signed URL that downloads the stored body as a JSON object that includes the `text`, `html`, `extracted_text`, and `extracted_html` fields. It is valid for one hour.\n* **`body_expires_at`**: the time at which `body_url` stops working.\n\nAll other message metadata and the `thread` object are still included. Other event types carry no message body.\n\nOmitted content is always available through the API, including after `body_url` expires. After receiving a webhook, fetch the full message to access the complete body and attachment data:\n\n&lt;CodeBlocks&gt;\n  ```python\n  # fetch the full message after receiving a webhook\n  message = client.inboxes.messages.get(\n      inbox_id=payload[\&quot;message\&quot;][\&quot;inbox_id\&quot;],\n      message_id=payload[\&quot;message\&quot;][\&quot;message_id\&quot;],\n  )\n  text_body = message.text\n  html_body = message.html\n  ```\n\n  ```typescript\n  // fetch the full message after receiving a webhook\n  const message = await client.inboxes.messages.get(\n    payload.message.inbox_id,\n    payload.message.message_id,\n  );\n  const textBody = message.text;\n  const htmlBody = message.html;\n  ```\n\n  ```bash title=\&quot;CLI\&quot;\n  # fetch the full message after receiving a webhook\n  agentmail inboxes messages get \\\n    --inbox-id &lt;inbox_id&gt; \\\n    --message-id &lt;message_id&gt;\n  ```\n&lt;/CodeBlocks&gt;\n\n```json Webhook Payload\n{\n  \&quot;event_type\&quot;: \&quot;message.received\&quot;,\n  \&quot;event_id\&quot;: \&quot;c4ca4238a0b923820dcc509a6f75849b\&quot;,\n  \&quot;message\&quot;: {\n    \&quot;from_\&quot;: [\&quot;sender@example.com\&quot;],\n    \&quot;organization_id\&quot;: \&quot;org_abc123...\&quot;,\n    \&quot;inbox_id\&quot;: \&quot;inbox_def456...\&quot;,\n    \&quot;thread_id\&quot;: \&quot;thd_ghi789...\&quot;,\n    \&quot;message_id\&quot;: \&quot;&lt;jkl012@agentmail.to&gt;\&quot;,\n    \&quot;labels\&quot;: [\&quot;received\&quot;],\n    \&quot;timestamp\&quot;: \&quot;2023-10-27T10:00:00Z\&quot;,\n    \&quot;reply_to\&quot;: [\&quot;reply-to@example.com\&quot;],\n    \&quot;to\&quot;: [\&quot;recipient@example.com\&quot;],\n    \&quot;cc\&quot;: [\&quot;cc-recipient@example.com\&quot;],\n    \&quot;bcc\&quot;: [\&quot;bcc-recipient@example.com\&quot;],\n    \&quot;subject\&quot;: \&quot;Email Subject\&quot;,\n    \&quot;preview\&quot;: \&quot;A short preview of the email text...\&quot;,\n    \&quot;text\&quot;: \&quot;The full text body of the email.\&quot;,\n    \&quot;html\&quot;: \&quot;&lt;html&gt;...&lt;/html&gt;\&quot;,\n    \&quot;attachments\&quot;: [\n      {\n        \&quot;attachment_id\&quot;: \&quot;att_pqr678...\&quot;,\n        \&quot;filename\&quot;: \&quot;document.pdf\&quot;,\n        \&quot;content_type\&quot;: \&quot;application/pdf\&quot;,\n        \&quot;size\&quot;: 123456,\n        \&quot;inline\&quot;: false\n      }\n    ],\n    \&quot;in_reply_to\&quot;: \&quot;&lt;parent456@agentmail.to&gt;\&quot;,\n    \&quot;references\&quot;: [\&quot;&lt;ref001@agentmail.to&gt;\&quot;, \&quot;&lt;ref002@agentmail.to&gt;\&quot;],\n    \&quot;sort_key\&quot;: \&quot;some-sort-key\&quot;,\n    \&quot;updated_at\&quot;: \&quot;2023-10-27T10:00:05Z\&quot;,\n    \&quot;created_at\&quot;: \&quot;2023-10-27T10:00:00Z\&quot;\n  }\n}\n```\n\n### Field Descriptions\n\n* **`event_type`** (`string`): The event type (e.g. `message.received`, `message.sent`, `message.delivered`). Payload structure varies by event—see [Webhook Events](/events) for each event&#39;s shape.\n* **`event_id`** (`string`): A unique identifier for the event. It stays the same across retries and redeliveries of the event, and across every webhook that receives it, so use it as your deduplication key. Its format varies by event type; treat it as an opaque string.\n* **`message`** (`object`): A dictionary containing the full details of the received email message.\n  * **`from_`** (`array&lt;string&gt;`): The sender&#39;s email address. Note the trailing underscore to avoid conflict with the Python keyword.\n  * **`organization_id`** (`string`): The ID of your organization.\n  * **`inbox_id`** (`string`): The ID of the inbox that received the message.\n  * **`thread_id`** (`string`): The ID of the conversation thread.\n  * **`message_id`** (`string`): The unique ID of this specific message.\n  * **`labels`** (`array&lt;string&gt;`): Labels associated with the message (e.g., `received`, `sent`).\n  * **`subject`** (`string`): The subject line of the email.\n  * **`preview`** (`string`): A short plain-text preview of the email body.\n  * **`text`** (`string`): The plain-text body of the email. Omitted when the stored body exceeds the [64 KiB inline limit](#payload-size-limit); read `body_url` or fetch the full message via the API instead.\n  * **`html`** (`string`): The HTML body of the email, if present. Omitted when the stored body exceeds the [64 KiB inline limit](#payload-size-limit); read `body_url` or fetch the full message via the API instead.\n  * **`body_url`** (`string`): Present only when the body was omitted. A pre-signed URL to the stored body, valid until `body_expires_at` (one hour).\n  * **`attachments`** (`array&lt;object&gt;`): A list of attachment metadata, each with its own `attachment_id`, `filename`, `content_type`, `size`, and `inline` status. Attachment content is not included in the webhook payload; download attachments through the API.\n  * **`in_reply_to`** (`string`): The `message_id` of the email this message is a reply to, if applicable.\n\n## Delivery, retries, and missed events\n\n### Retries and disabled endpoints\n\nA delivery attempt succeeds when your endpoint responds with a `2xx` status within 15 seconds. Any other status, including a redirect, or a slower response counts as a failure. AgentMail retries a failed delivery on this schedule: immediately, then after 5 seconds, 5 minutes, 30 minutes, 2 hours, 5 hours, 10 hours, and 10 hours. That is 8 attempts over about 27.5 hours, after which the event is marked failed for that endpoint.\n\nIf every delivery to an endpoint keeps failing for 5 days, the endpoint is disabled automatically. AgentMail does not notify you when this happens: the only signal is that the webhook&#39;s `enabled` field reads `false` when you get or list it, so check it from your monitoring. Fix the endpoint, then re-enable it by updating the webhook with `\&quot;enabled\&quot;: true`. Events that occurred while it was disabled are not redelivered.\n\n### Duplicates and ordering\n\nDelivery is at least once, so your endpoint can receive the same event more than once. Deduplicate on `event_id`: it is the same on every retry of an event and on every webhook that receives it. The `svix-id` header stays the same across retries to one webhook, but differs between webhooks registered at different levels (organization, pod, inbox), so do not use it to deduplicate across webhooks.\n\nEvents are not guaranteed to arrive in order. Order them by the timestamps in the payload, not by arrival time.\n\n### Recovering missed events\n\nIf your endpoint was down or disabled, catch up from the API instead of waiting for redelivery:\n\n* **[List messages](/api-reference/inboxes/messages/list)** with `after` set to the time of the last event you processed and `ascending` set to `true`. Add `include_spam`, `include_blocked`, or `include_unauthenticated` if you subscribe to those events. To skip messages you already handled from webhooks, match on `inbox_id` plus `message_id`, not `message_id` alone: one email sent to several of your inboxes is a separate message in each.\n* **The [inbox events feed](/api-reference/inboxes/events/list)** (`GET /inboxes/{inbox_id}/events`), which records a `label.added` event for each label on every new message, including `received`.\n* **[Polling webhooks](/webhook-polling)** for agents that are often offline. A polling webhook queues events until your agent fetches them, so events wait instead of failing, but it only holds events from after it was created. Polling webhooks are available in the US region only for now.\n\n## Copy for Cursor / Claude\n\nCopy one of the blocks below into Cursor or Claude for complete Webhooks API knowledge in one shot.\n\n&lt;CodeBlocks&gt;\n  ```python title=\&quot;Python\&quot;\n  \&quot;\&quot;\&quot;\n  AgentMail Webhooks — copy into Cursor/Claude.\n\n  Setup: pip install agentmail python-dotenv. Set AGENTMAIL_API_KEY in .env.\n  Return 200 immediately; process payload in background.\n\n  API reference:\n  - webhooks.create(url, event_types, inbox_ids?, pod_ids?, client_id?, headers?) (event_types is required and non-empty)\n  - webhooks.get(webhook_id), webhooks.get_headers(webhook_id), webhooks.list(limit?, page_token?)\n  - webhooks.update(webhook_id, add_inbox_ids?, remove_inbox_ids?, add_pod_ids?, remove_pod_ids?, event_types?, enabled?)\n  - webhooks.update_headers(webhook_id, headers?, remove_headers?)\n  - webhooks.delete(webhook_id)\n  - scoped variants: pods.webhooks.* (pod_id) and inboxes.webhooks.* (inbox_id) — same CRUD, scope from the path\n\n  Events: message.received, message.received.spam, message.received.blocked, message.received.unauthenticated, message.sent, message.delivered, message.bounced, message.complained, message.rejected, message.opened, message.security.completed, message.security.review, message.security.override, domain.verified, calendar.event.created, calendar.event.updated, calendar.event.deleted, calendar.event.responded, calendar.event.starting, calendar.event.ending (calendar events need calendar_event_read)\n  Payload: event_type, event_id, plus message/send/delivery/bounce/complaint/reject/domain; calendar.event.* carry inbox_id and calendar_event. Verify with Svix (webhook.secret).\n  Custom delivery header values are write-only. get_headers returns names only; update_headers rotates or removes them.\n  Note: message.received.spam, message.received.blocked, and message.received.unauthenticated are excluded by default. To receive them, explicitly include them in event_types and ensure the API key has the label_spam_read / label_blocked_read / label_unauthenticated_read permission for each.\n  On update, non-empty event_types replaces the subscribed list in full; omit it to leave types unchanged ([] is rejected with 400).\n  message.received* inlines the body only up to 64 KiB of stored body; above that, text/html/extracted_* are omitted and body_url (valid 1 hour) + body_expires_at are sent.\n  Delivery is at least once: dedupe on event_id (same across retries and across webhooks), not svix-id. Retries: 8 attempts over ~27.5h; an endpoint failing for 5 days is disabled (enabled: false) with no notification; re-enable with enabled=True.\n  \&quot;\&quot;\&quot;\n  import os\n  from dotenv import load_dotenv\n  from agentmail import AgentMail\n\n  load_dotenv()\n  client = AgentMail(api_key=os.getenv(\&quot;AGENTMAIL_API_KEY\&quot;))\n\n  wh = client.webhooks.create(url=\&quot;https://your-server.com/webhooks\&quot;, event_types=[\&quot;message.received\&quot;], client_id=\&quot;my-webhook-v1\&quot;)\n  all_wh = client.webhooks.list()\n  secret = client.webhooks.get(wh.webhook_id).secret\n  ```\n\n  ```typescript title=\&quot;TypeScript\&quot;\n  /**\n   * AgentMail Webhooks — copy into Cursor/Claude.\n   *\n   * Setup: npm install agentmail dotenv. Set AGENTMAIL_API_KEY in .env.\n   * Return 200 immediately; process payload in background.\n   *\n   * API reference:\n   * - webhooks.create({ url, eventTypes, inboxIds?, podIds?, clientId?, headers? }) (eventTypes is required and non-empty)\n   * - webhooks.get(webhookId), webhooks.getHeaders(webhookId), webhooks.list({ limit?, pageToken? })\n   * - webhooks.update(webhookId, { addInboxIds?, removeInboxIds?, addPodIds?, removePodIds?, eventTypes?, enabled? })\n   * - webhooks.updateHeaders(webhookId, { headers?, removeHeaders? })\n   * - webhooks.delete(webhookId)\n   * - scoped variants: pods.webhooks.* (podId) and inboxes.webhooks.* (inboxId) — same CRUD, scope from the path\n   *\n   * Events: message.received, message.received.spam, message.received.blocked, message.received.unauthenticated, message.sent, message.delivered, message.bounced, message.complained, message.rejected, message.opened, message.security.completed, message.security.review, message.security.override, domain.verified, calendar.event.created, calendar.event.updated, calendar.event.deleted, calendar.event.responded, calendar.event.starting, calendar.event.ending (calendar events need calendar_event_read)\n   * Custom delivery header values are write-only. getHeaders returns names only; updateHeaders rotates or removes them.\n   * Note: message.received.spam, message.received.blocked, and message.received.unauthenticated are excluded by default. To receive them, explicitly include them in eventTypes and ensure the API key has the label_spam_read / label_blocked_read / label_unauthenticated_read permission for each.\n   * On update, non-empty eventTypes replaces the subscribed list in full; omit it to leave types unchanged ([] is rejected with 400).\n   * message.received* inlines the body only up to 64 KiB of stored body; above that, text/html/extracted_* are omitted and body_url (valid 1 hour) + body_expires_at are sent.\n   * Delivery is at least once: dedupe on event_id (same across retries and across webhooks), not svix-id. Retries: 8 attempts over ~27.5h; an endpoint failing for 5 days is disabled (enabled: false) with no notification; re-enable with enabled: true.\n   * Verify with Svix using webhook.secret. Use express.raw() for body—signature needs raw payload.\n   */\n  import { AgentMailClient } from \&quot;agentmail\&quot;;\n  import \&quot;dotenv/config\&quot;;\n\n  const client = new AgentMailClient({ apiKey: process.env.AGENTMAIL_API_KEY! });\n\n  async function main() {\n    const wh = await client.webhooks.create({\n      url: \&quot;https://your-server.com/webhooks\&quot;,\n      eventTypes: [\&quot;message.received\&quot;],\n      clientId: \&quot;my-webhook-v1\&quot;,\n    });\n    const allWh = await client.webhooks.list();\n    const secret = (await client.webhooks.get(wh.webhookId)).secret;\n  }\n  main();\n  ```\n&lt;/CodeBlocks&gt;\n\n## Next Steps\n\n&lt;CardGroup&gt;\n  &lt;Card title=\&quot;Webhook Events\&quot; href=\&quot;/events\&quot;&gt;\n    Explore the full list of available event types and their data payloads.\n  &lt;/Card&gt;\n\n  &lt;Card title=\&quot;Verifying Webhooks\&quot; href=\&quot;/webhook-verification\&quot;&gt;\n    Learn how to verify webhook signatures to secure your endpoints.\n  &lt;/Card&gt;\n\n  &lt;Card title=\&quot;WebSockets\&quot; href=\&quot;/websockets\&quot;&gt;\n    Receive events over a persistent connection with no public URL required.\n  &lt;/Card&gt;\n\n  &lt;Card title=\&quot;Polling Webhooks\&quot; href=\&quot;/webhook-polling\&quot;&gt;\n    Fetch queued events from an agent that cannot accept inbound HTTP or stay connected.\n  &lt;/Card&gt;\n\n  &lt;Card title=\&quot;Example: Event-Driven Agent\&quot; href=\&quot;/github-star-agent\&quot;&gt;\n    Build a fully deployable, event-driven agent that can respond to emails in\n    real time.\n  &lt;/Card&gt;\n&lt;/CardGroup&gt;\n&quot;],&quot;perViewerCopy&quot;:[0,false],&quot;askAiEnabled&quot;:[0,true],&quot;skillsConfig&quot;:[0],&quot;availability&quot;:[0],&quot;pageActions&quot;:[0],&quot;pageActionsStyle&quot;:[0,&quot;default&quot;],&quot;pageActionFiles&quot;:[0],&quot;showRssFeedButton&quot;:[0,false],&quot;showPageActions&quot;:[0,true]}" ssr client="deferred" opts="{&quot;name&quot;:&quot;PageHeaderIsland&quot;,&quot;value&quot;:true}" await-children><!--$--><div class="space-y-2"><div class="flex justify-between"><span class="fern-breadcrumb"><a data-astro-prefetch="viewport" class="fern-breadcrumb-item" href="/webhooks-overview">Webhooks</a></span></div><div class="flex flex-row items-center justify-between gap-2"><div class="flex flex-row items-center gap-4"><div class="flex flex-row items-center" data-fern-style="gap:8px"><h1 class="fern-page-heading text-balance wrap-anywhere">Webhooks Overview</h1></div><span class="inline-flex items-center gap-2"></span></div><div class="hidden md:flex"><div class="fern-page-actions"><button tabindex="0" data-state="off" aria-disabled="false" class="w-fit px-2 rounded-r-none fern-button minimal normal"><span class="fern-button-content"><span class="fern-button-text"><div class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-copy size-icon animate-in fade-in duration-200"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg><span class="animate-in fade-in duration-300">Copy page</span></div></span></span></button><button tabindex="0" data-state="off" aria-disabled="false" class="group rounded-l-none px-2 fern-button minimal normal"><span class="fern-button-content"><span class="fern-button-text"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down size-icon animate-dropdown-chevron"><path d="m6 9 6 6 6-6"></path></svg></span></span></button></div></div></div><div class="fern-page-subtitle prose-p:text-(color:--grayscale-a11) mt-2 break-words leading-7"><p>Get real-time notifications for email events.</p></div></div><!--/$--><!--astro:end--></astro-island></header><div class="fern-prose prose break-words prose-h1:mt-[1.5em] first:prose-h1:mt-0 max-w-full"><astro-island uid="1TDorz" prefix="r11" component-url="/_astro/MdxContentIsland.B0IAoaXj.js" component-export="default" renderer-url="/_astro/client.Gqj9Jzy6.js" props="{&quot;code&quot;:[0,&quot;/_fern-files/_mdx/caebcc037eb3fedbaafccea5eb499ddb646df1360f7855ac2d9a9393358a34a8.js&quot;],&quot;iconFallback&quot;:[0,{}],&quot;basepath&quot;:[0,&quot;&quot;],&quot;currentLocale&quot;:[0],&quot;pathname&quot;:[0,&quot;/webhooks-overview&quot;],&quot;defaultLanguage&quot;:[0,&quot;python&quot;],&quot;navigationContext&quot;:[0,{&quot;productId&quot;:[0],&quot;productTitle&quot;:[0],&quot;productSlug&quot;:[0],&quot;versionId&quot;:[0],&quot;versionTitle&quot;:[0],&quot;versionSlug&quot;:[0]}]}" ssr client="deferred" opts="{&quot;name&quot;:&quot;MdxContentIsland&quot;,&quot;value&quot;:true}" await-children><!--$--><div data-fern-style="display:contents"><p>Webhooks are the best way to get real-time information about what’s happening with your emails. Instead of constantly asking the AgentMail API if there’s a new email (a process called polling), you can register a URL, and we will send you a <code>POST</code> request with the details as soon as an event happens.</p>
<p>This event-driven approach is more efficient and allows you to build fast, responsive agents that can react instantly to incoming messages.</p>
<h2 id="why-use-webhooks" class="max-md:pr-4" data-state="closed" data-fern-style="cursor:pointer">Why Use Webhooks?</h2>
<ul class="[&amp;&gt;li]:relative [&amp;&gt;li]:before:text-(color:--grayscale-a10) mb-3 list-none pl-3 [&amp;&gt;li]:pl-3 [&amp;&gt;li]:before:absolute [&amp;&gt;li]:before:ml-[-22px] [&amp;&gt;li]:before:mt-[-1px] [&amp;&gt;li]:before:content-[&#x27;⦁&#x27;] [&amp;&gt;li]:before:self-center">
<li class=""><strong class="font-semibold">Real-Time Speed:</strong> Build conversational agents that can reply to incoming emails in seconds.</li>
<li class=""><strong class="font-semibold">Efficiency:</strong> Eliminates the need for constant polling, which saves you computational resources and simplifies your application logic.</li>
</ul>
<div data-intent="info" class="fern-callout"><div class="flex items-start space-x-4"><div class="[&amp;_svg]:size-icon-md mt-0.5 w-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></div><div class="-my-4 flex-1 overflow-x-auto text-sm before:mb-4 before:block after:mt-4 after:block"><div class="font-heading text-base font-semibold leading-snug">Prefer a simpler setup?</div><p>If you don’t want to expose a public URL or set up ngrok, <a data-astro-prefetch="viewport" class="fern-mdx-link" href="/websockets">WebSockets</a> let you receive the same events over a persistent connection with no external tooling required. If your agent cannot stay connected either, a <a data-astro-prefetch="viewport" class="fern-mdx-link" href="/webhook-polling">polling webhook</a> queues the events for you to fetch whenever it runs.</p></div></div></div>
<h2 id="available-events" class="max-md:pr-4" data-state="closed" data-fern-style="cursor:pointer">Available Events</h2>
<p>AgentMail supports twenty webhook event types. When creating a webhook, you list the event types it should receive in <code>event_types</code>. The field is required and must name at least one type: there is no “all events” default, and a create request without it returns a <code>400</code>. See <a data-astro-prefetch="viewport" class="fern-mdx-link" href="/events">Webhook Events</a> for full payload details.</p>
<p><strong class="font-semibold">Message events:</strong></p>
<ul class="[&amp;&gt;li]:relative [&amp;&gt;li]:before:text-(color:--grayscale-a10) mb-3 list-none pl-3 [&amp;&gt;li]:pl-3 [&amp;&gt;li]:before:absolute [&amp;&gt;li]:before:ml-[-22px] [&amp;&gt;li]:before:mt-[-1px] [&amp;&gt;li]:before:content-[&#x27;⦁&#x27;] [&amp;&gt;li]:before:self-center">
<li class=""><strong class="font-semibold"><code>message.received</code></strong> — New email received and processed in one of your inboxes</li>
<li class=""><strong class="font-semibold"><code>message.received.spam</code></strong> — A message was received and classified as spam (requires <code>label_spam_read</code> permission)</li>
<li class=""><strong class="font-semibold"><code>message.received.blocked</code></strong> — A message was received and matched a block list entry (requires <code>label_blocked_read</code> permission)</li>
<li class=""><strong class="font-semibold"><code>message.received.unauthenticated</code></strong> — A message was delivered with the <code>unauthenticated</code> label: none of SPF, DKIM, or DMARC passed, or DMARC failed under the sender’s <code>none</code> policy (requires <code>label_unauthenticated_read</code> permission)</li>
<li class=""><strong class="font-semibold"><code>message.sent</code></strong> — Message successfully sent from your inbox</li>
<li class=""><strong class="font-semibold"><code>message.delivered</code></strong> — Delivery confirmed by the recipient’s mail server</li>
<li class=""><strong class="font-semibold"><code>message.bounced</code></strong> — Message failed to deliver and bounced back</li>
<li class=""><strong class="font-semibold"><code>message.complained</code></strong> — Recipient marked your message as spam</li>
<li class=""><strong class="font-semibold"><code>message.rejected</code></strong> — Message rejected before send (validation or policy)</li>
<li class=""><strong class="font-semibold"><code>message.opened</code></strong> — A tracked message was opened for the first time (requires <a data-astro-prefetch="viewport" class="fern-mdx-link" href="/open-tracking">open tracking</a>)</li>
<li class=""><strong class="font-semibold"><code>message.security.completed</code></strong> — <a data-astro-prefetch="viewport" class="fern-mdx-link" href="/agent-armor">Agent Armor</a> reached a verdict on a received message, in Monitor mode (requires <code>message_read</code>)</li>
<li class=""><strong class="font-semibold"><code>message.security.review</code></strong> — Agent Armor in <a data-astro-prefetch="viewport" class="fern-mdx-link" href="/agent-armor#hold-mode">Hold mode</a> held a received message for review (requires <code>message_read</code>)</li>
<li class=""><strong class="font-semibold"><code>message.security.override</code></strong> — someone released a message Agent Armor held (requires <code>message_read</code>)</li>
</ul>
<p><strong class="font-semibold">Domain events:</strong></p>
<ul class="[&amp;&gt;li]:relative [&amp;&gt;li]:before:text-(color:--grayscale-a10) mb-3 list-none pl-3 [&amp;&gt;li]:pl-3 [&amp;&gt;li]:before:absolute [&amp;&gt;li]:before:ml-[-22px] [&amp;&gt;li]:before:mt-[-1px] [&amp;&gt;li]:before:content-[&#x27;⦁&#x27;] [&amp;&gt;li]:before:self-center">
<li class=""><strong class="font-semibold"><code>domain.verified</code></strong> — Custom domain successfully verified</li>
</ul>
<p><strong class="font-semibold">Calendar events</strong> (require <code>calendar_event_read</code>; see <a data-astro-prefetch="viewport" class="fern-mdx-link" href="/calendar-webhooks">Calendar Webhooks</a>):</p>
<ul class="[&amp;&gt;li]:relative [&amp;&gt;li]:before:text-(color:--grayscale-a10) mb-3 list-none pl-3 [&amp;&gt;li]:pl-3 [&amp;&gt;li]:before:absolute [&amp;&gt;li]:before:ml-[-22px] [&amp;&gt;li]:before:mt-[-1px] [&amp;&gt;li]:before:content-[&#x27;⦁&#x27;] [&amp;&gt;li]:before:self-center">
<li class=""><strong class="font-semibold"><code>calendar.event.created</code></strong> — A calendar event was created, or a date of a recurring event was edited for the first time</li>
<li class=""><strong class="font-semibold"><code>calendar.event.updated</code></strong> — A calendar event, or one or more dates of a recurring event, changed or were cancelled</li>
<li class=""><strong class="font-semibold"><code>calendar.event.deleted</code></strong> — A one-off or recurring calendar event was deleted</li>
<li class=""><strong class="font-semibold"><code>calendar.event.responded</code></strong> — An attendee’s response to an invitation changed</li>
<li class=""><strong class="font-semibold"><code>calendar.event.starting</code></strong> — A calendar event, or one date of a recurring event, started</li>
<li class=""><strong class="font-semibold"><code>calendar.event.ending</code></strong> — A calendar event, or one date of a recurring event, ended</li>
</ul>
<div data-intent="info" class="fern-callout"><div class="flex items-start space-x-4"><div class="[&amp;_svg]:size-icon-md mt-0.5 w-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></div><div class="-my-4 flex-1 overflow-x-auto text-sm before:mb-4 before:block after:mt-4 after:block"><div class="font-heading text-base font-semibold leading-snug"></div><p>Spam, blocked, and unauthenticated events are excluded by default. To receive them, explicitly include <code>message.received.spam</code>, <code>message.received.blocked</code>, or <code>message.received.unauthenticated</code> in the <code>event_types</code> list when creating a webhook. These messages are no longer sent as <code>message.received</code>.</p></div></div></div>
<h2 id="updating-event_types-on-a-webhook" class="max-md:pr-4" data-state="closed" data-fern-style="cursor:pointer">Updating <code>event_types</code> on a webhook</h2>
<p>When you <a data-astro-prefetch="viewport" class="fern-mdx-link" href="/api-reference/webhooks/update">update a webhook</a>, you can change which events it receives by sending <code>event_types</code> on <code>PATCH</code>:</p>
<ul class="[&amp;&gt;li]:relative [&amp;&gt;li]:before:text-(color:--grayscale-a10) mb-3 list-none pl-3 [&amp;&gt;li]:pl-3 [&amp;&gt;li]:before:absolute [&amp;&gt;li]:before:ml-[-22px] [&amp;&gt;li]:before:mt-[-1px] [&amp;&gt;li]:before:content-[&#x27;⦁&#x27;] [&amp;&gt;li]:before:self-center">
<li class=""><strong class="font-semibold">Non-empty array:</strong> Replaces the webhook’s subscribed event types <strong class="font-semibold">in full</strong> (same idea as create: you set the whole list, not a diff). If you send only one type, the webhook will only receive that type afterward.</li>
<li class=""><strong class="font-semibold">Omitted:</strong> Leaves the current event types unchanged.</li>
<li class=""><strong class="font-semibold">Empty array:</strong> Rejected with a <code>400</code>. To keep the current event types, omit the field instead. A webhook always has at least one event type; to stop all deliveries, set <code>enabled</code> to <code>false</code> or delete the webhook.</li>
</ul>
<p>Subscribing to <code>message.received.spam</code>, <code>message.received.blocked</code>, or <code>message.received.unauthenticated</code> on update still requires the same <a data-astro-prefetch="viewport" class="fern-mdx-link" href="/permissions">label permissions</a> as on create.</p>
<p>Sending <code>&quot;enabled&quot;: true</code> re-enables a disabled webhook, including one disabled after repeated failed deliveries (see <a data-astro-prefetch="false" class="fern-mdx-link" href="/webhooks-overview#retries-and-disabled-endpoints">Retries and disabled endpoints</a>). Re-enabling needs the read permission for every restricted event type the webhook subscribes to: <code>label_spam_read</code>, <code>label_blocked_read</code>, or <code>label_unauthenticated_read</code> for the received variants, <code>message_read</code> for <code>message.security.*</code>, and <code>calendar_event_read</code> for <code>calendar.event.*</code>.</p>
<h2 id="custom-delivery-headers" class="max-md:pr-4" data-state="closed" data-fern-style="cursor:pointer">Custom delivery headers</h2>
<p>Add custom HTTP headers when you create a webhook to authenticate AgentMail deliveries with your endpoint or pass routing metadata. The values are write-only: AgentMail sends them with each delivery but never returns them in a webhook response.</p>
<p>Use <code>get_headers</code> to list the configured header names without exposing their values. Use the separate <code>update_headers</code> method to rotate values, add keys, and remove keys atomically. An update must set at least one header or name at least one header to remove, and the same header cannot appear in both operations regardless of casing.</p>
