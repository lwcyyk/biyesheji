&quot;tab&quot;],&quot;id&quot;:[0,&quot;tab:knowledge-base&quot;],&quot;title&quot;:[0,&quot;Knowledge Base&quot;],&quot;slug&quot;:[0,&quot;knowledge-base&quot;],&quot;icon&quot;:[0,&quot;light book-open&quot;],&quot;hidden&quot;:[0,false],&quot;canonicalSlug&quot;:[0],&quot;collapsed&quot;:[0],&quot;viewers&quot;:[0],&quot;orphaned&quot;:[0],&quot;featureFlags&quot;:[0],&quot;pointsTo&quot;:[0,&quot;knowledge-base&quot;],&quot;child&quot;:[0,{&quot;type&quot;:[0,&quot;sidebarRoot&quot;],&quot;id&quot;:[0,&quot;sidebar:|||6bf03640cf694c13c041607ff852665e663cc8d7bd114bdc977d0d634330af14&quot;],&quot;collapsed&quot;:[0],&quot;children&quot;:[1,[]]}]}],[0,{&quot;type&quot;:[0,&quot;changelog&quot;],&quot;id&quot;:[0,&quot;changelog:changelog&quot;],&quot;title&quot;:[0,&quot;Changelog&quot;],&quot;slug&quot;:[0,&quot;changelog&quot;],&quot;icon&quot;:[0,&quot;light clock&quot;],&quot;hidden&quot;:[0,false],&quot;orphaned&quot;:[0],&quot;canonicalSlug&quot;:[0],&quot;collapsed&quot;:[0],&quot;viewers&quot;:[0],&quot;featureFlags&quot;:[0],&quot;overviewPageId&quot;:[0,&quot;changelog/overview.mdx&quot;],&quot;noindex&quot;:[0],&quot;children&quot;:[1,[]]}]]],&quot;tabsPlacement&quot;:[0,&quot;HEADER&quot;],&quot;currentTabId&quot;:[0,&quot;tab:documentation&quot;],&quot;tabPreResolvedIconSvgs&quot;:[0,{&quot;changelog:changelog&quot;:[0,{&quot;viewBox&quot;:[0,&quot;0 0 512 512&quot;],&quot;body&quot;:[0,&quot;&lt;use href=\&quot;#fern-icon-1dpzkon7v\&quot;&gt;&lt;/use&gt;&quot;],&quot;prefix&quot;:[0,&quot;fas&quot;],&quot;icon&quot;:[0,&quot;clock&quot;]}],&quot;tab:api-reference&quot;:[0,{&quot;viewBox&quot;:[0,&quot;0 0 512 512&quot;],&quot;body&quot;:[0,&quot;&lt;use href=\&quot;#fern-icon-90s0w18h\&quot;&gt;&lt;/use&gt;&quot;],&quot;prefix&quot;:[0,&quot;fas&quot;],&quot;icon&quot;:[0,&quot;terminal&quot;]}],&quot;tab:documentation&quot;:[0,{&quot;viewBox&quot;:[0,&quot;0 0 448 512&quot;],&quot;body&quot;:[0,&quot;&lt;use href=\&quot;#fern-icon-yl07dfcr\&quot;&gt;&lt;/use&gt;&quot;],&quot;prefix&quot;:[0,&quot;fas&quot;],&quot;icon&quot;:[0,&quot;book&quot;]}],&quot;tab:knowledge-base&quot;:[0,{&quot;viewBox&quot;:[0,&quot;0 0 512 512&quot;],&quot;body&quot;:[0,&quot;&lt;use href=\&quot;#fern-icon-1tow4qsht\&quot;&gt;&lt;/use&gt;&quot;],&quot;prefix&quot;:[0,&quot;fas&quot;],&quot;icon&quot;:[0,&quot;book-open&quot;]}]}],&quot;tabIconFallback&quot;:[0,{}],&quot;tabFiles&quot;:[0,{}],&quot;authButton&quot;:[0,null],&quot;data-astro-transition-persist&quot;:[0,&quot;fern-mobile-menu-en-sidebar:|||a7eeea7698bc90a4c6e3a93c83494e95451f410ffb4d60aa294b3940bcbfc7e2&quot;]}" ssr client="only" opts="{&quot;name&quot;:&quot;MobileMenuShell&quot;,&quot;value&quot;:&quot;react&quot;}" data-astro-transition-persist="fern-mobile-menu-en-sidebar:|||a7eeea7698bc90a4c6e3a93c83494e95451f410ffb4d60aa294b3940bcbfc7e2"></astro-island><astro-island uid="ZuLE73" component-url="/_astro/SearchDialogShell.BquCrNbt.js" component-export="default" renderer-url="/_astro/client.Gqj9Jzy6.js" props="{&quot;domain&quot;:[0,&quot;docs.agentmail.to&quot;],&quot;siteHosts&quot;:[1,[[0,&quot;agentmail-production.docs.buildwithfern.com&quot;],[0,&quot;docs.agentmail.to&quot;]]],&quot;basepath&quot;:[0,&quot;&quot;],&quot;lang&quot;:[0,&quot;en&quot;],&quot;searchLocale&quot;:[0,&quot;en&quot;],&quot;hasLight&quot;:[0,true],&quot;hasDark&quot;:[0,true],&quot;askAiEnabled&quot;:[0,true],&quot;localDev&quot;:[0,false]}" ssr client="only" opts="{&quot;name&quot;:&quot;SearchDialogShell&quot;,&quot;value&quot;:&quot;react&quot;}"></astro-island><div data-astro-transition-persist="fern-custom-js-holder" id="fern-custom-js-holder"></div><script>(function(){var c=document.currentScript;var s=document.createElement("script");s.setAttribute("data-fern-custom-script","");s.text="(function(){const bodyScripts = [{\"src\":\"/_fern-files/agentmail-production.docs.buildwithfern.com/c095f56cd4b21272451a0a39b1d2bcc19e5b3087b442e3cb3614fb996c0992f9/custom.js\"}];\n\n        (function () {\n          // Inject each docs-configured script once. `src` scripts already on\n          // the page (data-fern-custom-js) are left in place — the docs scripts\n          // handle SPA re-init themselves; inline scripts run once.\n          //\n          // Injected elements go into #fern-custom-js-holder — a\n          // `transition:persist` container — rather than document.body. Without\n          // it the injected \u003cscript> was removed by every body swap, so the\n          // dedup below lost the element and re-injected it on every\n          // `astro:page-load`, re-executing the script each navigation (a\n          // classic script with top-level `const`/`let` bindings then throws\n          // \"Identifier ... has already been declared\" and its re-render\n          // observers never re-register).\n          //\n          // Persisting the element is not enough on its own: after each swap the\n          // ClientRouter re-runs every \u003cscript> in the document that is not\n          // marked `data-astro-exec` (cloning + replacing the element), which\n          // would execute the persisted script a second time. Mark injected\n          // scripts as already executed so the router leaves them alone. Must be\n          // set BEFORE the element is inserted — an unstamped node in the\n          // document is exactly what the router clones.\n          function markExecuted(el) {\n            el.setAttribute(\"data-astro-exec\", \"\");\n          }\n          function injectFernCustomScripts() {\n            const holder = document.getElementById(\"fern-custom-js-holder\") || document.body;\n            for (const s of bodyScripts) {\n              if (s.src) {\n                if (document.querySelector('script[data-fern-custom-js=\"' + s.src + '\"]')) { continue; }\n                const el = document.createElement(\"script\");\n                el.src = s.src;\n                // Script-inserted scripts ignore `defer` and default to async, so\n                // they ran in download order. Classic scripts share one global\n                // lexical scope, so order matters: two bundles that both declare\n                // a top-level `const`/`let` of the same name throw \"Identifier\n                // ... has already been declared\" in whichever runs second.\n                // `async = false` runs them in docs.yml order, like next/script.\n                el.async = false;\n                el.setAttribute(\"data-fern-custom-js\", s.src);\n                if (s.integrity) { el.integrity = s.integrity; el.crossOrigin = \"anonymous\"; }\n                markExecuted(el);\n                holder.appendChild(el);\n              } else if (s.inline) {\n                if (document.querySelector(\"script[data-fern-custom-inline='\" + encodeURIComponent(s.inline) + \"']\")) { continue; }\n                const el = document.createElement(\"script\");\n                el.textContent = s.inline;\n                el.setAttribute(\"data-fern-custom-inline\", encodeURIComponent(s.inline));\n                markExecuted(el);\n                holder.appendChild(el);\n              }\n            }\n          }\n          if (!window.__fernCustomScriptsBound) {\n            window.__fernCustomScriptsBound = true;\n            // Bind per-page on each `astro:page-load` (initial load + every\n            // ClientRouter navigation) and inject once the page's React islands\n            // — MDX content, header, footer, endpoint reference — have hydrated.\n            // A customer script that edits their server-rendered DOM before\n            // that (renaming \"Copy page\", removing #builtwithfern, translating\n            // the footer prompt) makes React see markup it didn't render\n            // (React #418), re-render the island and discard the script's\n            // edits. next/script only runs these after the whole Next page has\n            // hydrated, so this page hydrates every island up front\n            // (`\u003chtml data-fern-hydrate-all>` turns `client:lazy` into\n            // hydrate-on-idle; `client:deferred` already is) and waits until\n            // every such island carries `data-fern-hydrated`, which the patched\n            // @astrojs/react client stamps from a passive effect once React has\n            // committed the island (Astro drops the `ssr` attribute as soon as\n            // hydrateRoot() returns, but under startTransition React commits\n            // the time-sliced hydration later — a script run in between still\n            // edits DOM React is about to check). A `client:visible` /\n            // `client:media` island that never comes up is not waited on, so\n            // it can't hold the scripts to the timeout — bounded by a safety\n            // timeout longer than the directives' idle timeout in case an\n            // island never hydrates (e.g. a failed chunk). An island's root\n            // commits while a Suspense boundary inside it (MDX module gate,\n            // lazy component group) still awaits its import(); React hydrates\n            // that subtree in a later commit, so `\u003chtml data-fern-mdx-pending>`\n            // (set by state/mdxSuspensePending while such a load is in flight)\n            // holds the scripts as well. The double-rAF +\n            // 50ms tail is safe because injection is idempotent (deduped by\n            // data-fern-custom-js); `injected` guards against a second run.\n            const ISLAND_PENDING = ['load', 'idle', 'only', 'deferred', 'lazy']\n              .map(function (client) { return 'astro-island[client=\"' + client + '\"]:not([data-fern-hydrated])'; })\n              .join(', ');\n            const ISLAND_TIMEOUT_MS = 5000;\n            function hydrationPending() {\n              return document.querySelector(ISLAND_PENDING) != null\n                || document.documentElement.hasAttribute(\"data-fern-mdx-pending\");\n            }\n            function whenIslandsHydrated(callback) {\n              if (!hydrationPending()) {\n                callback();\n                return;\n              }\n              let done = false;\n              const observer = new MutationObserver(check);\n              const timer = setTimeout(finish, ISLAND_TIMEOUT_MS);\n              observer.observe(document.documentElement, {\n                attributes: true,\n                attributeFilter: [\"data-fern-hydrated\", \"data-fern-mdx-pending\"],\n                subtree: true\n              });\n              function check() {\n                if (!hydrationPending()) { finish(); }\n              }\n              function finish() {\n                if (done) { return; }\n                done = true;\n                clearTimeout(timer);\n                observer.disconnect();\n                callback();\n              }\n            }\n            document.addEventListener(\"astro:page-load\", function () {\n              let injected = false;\n              function injectOnce() {\n                if (injected) { return; }\n                injected = true;\n                injectFernCustomScripts();\n              }\n              whenIslandsHydrated(function () {\n                requestAnimationFrame(function () {\n                  requestAnimationFrame(function () {\n                    setTimeout(injectOnce, 50);\n                  });\n                });\n              });\n            });\n          }\n        })();\n      })();";s.async=false;(c&&c.parentNode?c.parentNode:document.head).insertBefore(s,c);})();</script><astro-island uid="2qRKW3" component-url="/_astro/SearchPanelShell.Px6zgXVo.js" component-export="default" renderer-url="/_astro/client.Gqj9Jzy6.js" props="{&quot;domain&quot;:[0,&quot;docs.agentmail.to&quot;],&quot;basepath&quot;:[0,&quot;&quot;],&quot;lang&quot;:[0,&quot;en&quot;],&quot;searchLocale&quot;:[0,&quot;en&quot;],&quot;hasLight&quot;:[0,true],&quot;hasDark&quot;:[0,true],&quot;data-astro-transitio