<span data-fern-style="color:#212121;font-style:inherit;--shiki-dark:#EEFFFF;--shiki-dark-font-style:italic">api_key</span><span data-fern-style="color:#D32F2F;--shiki-dark:#89DDFF">=</span><span data-fern-style="color:#212121;--shiki-dark:#82AAFF">os</span><span data-fern-style="color:#212121;--shiki-dark:#89DDFF">.</span><span data-fern-style="color:#6F42C1;--shiki-dark:#82AAFF">getenv</span><span data-fern-style="color:#212121;--shiki-dark:#89DDFF">(</span><span data-fern-style="color:#22863A;--shiki-dark:#89DDFF">&quot;</span><span data-fern-style="color:#22863A;--shiki-dark:#C3E88D">AGENTMAIL_API_KEY</span><span data-fern-style="color:#22863A;--shiki-dark:#89DDFF">&quot;</span><span data-fern-style="color:#212121;--shiki-dark:#89DDFF">))</span></span></span></div><div class="code-block-line"><span class="code-block-line-content"><span class="line"></span></span></div><div class="code-block-line"><span class="code-block-line-content"><span class="line"><span data-fern-style="color:#24292EFF;--shiki-dark:#EEFFFF">wh </span><span data-fern-style="color:#D32F2F;--shiki-dark:#89DDFF">=</span><span data-fern-style="color:#24292EFF;--shiki-dark:#EEFFFF"> client</span><span data-fern-style="color:#212121;--shiki-dark:#89DDFF">.</span><span data-fern-style="color:#24292EFF;--shiki-dark:#F07178">webhooks</span><span data-fern-style="color:#212121;--shiki-dark:#89DDFF">.</span><span data-fern-style="color:#6F42C1;--shiki-dark:#82AAFF">create</span><span data-fern-style="color:#212121;--shiki-dark:#89DDFF">(</span><span data-fern-style="color:#212121;font-style:inherit;--shiki-dark:#EEFFFF;--shiki-dark-font-style:italic">url</span><span data-fern-style="color:#D32F2F;--shiki-dark:#89DDFF">=</span><span data-fern-style="color:#22863A;--shiki-dark:#89DDFF">&quot;</span><span data-fern-style="color:#22863A;--shiki-dark:#C3E88D">https://your-server.com/webhooks</span><span data-fern-style="color:#22863A;--shiki-dark:#89DDFF">&quot;</span><span data-fern-style="color:#212121;--