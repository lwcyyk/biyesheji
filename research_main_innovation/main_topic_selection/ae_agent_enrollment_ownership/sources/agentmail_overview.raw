href="/integrations/ai-sdk" tabindex="-1">Vercel AI SDK</a></li><li><a href="/integrations/openai-agents-sdk" tabindex="-1">OpenAI Agents SDK</a></li><li><a href="/integrations/claude-agent-sdk" tabindex="-1">Claude Agent SDK</a></li><li><a href="/integrations/openclaw" tabindex="-1">OpenClaw</a></li><li><a href="/integrations/grokbot" tabindex="-1">Grok Bot</a></li><li><a href="/integrations/replit" tabindex="-1">Replit</a></li><li><a href="/integrations/vercel" tabindex="-1">Vercel</a></li><li><a href="/integrations/x402" tabindex="-1">x402</a></li><li><a href="/integrations/mpp" tabindex="-1">MPP</a></li><li><a href="/integrate-livekit-agents" tabindex="-1">LiveKit</a></li><li><a href="/integrations/sim" tabindex="-1">Sim.ai</a></li><li><a href="/integrations/hydradb" tabindex="-1">HydraDB</a></li><li><a href="/agentid-sign-in" tabindex="-1">AgentID Sign-In</a></li><li><a href="/agentid-public-key-authentication" tabindex="-1">AgentID Public-Key Authentication</a></li><li><a href="/agentid-in-assistants" tabindex="-1">AgentID in Claude, ChatGPT, and Cursor</a></li><li><a href="/sending-receiving-email" tabindex="-1">Sending &amp; Receiving Email</a></li><li><a href="/reply-extraction" tabindex="-1">Reply &amp; Attachment Extraction</a></li><li><a href="/imap-smtp" tabindex="-1">IMAP &amp; SMTP</a></li><li><a href="/multi-tenancy" tabindex="-1">Multi-Tenancy</a></li><li><a href="/scim" tabindex="-1">SCIM Provisioning</a></li><li><a href="/custom-domains" tabindex="-1">Creating Custom Domains</a></li><li><a href="/managing-domains" tabindex="-1">Managing Existing Domains</a></li><li><a href="/open-tracking" tabindex="-1">Open Tracking</a></li><li><a href="/google-workspace" tabindex="-1">Google Workspace</a></li><li><a href="/webhooks-overview" tabindex="-1">Overview</a></li><li><a href="/events" tabindex="-1">Events</a></li><li><a href="/webhook-setup" tabindex="-1">Setup Guide</a></li><li><a href="/webhook-polling" tabindex="-1">Polling</a></li><li><a href="/webhook-verification" tabindex="-1">Verifying Webhooks</a></li><li><a href="/websockets" tabindex="-1">Overview</a></li><li><a href="/websockets/quickstart" tabindex="-1">Quickstart</a></li><li><a href="/email-deliverability" tabindex="-1">Email Deliverability</a></li><li><a href="/idempotency" tabindex="-1">Idempotency</a></li><li><a href="/webhook-agent" tabindex="-1">Github Repo Agent</a></li><li><a href="/documentation/examples/auto-reply-agent" tabindex="-1">Auto Reply Agent</a></li><li><a href="/documentation/examples/smart-labeling-agent" tabindex="-1">Smart Labeling Agent</a></li><li><a href="/sales-agent-websocket" tabindex="-1">Sales Agent (WebSocket)</a></li><li><a href="/documentation/examples/live-agent-mail-examples" tabindex="-1">Live AgentMail Examples</a></li><li><a href="/faq" tabindex="-1">FAQ</a></li><li><a href="/errors" tabindex="-1">Error Reference</a></li><li><a href="/community" tabindex="-1">Community</a></li><li><a href="/support" tabindex="-1">Support</a></li><li><a href="/email-protocols" tabindex="-1">SPF, DKIM, DMARC</a></li><li><a href="/message-expiry" tabindex="-1">24-hour Message Expiry</a></li><li><a href="/documentation/resources/security-privacy/soc-2-compliance" tabindex="-1">SOC 2 Compliance</a></li><li><a href="/spam-virus-detection" tabindex="-1">Spam &amp; Virus Detection</a></li></ul></nav></aside><script>
        (function () {
          // Runs on the initial load AND on every view-transition swap: Astro
          // re-inserts the `transition:persist`ed sidebar into the new document,
          // and re-inserting a scroll container resets its scrollTop to 0, so we
          // restore the position from sessionStorage before paint to avoid a
          // visible jump. The companion scroll listener below keeps that stored
          // value in lockstep with the live scroll (the hydrated build did this
          // via React); without it the restored value drifts stale and the
          // sidebar jumps to the wrong offset on navigation.
          try {
            var KEY = "fern-sidebar-scroll-position";
            var container = document.getElementById("fern-sidebar-scroll-area");
            if (!container) { return; }
            var storedRaw = window.sessionStorage.getItem(KEY);
            var stored = storedRaw != null ? parseInt(storedRaw, 10) : 0;
            if (Number.isFinite(stored) && stored > 0) {
              container.scrollTop = stored;
              return;
            }
            var active = container.querySelector('.fern-sidebar-link[data-state="active"]');
            if (!active) { return; }
            var cRect = container.getBoundingClientRect();
            var aRect = active.getBoundingClientRect();
            var isAbove = aRect.top < cRect.top;
            var isBelow = aRect.bottom > cRect.bottom;
            if (!isAbove && !isBelow) { return; }
            var offset = aRect.top - cRect.top + container.scrollTop;
            var target = Math.max(0, Math.round(offset - container.clientHeight / 3));
            container.scrollTop = target;
            if (target > 0) {
              window.sessionStorage.setItem(KEY, String(target));
            }
          } catch (e) { /* sessionStorage/layout unavailable — fall back to the hydration-time scroll */ }
        })();
      </script></main><!-- Footer (matches AbstractDefaultDocs footer) --><footer id="fern-footer" class="width-before-scroll-bar"></footer></div><div data-astro-transition-persist="fern-mobile-menu-portal-en-sidebar:|||a7eeea7698bc90a4c6e3a93c83494e95451f410ffb4d60aa294b3940bcbfc7e2" id="fern-mobile-menu-portal"></div><astro-island uid="2abCGd" component-url="/_astro/MobileMenuShell.BiVuWiZL.js" component-export="default" renderer-url="/_astro/client.Gqj9Jzy6.js" props="{&quot;navAssetUrl&quot;:[0,&quot;/_fern-files/_nav/e739c29e6bb77dfb.json&quot;],&quot;sidebarRootNodeId&quot;:[0,&quot;sidebar:|||a7eeea7698bc90a4c6e3a93c83494e95451f410ffb4d60aa294b3940bcbfc7e2&quot;],&quot;initialNodeId&quot;:[0,&quot;page:webhooks-overview&quot;],&quot;visibleNodeIds&quot;:[1,[[0,&quot;root&quot;],[0,&quot;unversioned:root&quot;],[0,&quot;tabbed:|||a7eeea7698bc90a4c6e3a93c83494e95451f410ffb4d60aa294b3940bcbfc7e2&quot;],[0,&quot;tab:documentation&quot;],[0,&quot;sidebar:|||a7eeea7698bc90a4c6e3a93c83494e95451f410ffb4d60aa294b3940bcbfc7e2&quot;],[0,&quot;section:documentation/webhooks&quot;],[0,&quot;page:webhooks-overview&quot;]]],&quot;currentVariantId&quot;:[0,null],&quot;basepath&quot;:[0,&quot;&quot;],&quot;currentLocale&quot;:[0],&quot;hasLight&quot;:[0,true],&quot;hasDark&quot;:[0,true],&quot;productSwitcher&quot;:[0,null],&quot;versionSwitcher&quot;:[0,null],&quot;navbarLinks&quot;:[1,[[0,{&quot;type&quot;:[0,&quot;minimal&quot;],&quot;url&quot;:[0,&quot;mailto:contact@agentmail.cc&quot;],&quot;text&quot;:[0,&quot;contact@agentmail.cc&quot;],&quot;icon&quot;:[0],&quot;rightIcon&quot;:[0],&quot;rounded&quot;:[0],&quot;target&quot;:[0],&quot;links&quot;:[0]}],[0,{&quot;type&quot;:[0,&quot;filled&quot;],&quot;url&quot;:[0,&quot;https://discord.gg/hTYatWYWBc&quot;],&quot;text&quot;:[0,&quot;Discord&quot;],&quot;icon&quot;:[0,&quot;brands discord&quot;],&quot;rightIcon&quot;:[0],&quot;rounded&quot;:[0],&quot;target&quot;:[0],&quot;links&quot;:[0]}]]],&quot;navbarIconFallback&quo