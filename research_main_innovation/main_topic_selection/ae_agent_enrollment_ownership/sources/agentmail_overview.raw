      (function () {
        // Only write when the value changes: every write restyles the whole
        // document. The ResizeObserver path reads `contentRect` after layout
        // instead of forcing a synchronous layout before first paint.
        function applyHeaderHeight(height) {
          var value = height + "px";
          if (document.documentElement.style.getPropertyValue("--header-height") !== value) {
            document.documentElement.style.setProperty("--header-height", value);
          }
        }
        function syncHeaderHeight() {
          var header = document.getElementById("fern-header");
          if (header) {
            var style = window.getComputedStyle(header);
            applyHeaderHeight(header.clientHeight - parseFloat(style.paddingTop) - parseFloat(style.paddingBottom));
          }
        }
        var ro;
        function setup() {
          var header = document.getElementById("fern-header");
          if (header && "ResizeObserver" in window) {
            if (ro) { ro.disconnect(); }
            ro = new ResizeObserver(function (entries) {
              var entry = entries[entries.length - 1];
              if (entry) { applyHeaderHeight(entry.contentRect.height); }
            });
            ro.observe(header);
          } else {
            (window.requestAnimationFrame || window.setTimeout)(syncHeaderHeight);
          }
        }
        setup();
        if (!window.__fernHeaderHeightBound) {
          window.__fernHeaderHeightBound = true;
          document.addEventListener("astro:page-load", setup);
          // The swap replaces <html>'s attributes (including the inline style
          // holding the synced value), so carry it over to the incoming document
          // or the header/main/sidebar briefly snap to the stylesheet fallback.
          document.addEventListener("astro:before-swap", function (event) {
            var current = document.documentElement.style.getPropertyValue("--header-height");
            if (current && event.newDocument) {
              event.newDocument.documentElement.style.setProperty("--header-height", current);
            }
          });
        }
      })();
    </script><!-- Main (matches MainElement) --><main class="fern-main relative z-0 flex transition-all duration-500 ease-out mt-(--header-height)" data-theme="default" data-fern-active-slugs="webhooks-overview" data-fern-style="transition: max-width 500ms ease-out"><a href="#fern-sidebar" class="sr-only max-lg:hidden focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:border focus:border-border-concealed focus:bg-(color:--background) focus:px-4 focus:py-2 focus:text-body focus:no-underline focus:shadow-md">Skip to navigation</a><aside id="fern-sidebar-spacer" data-state="fixed"></aside><!-- Page content is an Astro slot, so the shared layout wrappers are mirrored here while their stateful components are reused directly. --><aside id="fern-toc"><div class="min-h-0 overflow-y-auto overscroll-contain px-4 pb-12 pt-8 lg:pr-5"><astro-island uid="ZSChwX" prefix="r15" component-url="/_astro/TableOfContentsIsland.CXiETPb5.js" component-export="default" renderer-url="/_astro/client.Gqj9Jzy6.js" props="{&quot;tableOfContents&quot;:[1,[[0,{&quot;simpleString&quot;:[0,&quot;Why Use Webhooks?&quot;],&quot;anchorString&quot;:[0,&quot;why-use-webhooks&quot;],&quot;children&quot;:[1,[]],&quot;roleRequirements&quot;:[0]}],[0,{&quot;simpleString&quot;:[0,&quot;Available Events&quot;],&quot;anchorString&quot;:[0,&quot;available-events&quot;],&quot;children&quot;:[1,[]],&quot;roleRequirements&quot;:[0]}],[0,{&quot;simpleString&quot;:[0,&quot;Updating event_types on a webhook&quot;],&quot;anchorString&quot;:[0,&quot;updating-event_types-on-a-webhook&quot;],&quot;children&quot;:[1,[]],&quot;roleRequirements&quot;:[0]}],[0,{&quot;simpleString&quot;:[0,&quot;Custom delivery headers&quot;],&quot;anchorString&quot;:[0,&quot;custom-delivery-headers&quot;],&quot;children&quot;:[1,[]],&quot;roleRequirements&quot;:[0]}],[0,{&quot;simpleString&quot;:[0,&quot;Scoping a webhook to a pod or inbox&quot;],&quot;anchorString&quot;:[0,&quot;scoping-a-webhook-to-a