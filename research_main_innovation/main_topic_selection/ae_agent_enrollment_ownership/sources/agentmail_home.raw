,color] [transition-duration:700ms,1000ms] [transition-timing-function:cubic-bezier(0.61,1,0.88,1),cubic-bezier(0.37,0,0.63,1)] [transition-delay:calc(var(--i)*60ms),calc(var(--i)*60ms_+_300ms)] starting:text-orange starting:opacity-0 group-data-[reveal=armed]/reveal:text-orange group-data-[reveal=armed]/reveal:opacity-0 group-data-[reveal=armed]/reveal:transition-none motion-reduce:transition-none" style="--i:10">humans</span></h2></div><div class="[grid-area:steps]"><div style="--steps:6" class="grid grid-cols-1 border-b border-white/16 [grid-template-rows:repeat(calc(2*var(--steps)),auto)]"><div role="tablist" aria-orientation="vertical" class="col-span-full row-span-full grid grid-cols-subgrid grid-rows-subgrid"><div role="presentation" style="--row:1" class="relative border-t border-white/16 [grid-row:var(--row)]"><span aria-hidden="true" class="absolute inset-x-0 -top-px h-px origin-left bg-white [transform:scaleX(var(--timer,1))] motion-reduce:[transform:none]"></span><button type="button" role="tab" id="product-flow-tab-0" aria-selected="true" aria-controls="product-flow" tabindex="0" class="flex w-full cursor-pointer items-baseline gap-4 py-4 text-left"><span class="w-[18px] shrink-0 font-mono text-label-14 text-white/48">01</span><span class="text-title-24 transition-colors duration-200 ease-out text-white">Two-way conversations</span></button></div><div role="presentation" style="--row:3" class="relative border-t border-white/16 [grid-row:var(--row)]"><button type="button" role="tab" id="product-flow-tab-1" aria-selected="false" aria-controls="product-flow" tabindex="-1" class="flex w-full cursor-pointer items-baseline gap-4 py-4 text-left"><span class="w-[18px] shrink-0 font-mono text-label-14 text-white/48">02</span><span class="text-title-24 transition-colors duration-200 ease-out text-white/48 hover:text-white/80">Send email at scale</span></button></div><div role="presentation" style="--row:5" class="relative border-t border-white/16 [grid-row:var(--row)]"><button type="button" role="tab" id="product-flow-tab-2" aria-selected="false" aria-controls="product-flow" tabindex="-1" class="flex w-full cursor-pointer items-baseline gap-4 py-4 text-left"><span class="w-[18px] shrink-0 font-mono text-label-14 text-white/48">03</span><span class="text-title-24 transition-colors duration-200 ease-out text-white/48 hover:text-white/80">Process incoming email</span></button></div><div role="presentation" style="--row:7" class="relative border-t border-white/16 [grid-row:var(--row)]"><button type="button" role="tab" id="product-flow-tab-3" aria-selected="false" aria-controls="product-flow" tabindex="-1" class="flex w-full cursor-pointer items-baseline gap-4 py-4 text-left"><span class="w-[18px] shrink-0 font-mono text-label-14 text-white/48">04</span><span class="text-title-24 transition-colors duration-200 ease-out text-white/48 hover:text-white/80">Coordinate schedules</span></button></div><div role="presentation" style="--row:9" class="relative border-t border-white/16 [grid-row:var(--row)]"><button type="button" role="tab" id="product-flow-tab-4" aria-selected="false" aria-controls="product-flow" tabindex="-1" class="flex w-full cursor-pointer items-baseline gap-4 py-4 text-left"><span class="w-[18px] shrink-0 font-mono text-label-14 text-white/48">05</span><span class="text-title-24 transition-colors duration-200 ease-out text-white/48 hover:text-white/80">Use services independently</span></button></div><div role="presentation" style="--row:11" class="relative border-t border-white/16 [grid-row:var(--row)]"><button type="button" role="tab" id="product-flow-tab-5" aria-selected="false" aria-controls="product-flow" tabindex="-1" class="flex w-full cursor-pointer items-baseline gap-4 py-4 text-left"><span class="w-[18px] shrink-0 font-mono text-label-14 text-white/48">06</span><span class="text-title-24 transition-colors duration-200 ease-out text-white/48 hover:text-white/80">Work with other agents</span></button></div></d