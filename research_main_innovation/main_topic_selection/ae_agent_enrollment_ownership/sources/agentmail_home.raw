able/media/specks.40xj8lovi7hr-.webp);mask-size:100% 100%;-webkit-mask-image:url(/_next/static/immutable/media/specks.40xj8lovi7hr-.webp);-webkit-mask-size:100% 100%"></span></span><span data-number="true" class="absolute top-[58.35px] right-[4px] font-mono text-[13.5px] leading-[1.01] tracking-[-0.54px] text-white opacity-40 group-aria-selected:opacity-100">03</span></span><span class="absolute top-[23.399px] left-[0.021px] h-[22.71px] w-[136.142px] [perspective-origin:50%_2.57px] [perspective:220px] z-3"><span data-flap="true" class="absolute inset-0 origin-[50%_2.57px] transform-3d group-aria-selected:[transform:rotateX(180deg)]"><img alt="" loading="lazy" width="136" height="23" decoding="async" data-nimg="1" class="absolute top-0 left-0 h-[22.71px] w-[136.142px] max-w-none backface-hidden [clip-path:inset(0.642px_0.293px_0_0.04px_round_1.784px_1.784px_0_0)]" style="color:transparent" src="/_next/static/immutable/media/flap-closed.2m3r33ll6ubu8.svg"/></span></span><span data-seal="true" class="absolute top-[39.64px] left-[62.19px] z-4 size-[11.615px] rounded-full bg-black opacity-50 group-aria-selected:opacity-0"></span></span><span class="sr-only">03<!-- --> <!-- -->Control and scale</span></button></div><div class="relative w-full max-w-[938px] pb-[39.56px]"><div aria-hidden="true" class="absolute right-[129.64px] bottom-0 left-[129.65px] h-[314.28px] bg-band outline -outline-offset-[0.5px] outline-black"></div><div aria-hidden="true" class="absolute right-[55.74px] bottom-[19.07px] left-[55.74px] h-[495.16px] bg-band outline -outline-offset-[0.5px] outline-black"></div><div id="feature-panel" role="tabpanel" aria-labelledby="feature-tab-0" class="relative flex flex-col gap-8 overflow-clip bg-band pt-[27.44px] native:h-[645px]"><div class="flex flex-col gap-8 px-6 md:px-[31.48px]"><h3 class="text-heading-32 leading-[1.1] text-white">Programmatic Inboxes</h3><div aria-hidden="true" class="h-px w-full max-w-[874.17px] bg-carbon"></div><dl class="grid gap-x-6 gap-y-8 md:grid-cols-2"><div class="flex flex-col gap-2.5"><dt class="font-mono text-[16px] leading-[1.1] tracking-[-0.01em] text-white uppercase">Inbox creation</dt><dd class="text-body-16 tracking-[-0.01em] text-white/64 max-w-[223.31px]">Provision a dedicated inbox for any agent with one API call.</dd></div><div class="flex flex-col gap-2.5"><dt class="font-mono text-[16px] leading-[1.1] tracking-[-0.01em] text-white uppercase">Threads</dt><dd class="text-body-16 tracking-[-0.01em] text-white/64 max-w-[285px]">Keep every reply, forward, and follow-up grouped under one conversation.</dd></div><div class="flex flex-col gap-2.5"><dt class="font-mono text-[16px] leading-[1.1] tracking-[-0.01em] text-white uppercase">Messages</dt><dd class="text-body-16 tracking-[-0.01em] text-white/64 max-w-[291.3px]">Send and receive email programmatically, formatted the way recipients expect.</dd></div><div class="flex flex-col gap-2.5"><dt class="font-mono text-[16px] leading-[1.1] tracking-[-0.01em] text-white uppercase">Attachments</dt><dd class="text-body-16 tracking-[-0.01em] text-white/64 max-w-[269.53px]">Send and receive files and documents directly in the message.</dd></div></dl></div><div class="pl-[30.95px]"><div class="relative w-full max-w-[907px]"><img alt="An orange AgentMail envelope and a cream business card over a lined grid" loading="lazy" width="1814" height="616" decoding="async" data-nimg="1" class="h-auto w-full" style="color:transparent" sizes="100vw" srcSet="/_next/image?url=%2F_next%2Fstatic%2Fimmutable%2Fmedia%2Fpanel-art.1-_xi0ca8v7_j.webp&amp;w=640&amp;q=90 640w, /_next/image?url=%2F_next%2Fstatic%2Fimmutable%2Fmedia%2Fpanel-art.1-_xi0ca8v7_j.webp&amp;w=750&amp;q=90 750w, /_next/image?url=%2F_next%2Fstatic%2Fimmutable%2Fmedia%2Fpanel-art.1-_xi0ca8v7_j.webp&amp;w=828&amp;q=90 828w, /_next/image?url=%2F_next%2Fstatic%2Fimmutable%2Fmedia%2Fpanel-art.1-_xi0ca8v7_j.webp&amp;w=1080&amp;q=90 1080w, /_next/image?url=%2F_next%2Fstatic%2Fimmutable%2Fmedia%2Fpanel-ar