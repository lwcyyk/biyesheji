eveloperApplication\",\"applicationSubCategory\":\"Email API\",\"operatingSystem\":\"Web-based, API\",\"description\":\"AgentMail is the first email provider built for AI agents. Agents create their own inboxes and send, receive, and manage email through an API.\",\"url\":\"https://www.agentmail.to\",\"provider\":{\"@id\":\"https://www.agentmail.to/#organization\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"USD\",\"description\":\"Free tier: 3 inboxes, 3,000 emails per month, no credit card required\",\"url\":\"https://www.agentmail.to/pricing\"},\"featureList\":[\"Email inbox API for AI agents\",\"Programmatic email sending and receiving\",\"Webhook integrations\",\"Custom domains\",\"Python and TypeScript SDKs\"]}]}17:[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2e\"}}],[\"$\",\"section\",null,{\"className\":\"relative overflow-clip\",\"children\":[[\"$\",\"div\",null,{\"aria-hidden\":true,\"className\":\"pointer-events-none absolute inset-0 mx-auto max-w-[1440px] select-none\",\"children\":[[\"$\",\"$L2f\",null,{\"src\":{\"src\":\"/_next/static/immutable/media/icons.0ixdx1l-djq59.webp\",\"width\":2488,\"height\":1318,\"blurWidth\":8,\"blurHeight\":4,\"blurDataURL\":\"data:image/webp;base64,UklGRkYAAABXRUJQVlA4TDkAAAAvB8AAAM1VICICHogEAAAAAIABAAMAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAEAEREngIA\"},\"alt\":\"\",\"priority\":true,\"className\":\"absolute top-9 left-1/2 h-[658.97px] w-[1243.51px] max-w-none -translate-x-1/2 native:left-[98px] native:translate-x-0\"}],[\"$\",\"$L30\",null,{\"light\":{\"width\":1243.51,\"height\":658.97,\"ink\":{\"paper\":16,\"ink\":36},\"sweep\":{\"kind\":\"band\",\"angle\":0.35,\"from\":-170,\"to\":1560,\"half\":150},\"seconds\":36,\"travel\":28,\"color\":[203,179,160],\"strength\":0.35},\"image\":\"$17:props:children:0:1:props:children:0:props:children:0:props:src\",\"className\":\"absolute top-9 left-1/2 h-[658.97px] w