"100vw" srcSet="/_next/image?url=%2F_next%2Fstatic%2Fimmutable%2Fmedia%2Fpods-art.1y4sd18fdgd08.webp&amp;w=640&amp;q=90 640w, /_next/image?url=%2F_next%2Fstatic%2Fimmutable%2Fmedia%2Fpods-art.1y4sd18fdgd08.webp&amp;w=750&amp;q=90 750w, /_next/image?url=%2F_next%2Fstatic%2Fimmutable%2Fmedia%2Fpods-art.1y4sd18fdgd08.webp&amp;w=828&amp;q=90 828w, /_next/image?url=%2F_next%2Fstatic%2Fimmutable%2Fmedia%2Fpods-art.1y4sd18fdgd08.webp&amp;w=1080&amp;q=90 1080w, /_next/image?url=%2F_next%2Fstatic%2Fimmutable%2Fmedia%2Fpods-art.1y4sd18fdgd08.webp&amp;w=1200&amp;q=90 1200w, /_next/image?url=%2F_next%2Fstatic%2Fimmutable%2Fmedia%2Fpods-art.1y4sd18fdgd08.webp&amp;w=1920&amp;q=90 1920w, /_next/image?url=%2F_next%2Fstatic%2Fimmutable%2Fmedia%2Fpods-art.1y4sd18fdgd08.webp&amp;w=2048&amp;q=90 2048w, /_next/image?url=%2F_next%2Fstatic%2Fimmutable%2Fmedia%2Fpods-art.1y4sd18fdgd08.webp&amp;w=3840&amp;q=90 3840w" src="/_next/image?url=%2F_next%2Fstatic%2Fimmutable%2Fmedia%2Fpods-art.1y4sd18fdgd08.webp&amp;w=3840&amp;q=90"/><canvas aria-hidden="true" class="pointer-events-none absolute top-[58.09px] left-0 h-[248.58px] w-[376px] max-w-none"></canvas><p class="relative max-w-[269.92px] text-body-14 leading-[1.32] text-white/80">Keep each customer’s inboxes and domains in a separate workspace. Build email into your product without mixing customer data.</p></article></div></div></div></section><section class="container-page mt-[92.62px]"><div class="flex w-full flex-col overflow-clip rounded-md bg-fog lg:h-[380px] lg:flex-row"><div class="relative h-[380px] w-full overflow-clip lg:min-w-0 lg:flex-1"><canvas aria-hidden="true" class="pointer-events-none absolute top-0 left-0 h-[380px] w-[670.18px] max-w-none select-none"></canvas><img alt="" loading="lazy" width="1341" height="760" decoding="async" data-nimg="1" class="pointer-events-none absolute top-0 left-0 h-[380px] w-[670.18px] max-w-none select-none [[data-live]~&amp;]:invisible" style="color:transparent" sizes="100vw" srcSet="/_next/i