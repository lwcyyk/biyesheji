        <span>&nbsp;[<a href="https://arxiv.org/pdf/2607.01792">pdf</a>, <a href="https://arxiv.org/ps/2607.01792">ps</a>, <a href="https://arxiv.org/format/2607.01792">other</a>]&nbsp;</span>
