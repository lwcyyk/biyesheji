  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2605.24286">arXiv:2605.24286</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2605.24286">pdf</a>, <a href="https://arxiv.org/ps/2605.24286">ps</a>, <a href="https://arxiv.org/format/2605.24286">other</a>]&nbsp;</span>
