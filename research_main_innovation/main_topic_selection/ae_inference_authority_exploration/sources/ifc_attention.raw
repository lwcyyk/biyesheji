        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.03677">pdf</a>, <a href="https://arxiv.org/ps/2602.03677">ps</a>, <a href="https://arxiv.org/format/2602.03677">other</a>]&nbsp;</span>
