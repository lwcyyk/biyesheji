        <span>&nbsp;[<a href="https://arxiv.org/pdf/2606.29431">pdf</a>, <a href="https://arxiv.org/ps/2606.29431">ps</a>, <a href="https://arxiv.org/format/2606.29431">other</a>]&nbsp;</span>
