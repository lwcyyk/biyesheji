        <span>&nbsp;[<a href="https://arxiv.org/pdf/2609.21096">pdf</a>, <a href="https://arxiv.org/ps/2609.21096">ps</a>, <a href="https://arxiv.org/format/2609.21096">other</a>]&nbsp;</span>
