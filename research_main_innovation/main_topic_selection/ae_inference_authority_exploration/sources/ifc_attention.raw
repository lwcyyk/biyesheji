        <span>&nbsp;[<a href="https://arxiv.org/pdf/2604.03297">pdf</a>, <a href="https://arxiv.org/ps/2604.03297">ps</a>, <a href="https://arxiv.org/format/2604.03297">other</a>]&nbsp;</span>
