        <span>&nbsp;[<a href="https://arxiv.org/pdf/2606.08641">pdf</a>, <a href="https://arxiv.org/ps/2606.08641">ps</a>, <a href="https://arxiv.org/format/2606.08641">other</a>]&nbsp;</span>
