        <span>&nbsp;[<a href="https://arxiv.org/pdf/2609.34972">pdf</a>, <a href="https://arxiv.org/ps/2609.34972">ps</a>, <a href="https://arxiv.org/format/2609.34972">other</a>]&nbsp;</span>
