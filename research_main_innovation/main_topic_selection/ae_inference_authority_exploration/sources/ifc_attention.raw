  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2603.07048">arXiv:2603.07048</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2603.07048">pdf</a>, <a href="https://arxiv.org/ps/2603.07048">ps</a>, <a href="https://arxiv.org/format/2603.07048">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
