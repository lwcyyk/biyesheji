        <span>&nbsp;[<a href="https://arxiv.org/pdf/2603.13768">pdf</a>, <a href="https://arxiv.org/ps/2603.13768">ps</a>, <a href="https://arxiv.org/format/2603.13768">other</a>]&nbsp;</span>
