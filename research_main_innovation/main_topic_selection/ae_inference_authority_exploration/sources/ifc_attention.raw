        <span>&nbsp;[<a href="https://arxiv.org/pdf/2605.22372">pdf</a>, <a href="https://arxiv.org/ps/2605.22372">ps</a>, <a href="https://arxiv.org/format/2605.22372">other</a>]&nbsp;</span>
