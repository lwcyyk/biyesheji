        <span>&nbsp;[<a href="https://arxiv.org/pdf/2604.15789">pdf</a>, <a href="https://arxiv.org/ps/2604.15789">ps</a>, <a href="https://arxiv.org/format/2604.15789">other</a>]&nbsp;</span>
