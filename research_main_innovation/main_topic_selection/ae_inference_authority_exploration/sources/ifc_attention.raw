        <span>&nbsp;[<a href="https://arxiv.org/pdf/2603.06274">pdf</a>, <a href="https://arxiv.org/ps/2603.06274">ps</a>, <a href="https://arxiv.org/format/2603.06274">other</a>]&nbsp;</span>
