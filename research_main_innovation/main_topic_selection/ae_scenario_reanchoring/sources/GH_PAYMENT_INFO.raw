le__NavList__list--flat___wuoKR" data-testid="NavList-list"><li class="Primer_Brand__NavList-module__NavList__item___OceIg Primer_Brand__NavList-module__NavList__item--level-2___AEntj Primer_Brand__NavList-module__NavList__item--leaf___SN9hT" data-testid="NavList-item"><div class="Primer_Brand__NavList-module__NavList__itemContent___TyAP4"><a class="Primer_Brand__NavList-module__NavList__link___lJiXk" data-testid="NavList-link" href="#managing-payment-information"><span class="Primer_Brand__NavList-module__NavList__labelArea___N5Ya6"><span class="Primer_Brand__NavList-module__NavList__label___cZ4Jt">Managing payment information</span></span></a></div></li><li class="Primer_Brand__NavList-module__NavList__item___OceIg Primer_Brand__NavList-module__NavList__item--level-2___AEntj Primer_Brand__NavList-module__NavList__item--leaf___SN9hT" data-testid="NavList-item"><div class="Primer_Brand__NavList-module__NavList__itemContent___TyAP4"><a class="Primer_Brand__NavList-module__NavList__link___lJiXk" data-testid="NavList-link" href="#adding-information-to-your-receipts"><span class="Primer_Brand__NavList-module__NavList__labelArea___N5Ya6"><span class="Primer_Brand__NavList-module__NavList__label___cZ4Jt">Adding information to your receipts</span></span></a></div></li><li class="Primer_Brand__NavList-module__NavList__item___OceIg Primer_Brand__NavList-module__NavList__item--level-2___AEntj Primer_Brand__NavList-module__NavList__item--leaf___SN9hT" data-testid="NavList-item"><div class="Primer_Brand__NavList-module__NavList__itemContent___TyAP4"><a class="Primer_Brand__NavList-module__NavList__link___lJiXk" data-testid="NavList-link" href="#viewing-payment-history"><span class="Primer_Brand__NavList-module__NavList__labelArea___N5Ya6"><span class="Primer_Brand__NavList-module__NavList__label___cZ4Jt">Viewing payment history</span></span></a></div></li><li class="Primer_Brand__NavList-module__NavList__item___OceIg Primer_Brand__NavList-module__NavList__item--level-2___AEntj Primer_Brand__NavList-module__NavList__item--leaf___SN9hT" data-testid="NavList-item"><div class="Primer_Brand__NavList-module__NavList__itemContent___TyAP4"><a class="Primer_Brand__NavList-module__NavList__link___lJiXk" data-testid="NavList-link" href="#managing-billing-contacts"><span class="Primer_Brand__NavList-module__NavList__labelArea___N5Ya6"><span class="Primer_Brand__NavList-module__NavList__label___cZ4Jt">Managing billing contacts</span></span></a></div></li></ul></nav></div></div><div data-container="article" style="grid-area:content" data-search="article-body"><div id="article-contents" data-article-body="true"><div class="MarkdownContent_markdownBody__v5MYy markdown-body"><p>The payment methods available depend on your account type. Enterprise and organization accounts have more payment options than personal accounts. Invoiced enterprise accounts make their payments using other methods. For more information, see <a href="/en/billing/reference/supported-payment-methods">Supported payment methods for GitHub</a>.</p>
<h2 id="managing-payment-information" tabindex="-1"><a class="heading-link" href="#managing-payment-information">Managing payment information<span class="heading-link-symbol" aria-hidden="true"></span></a></h2>
<ol>
<li>
<p>In the upper-right corner of any page on GitHub, click your profile picture.</p>
</li>
<li>
<p>Select the account you want to view and then access the &quot;Billing &amp; Licensing&quot; pages:</p>
<ul>
<li><strong>Personal accounts</strong>: Click <strong>Settings</strong>, then in the <strong>Access</strong> section of the sidebar, click <strong><svg version="1.1" width="16" height="16" viewBox="0 0 16 16" class="octicon octicon-credit-card" aria-label="credit-card" role="img"><path d="M10.75 9a.75.75 0 0 0 0 1.5h1.5a.75.75 0 0 0 0-1.5h-1.5Z"></path><path d="M0 3.75C0 2.784.784 2 1.75 2h12.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25ZM14.5 6.5h-13v5.75c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25Zm0-2.75a.25.25 0 0 0-.25-.25H1.75a.25.25 0 0 0-.25.25V5h13Z"></path></svg> Billing &amp; Licensing</strong>.</li>
<li><strong>Organizations</strong>: Click <strong>Your organizations</strong>, then next to the organization, click <strong>Settings</strong>. In the organization sidebar, click <strong><svg version="1.1" width="16" height="16" viewBox="0 0 16 16" class="octicon octicon-credit-card" aria-label="credit-card" role="img"><path d="M10.75 9a.75.75 0 0 0 0 1.5h1.5a.75.75 0 0 0 0-1.5h-1.5Z"></path><path d="M0 3.75C0 2.784.784 2 1.75 2h12.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25ZM14.5 6.5h-13v5.75c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25Zm0-2.75a.25.25 0 0 0-.25-.25H1.75a.25.25 0 0 0-.25.25V5h13Z"></path></svg> Billing &amp; Licensing</strong>.</li>
<li>For <strong>enterprises</strong>, click <strong>Your enterprises</strong>, then click the enterprise name. Click the <strong><svg version="1.1" width="16" height="16" viewBox="0 0 16 16" class="octicon octicon-credit-card" aria-label="credit-card" role="img"><path d="M10.75 9a.75.75 0 0 0 0 1.5h1.5a.75.75 0 0 0 0-1.5h-1.5Z"></path><path d="M0 3.75C0 2.784.784 2 1.75 2h12.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25ZM14.5 6.5h-13v5.75c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25Zm0-2.75a.25.25 0 0 0-.25-.25H1.75a.25.25 0 0 0-.25.25V5h13Z"></path></svg> Billing &amp; Licensing</strong> tab at the top of the page.</li>
</ul>
</li>
<li>
<p>From the list of &quot;Billing &amp; licensing&quot; pages, click <strong>Payment information</strong> to display full details of your payment method.</p>
</li>
<li>
<p>To edit or remove your payment method:</p>
<ul>
<li><strong>Bank card or PayPal</strong>: In &quot;Payment method&quot;, click <strong>Edit</strong> to update your payment information or click <strong>Remove</strong> to remove your payment information.</li>
<li><strong>Azure subscription</strong>: Under &quot;Azure subscription&quot;, click <svg version="1.1" width="16" height="16" viewBox="0 0 16 16" class="octicon octicon-pencil" aria-label="Edit Azure Subscription" role="img"><path d="M11.013 1.427a1.75 1.75 0 0 1 2.474 0l1.086 1.086a1.75 1.75 0 0 1 0 2.474l-8.61 8.61c-.21.21-.47.364-.756.445l-3.251.93a.75.75 0 0 1-.927-.928l.929-3.25c.081-.286.235-.547.445-.758l8.61-8.61Zm.176 4.823L9.75 4.81l-6.286 6.287a.253.253 0 0 0-.064.108l-.558 1.953 1.953-.558a.253.253 0 0 0 .108-.064Zm1.238-3.763a.25.25 0 0 0-.354 0L10.811 3.75l1.439 1.44 1.263-1.263a.25.25 0 0 0 0-.354Z"></path></svg> to edit your subscription or <svg version="1.1" width="16" height="16" viewBox="0 0 16 16" class="octicon octicon-trash" aria-label="Delete Azure Subscription" role="img"><path d="M11 1.75V3h2.25a.75.75 0 0 1 0 1.5H2.75a.75.75 0 0 1 0-1.5H5V1.75C5 .784 5.784 0 6.75 0h2.5C10.216 0 11 .784 11 1.75ZM4.496 6.675l.66 6.6a.25.25 0 0 0 .249.225h5.19a.25.25 0 0 0 .249-.225l.66-6.6a.75.75 0 0 1 1.492.149l-.66 6.6A1.748 1.748 0 0 1 10.595 15h-5.19a1.75 1.75 0 0 1-1.741-1.575l-.66-6.6a.75.75 0 1 1 1.492-.15ZM6.5 1.75V3h3V1.75a.25.25 0 0 0-.25-.25h-2.5a.25.25 0 0 0-.25.25Z"></path></svg> to remove your subscription. See <a href="/en/billing/how-tos/set-up-payment/connect-azure-sub">Connecting an Azure subscription</a>.</li>
</ul>
</li>
</ol>
<div class="ghd-alert ghd-alert-accent" data-container="alert"><p class="ghd-alert-title"><svg version="1.1" width="16" height="16" viewBox="0 0 16 16" class="octicon mr-2" aria-hidden="true"><path d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"></path></svg>Note</p>
<p></p>
<ul>
<li>You may see an authorization hold on your provided payment method once it&#x27;s updated or after accruing significant usage of metered services. GitHub initiates the release immediately, but your bank or card issuer may take a few days to make the funds available again. See <a href="/en/billing/how-tos/troubleshooting/authorization-holds">Troubleshooting authorization holds</a>.</li>
<li>If you have a paid subscription and remove your payment method, your subscription will automatically cancel on your next renewal date.</li>
<li>If you are currently on an active paid trial, you will not be able to remove your payment method.</li>
<li>To remove a payment method, you must have a balance of zero, and no billable metered usage in the current month, or the previous month if has yet to be paid.</li>
</ul>
</div>
<h3 id="troubleshooting-payment-method-issues" tabindex="-1"><a class="heading-link" href="#troubleshooting-payment-method-issues">Troubleshooting payment method issues<span class="heading-link-symbol" aria-hidden="true"></span></a></h3>
<p>If you encounter issues when adding or updating a payment method, you can try the following:</p>
<ol>
<li>Retry adding your payment method.</li>
<li>Try adding a new payment method.</li>
<li>Contact GitHub Support or your customer representative for additional assistance.</li>
</ol>
<h2 id="adding-information-to-your-receipts" tabindex="-1"><a class="heading-link" href="#adding-information-to-your-receipts">Adding information to your receipts<span class="heading-link-symbol" aria-hidden="true"></span></a></h2>
<p>You can add contact or tax information to your personal account&#x27;s or organization&#x27;s receipts, such as your full business name, VAT/GST identification number, or address of record. This information is included on every receipt, regardless of the paid product purchased.</p>
<p>For security reasons, do not include confidential financial information, such as credit card numbers.</p>
<h3 id="personal-account-receipts" tabindex="-1"><a class="heading-link" href="#personal-account-receipts">Personal account receipts<span class="heading-link-symbol" aria-hidden="true"></span></a></h3>
<ol>
<li>In the upper-right corner of any page on GitHub, click your profile picture, then click <strong><svg version="1.1" width="16" height="16" viewBox="0 0 16 16" class="octicon octicon-gear" aria-label="gear" role="img"><path d="M8 0a8.2 8.2 0 0 1 .701.031C9.444.095 9.99.645 10.16 1.29l.288 1.107c.018.066.079.158.212.224.231.114.454.243.668.386.123.082.233.09.299.071l1.103-.303c.644-.176 1.392.021 1.82.63.27.385.506.792.704 1.218.315.675.111 1.422-.364 1.891l-.814.806c-.049.048-.098.147-.088.294.016.257.016.515 0 .772-.01.147.038.246.088.294l.814.806c.475.469.679 1.216.364 1.891a7.977 7.977 0 0 1-.704 1.217c-.428.61-1.176.807-1.82.63l-1.102-.302c-.067-.019-.177-.011-.3.071a5.909 5.909 0 0 1-.668.386c-.133.066-.194.158-.211.224l-.29 1.106c-.168.646-.715 1.196-1.458 1.26a8.006 8.006 0 0 1-1.402 0c-.743-.064-1.289-.614-1.458-1.26l-.289-1.106c-.018-.066-.079-.158-.212-.224a5.738 5.738 0 0 1-.668-.386c-.123-.082-.233-.09-.299-.071l-1.103.303c-.644.176-1.392-.021-1.82-.63a8.12 8.12 0 0 1-.704-1.218c-.315-.675-.111-1.422.363-1.891l.815-.806c.05-.048.098-.147.088-.294a6.214 6.214 0 0 1 0-.772c.01-.147-.038-.246-.088-.294l-.815-.806C.635 6.045.431 5.298.746 4.623a7.92 7.92 0 0 1 .704-1.217c.428-.61 1.176-.807 1.82-.63l1.102.302c.067.019.177.011.3-.071.214-.143.437-.272.668-.386.133-.066.194-.158.211-.224l.29-1.106C6.009.645 6.556.095 7.299.03 7.53.01 7.764 0 8 0Zm-.571 1.525c-.036.003-.108.036-.137.146l-.289 1.105c-.147.561-.549.967-.998 1.189-.173.086-.34.183-.5.29-.417.278-.97.423-1.529.27l-1.103-.303c-.109-.03-.175.016-.195.045-.22.312-.412.644-.573.99-.014.031-.021.11.059.19l.815.806c.411.406.562.957.53 1.456a4.709 4.709 0 0 0 0 .582c.032.499-.119 1.05-.53 1.456l-.815.806c-.081.08-.073.159-.059.19.162.346.353.677.573.989.02.03.085.076.195.046l1.102-.303c.56-.153 1.113-.008 1.53.27.161.107.328.204.501.29.447.222.85.629.997 1.189l.289 1.105c.029.109.101.143.137.146a6.6 6.6 0 0 0 1.142 0c.036-.003.108-.036.137-.146l.289-1.105c.147-.561.549-.967.998-1.189.173-.086.34-.183.5-.29.417-.278.97-.423 1.529-.27l1.103.303c.109.029.175-.016.195-.045.22-.313.411-.644.573-.99.014-.031.021-.11-.059-.19l-.815-.806c-.411-.406-.562-.957-.53-1.456a4.709 4.709 0 0 0 0-.582c-.032-.499.119-1.05.53-1.456l.815-.806c.081-.08.073-.159.059-.19a6.464 6.464 0 0 0-.573-.989c-.02-.03-.085-.076-.195-.046l-1.102.303c-.56.153-1.113.008-1.53-.27a4.44 4.44 0 0 0-.501-.29c-.447-.222-.85-.629-.997-1.189l-.289-1.105c-.029-.11-.101-.143-.137-.146a6.6 6.6 0 0 0-1.142 0ZM11 8a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM9.5 8a1.5 1.5 0 1 0-3.001.001A1.5 1.5 0 0 0 9.5 8Z"></path></svg> Settings</strong>.</li>
<li>In the &quot;Access&quot; section of the sidebar, click <strong><svg version="1.1" width="16" height="16" viewBox="0 0 16 16" class="octicon octicon-credit-card" aria-label="credit-card" role="img"><path d="M10.75 9a.75.75 0 0 0 0 1.5h1.5a.75.75 0 0 0 0-1.5h-1.5Z"></path><path d="M0 3.75C0 2.784.784 2 1.75 2h12.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25ZM14.5 6.5h-13v5.75c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25Zm0-2.75a.25.25 0 0 0-.25-.25H1.75a.25.25 0 0 0-.25.25V5h13Z"></path></svg> Billing &amp; Licensing</strong>.</li>
<li>From the list of &quot;Billing &amp; licensing&quot; pages, click <strong>Payment information</strong>.</li>
<li>To the right of &quot;Additional information&quot;, click <strong>Add information</strong> and add your contact or tax information.</li>
</ol>
<h3 id="organization-receipts" tabindex="-1"><a class="heading-link" href="#organization-receipts">Organization receipts<span class="heading-link-symbol" aria-hidden="true"></span></a></h3>
<ol>
<li>In the upper-right corner of any page on GitHub, click your profile picture.</li>
<li>Click <strong>Your organizations</strong>, then next to the organization, click <strong>Settings</strong>.</li>
<li>In the organization sidebar, click <strong><svg version="1.1" width="16" height="16" viewBox="0 0 16 16" class="octicon octicon-credit-card" aria-label="credit-card" role="img"><path d="M10.75 9a.75.75 0 0 0 0 1.5h1.5a.75.75 0 0 0 0-1.5h-1.5Z"></path><path d="M0 3.75C0 2.784.784 2 1.75 2h12.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25ZM14.5 6.5h-13v5.75c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25Zm0-2.75a.25.25 0 0 0-.25-.25H1.75a.25.25 0 0 0-.25.25V5h13Z"></path></svg> Billing &amp; Licensing</strong>.</li>
<li>From the list of &quot;Billing &amp; licensing&quot; pages, click <strong>Payment information</strong>.</li>
<li>To the right of &quot;Additional information&quot;, click <strong>Add information</strong> and add your contact or tax information.</li>
</ol>
<h2 id="viewing-payment-history" tabindex="-1"><a class="heading-link" href="#viewing-payment-history">Viewing payment history<span class="heading-link-symbol" aria-hidden="true"></span></a></h2>
<p>You can view your payment history, including the date, amount, and payment method. You can also download past payments.</p>
<ol>
<li>Display the <strong><svg version="1.1" width="16" height="16" viewBox="0 0 16 16" class="octicon octicon-credit-card" aria-label="credit-card" role="img"><path d="M10.75 9a.75.75 0 0 0 0 1.5h1.5a.75.75 0 0 0 0-1.5h-1.5Z"></path><path d="M0 3.75C0 2.784.784 2 1.75 2h12.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25ZM14.5 6.5h-13v5.75c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25Zm0-2.75a.25.25 0 0 0-.25-.25H1.75a.25.25 0 0 0-.25.25V5h13Z"></path></svg> Billing &amp; Licensing</strong> pages.</li>
<li>Click <strong>Payment history</strong> to show details of payments.</li>
<li>To view the receipt for a payment, click <svg version="1.1" width="16" height="16" viewBox="0 0 16 16" class="octicon octicon-eye" aria-label="View receipt" role="img"><path d="M8 2c1.981 0 3.671.992 4.933 2.078 1.27 1.091 2.187 2.345 2.637 3.023a1.62 1.62 0 0 1 0 1.798c-.45.678-1.367 1.932-2.637 3.023C11.67 13.008 9.981 14 8 14c-1.981 0-3.671-.992-4.933-2.078C1.797 10.83.88 9.576.43 8.898a1.62 1.62 0 0 1 0-1.798c.45-.677 1.367-1.931 2.637-3.022C4.33 2.992 6.019 2 8 2ZM1.679 7.932a.12.12 0 0 0 0 .136c.411.622 1.241 1.75 2.366 2.717C5.176 11.758 6.527 12.5 8 12.5c1.473 0 2.825-.742 3.955-1.715 1.124-.967 1.954-2.096 2.366-2.717a.12.12 0 0 0 0-.136c-.412-.621-1.242-1.75-2.366-2.717C10.824 4.242 9.473 3.5 8 3.5c-1.473 0-2.825.742-3.955 1.715-1.124.967-1.954 2.096-2.366 2.717ZM8 10a2 2 0 1 1-.001-3.999A2 2 0 0 1 8 10Z"></path></svg>.</li>
<li>To download a receipt or invoice, click <svg version="1.1" width="16" height="16" viewBox="0 0 16 16" class="octicon octicon-download" aria-label="Download" role="img"><path d="M2.75 14A1.75 1.75 0 0 1 1 12.25v-2.5a.75.75 0 0 1 1.5 0v2.5c0 .138.112.25.25.25h10.5a.25.25 0 0 0 .25-.25v-2.5a.75.75 0 0 1 1.5 0v2.5A1.75 1.75 0 0 1 13.25 14Z"></path><path d="M7.25 7.689V2a.75.75 0 0 1 1.5 0v5.689l1.97-1.969a.749.749 0 1 1 1.06 1.06l-3.25 3.25a.749.749 0 0 1-1.06 0L4.22 6.78a.749.749 0 1 1 1.06-1.06l1.97 1.969Z"></path></svg> under &quot;Receipt&quot; or &quot;Invoice&quot;.</li>
</ol>
<p>If an issued receipt or invoice has an incorrect or missing recipient name, company name, or address, contact <a href="https://support.github.com">GitHub Support</a> for review and possible correction. This applies even when your saved billing information is correct.</p>
<p>Follow Support&#x27;s instructions to obtain any corrected copy. If a regenerated receipt or invoice is available in <strong>Payment history</strong>, download it using the steps above.</p>
<h2 id="managing-billing-contacts" tabindex="-1"><a class="heading-link" href="#managing-billing-contacts">Managing billing contacts<span class="heading-link-symbol" aria-hidden="true"></span></a></h2>
<p>Organizations and enterprises can add contacts to receive emails with billing notifications for payments, budget threshold alerts, and included usage alerts. One of the contacts is defined as the primary contact.</p>
<h3 id="organization-billing-contacts" tabindex="-1"><a class="heading-link" href="#organization-billing-contacts">Organization billing contacts<span class="heading-link-symbol" aria-hidden="true"></span></a></h3>
<ol>
<li>Display the <strong><svg version="1.1" width="16" height="16" viewBox="0 0 16 16" class="octicon octicon-credit-card" aria-label="credit-card" role="img"><path d="M10.75 9a.75.75 0 0 0 0 1.5h1.5a.75.75 0 0 0 0-1.5h-1.5Z"></path><path d="M0 3.75C0 2.784.784 2 1.75 2h12.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25ZM14.5 6.5h-13v5.75c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25Zm0-2.75a.25.25 0 0 0-.25-.25H1.75a.25.25 0 0 0-.25.25V5h13Z"></path></svg> Billing &amp; Licensing</strong> page for the organization.</li>
<li>Click <strong>Additional billing details</strong>.</li>
<li>In the table of &quot;Email recipients&quot;:
<ul>
<li>Click <strong>Add</strong>, enter an email address, and click <strong>Add</strong> to add a new billing contact.</li>
<li>Use the <strong>Edit</strong> drop-down for an existing contact to remove the contact or make that contact the primary billing contact.</li>
<li>Click <strong>Edit</strong> to update the email address for the primary billing contact.</li>
</ul>
</li>
</ol>
<h3 id="enterprise-billing-contacts" tabindex="-1"><a class="heading-link" href="#enterprise-billing-contacts">Enterprise billing contacts<span class="heading-link-symbol" aria-hidden="true"></span></a></h3>
<ol>
<li>Display the <strong><svg version="1.1" width="16" height="16" viewBox="0 0 16 16" class="octicon octicon-credit-card" aria-label="credit-card" role="img"><path d="M10.75 9a.75.75 0 0 0 0 1.5h1.5a.75.75 0 0 0 0-1.5h-1.5Z"></path><path d="M0 3.75C0 2.784.784 2 1.75 2h12.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25ZM14.5 6.5h-13v5.75c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25Zm0-2.75a.25.25 0 0 0-.25-.25H1.75a.25.25 0 0 0-.25.25V5h13Z"></path></svg> Billing and Licensing</strong> page for the enterprise.</li>
<li>Click <strong>Billing contacts</strong>.</li>
<li>In the table of &quot;Email recipients&quot;:
<ul>
<li>Click <strong>Add</strong>, enter an email address, and click <strong>Add</strong> to add a new billing contact.</li>
<li>Use the <strong><svg version="1.1" width="16" height="16" viewBox="0 0 16 16" class="octicon octicon-kebab-horizontal" aria-label="Show options for ..." role="img"><path d="M8 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3ZM1.5 9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Zm13 0a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"></path></svg></strong> drop-down for an existing contact to remove the contact or make that contact the primary billing contact.</li>
<li>Click <svg version="1.1" width="16" height="16" viewBox="0 0 16 16" class="octicon octicon-pencil" aria-label="Edit primary email address" role="img"><path d="M11.013 1.427a1.75 1.75 0 0 1 2.474 0l1.086 1.086a1.75 1.75 0 0 1 0 2.474l-8.61 8.61c-.21.21-.47.364-.756.445l-3.251.93a.75.75 0 0 1-.927-.928l.929-3.25c.081-.286.235-.547.445-.758l8.61-8.61Zm.176 4.823L9.75 4.81l-6.286 6.287a.253.253 0 0 0-.064.108l-.558 1.953 1.953-.558a.253.253 0 0 0 .108-.064Zm1.238-3.763a.25.25 0 0 0-.354 0L10.811 3.75l1.439 1.44 1.263-1.263a.25.25 0 0 0 0-.354Z"></path></svg> to update the email address for the primary billing contact.</li>
</ul>
</li>
</ol></div></div></div></div></div></main><div aria-hidden="true" class="FooterDivider_footerDivider__6q_kx"></div><footer class="Primer_Brand__MinimalFooter-module__MinimalFooter___QucKd DocsFooter_docsFooter__dl5re" data-container="footer"><div class="Primer_Brand__MinimalFooter-module__MinimalFooter__section____O9_E"><section class="Primer_Brand__MinimalFooter-module__MinimalFooter__top___H_7ju"><div class="Primer_Brand__MinimalFooter-module__MinimalFooter__container___phzVn"><div class="Primer_Brand__MinimalFooter-module__MinimalFooter__top-row___ZGvWR"><a href="https://github.com" class="Primer_Brand__MinimalFooter-module__MinimalFooter__logo___GvtJc" data-analytics-event="{&quot;category&quot;:&quot;Footer&quot;,&quot;action&quot;:&quot;go to home&quot;,&quot;label&quot;:&quot;text:home&quot;}" aria-label="GitHub"><svg data-component="Octicon" aria-hidden="true" focusable="false" class="octicon octicon-mark-github" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" display="inline-block" overflow="visible" style="vertical-align:text-bottom"><path d="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943"></path></svg></a><div class="Primer_Brand__MinimalFooter-module__MinimalFooter__top-actions___QIaDM"><button type="button" class="Primer_Brand