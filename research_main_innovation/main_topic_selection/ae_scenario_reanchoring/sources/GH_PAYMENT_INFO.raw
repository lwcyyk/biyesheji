.75 0 0 1-1.741-1.575l-.66-6.6a.75.75 0 1 1 1.492-.15ZM6.5 1.75V3h3V1.75a.25.25 0 0 0-.25-.25h-2.5a.25.25 0 0 0-.25.25Z"},"children":[]}]},{"type":"text","value":" to remove your subscription. See "},{"type":"element","tagName":"a","properties":{"href":"/en/billing/how-tos/set-up-payment/connect-azure-sub"},"children":[{"type":"text","value":"Connecting an Azure subscription"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"div","properties":{"className":"ghd-alert ghd-alert-accent","dataContainer":"alert"},"children":[{"type":"element","tagName":"p","properties":{"className":["ghd-alert-title"]},"children":[{"type":"element","tagName":"svg","properties":{"version":"1.1","width":16,"height":16,"viewBox":"0 0 16 16","className":["octicon","mr-2"],"ariaHidden":true},"children":[{"type":"element","tagName":"path","properties":{"d":"M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"},"children":[]}]},{"type":"text","value":"Note"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":""}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"You may see an authorization hold on your provided payment method once it's updated or after accruing significant usage of metered services. GitHub initiates the release immediately, but your bank or card issuer may take a few days to make the funds available again. See "},{"type":"element","tagName":"a","properties":{"href":"/en/billing/how-tos/troubleshooting/authorization-holds"},"children":[{"type":"text","value":"Troubleshooting authorization holds"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"If you have a paid subscription and remove your payment method, your subscription will automatically cancel on your next renewal date."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"If you are currently on an active paid trial, you will not be able to remove your payment method."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"To remove a payment method, you must have a balance of zero, and no billable metered usage in the current month, or the previous month if has yet to be paid."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"troubleshooting-payment-method-issues","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#troubleshooting-payment-method-issues"},"children":[{"type":"text","value":"Troubleshooting payment method issues"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"If you encounter issues when adding or updating a payment method, you can try the following:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ol","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Retry adding your payment method."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Try adding a new payment method."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Contact GitHub Support or your customer representative for additional assistance."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"adding-information-to-your-receipts","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#adding-information-to-your-receipts"},"children":[{"type":"text","value":"Adding information to your receipts"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can add contact or tax information to your personal account's or organization's receipts, such as your full business name, VAT/GST identification number, or address of record. This information is included on every receipt, regardless of the paid product purchased."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"For security reasons, do not include confidential financial information, such as credit card numbers."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"personal-account-receipts","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#personal-account-receipts"},"children":[{"type":"text","value":"Personal account receipts"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ol","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"In the upper-right corner of any page on GitHub, click your profile picture, then c