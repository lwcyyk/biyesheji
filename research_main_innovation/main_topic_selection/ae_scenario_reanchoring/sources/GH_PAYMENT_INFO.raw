","properties":{},"children":[{"type":"text","value":"Your enterprises"}]},{"type":"text","value":", then click the enterprise name. Click the "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"element","tagName":"svg","properties":{"version":"1.1","width":"16","height":"16","viewBox":"0 0 16 16","className":["octicon","octicon-credit-card"],"ariaLabel":"credit-card","role":"img"},"children":[{"type":"element","tagName":"path","properties":{"d":"M10.75 9a.75.75 0 0 0 0 1.5h1.5a.75.75 0 0 0 0-1.5h-1.5Z"},"children":[]},{"type":"element","tagName":"path","properties":{"d":"M0 3.75C0 2.784.784 2 1.75 2h12.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25ZM14.5 6.5h-13v5.75c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25Zm0-2.75a.25.25 0 0 0-.25-.25H1.75a.25.25 0 0 0-.25.25V5h13Z"},"children":[]}]},{"type":"text","value":" Billing \u0026 Licensing"}]},{"type":"text","value":" tab at the top of the page."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"From the list of \"Billing \u0026 licensing\" pages, click "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Payment information"}]},{"type":"text","value":" to display full details of your payment method."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"To edit or remove your payment method:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties"