+    try:
+        sys.path.insert(0,str(package/'host'))
+        from startup_finalize import finalize
+        finalize(package,receipt_path.parent,code)
+    except BaseException as exc:
+        (receipt_path.parent/'STARTUP_FINALIZATION_ERROR.json').write_text(json.dumps({'administrative_seal_status':'ADMIN_EVIDENCE_UNRESOLVED','error':repr(exc),'original_exit_code':code}),encoding='utf-8')
+        if code==0:code=125
     raise SystemExit(code)
 
 
