+        G.digest(p)!=m['runtime_regression_contract_sha256'] or a.get('runtime_regression_contract_sha256')!=G.digest(p) or cfg['driver_prepay']!=16 or cfg['hard_visits']!=768):raise G.AdmissionBlocked('RA_REGRESSION_BINDING')
