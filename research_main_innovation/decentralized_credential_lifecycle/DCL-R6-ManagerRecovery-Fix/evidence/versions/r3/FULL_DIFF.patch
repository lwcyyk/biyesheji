+    q['values']=dict(s.split('=',1) for s in q['stdout'].splitlines() if '=' in s)
+    if any(k not in q['values'] for k in FIELDS):raise G.AdmissionBlocked('MR_MANAGER_FIELDS_MISSING')
+    return q
