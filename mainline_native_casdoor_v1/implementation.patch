+        pending = None
+        if scenario in {"M2-02", "M2-03"}:
+            refresh = native_request(grants["A"]["handle"], profile, "A", "g0", "A1", "refresh", "A0")
+            if scenario == "M2-03":
+                lab.restart_controller("after_effect")
