{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auth-study-event/1",
  "type": "object",
  "required": ["schema", "run_id", "seq", "utc", "monotonic_ns", "event", "role", "payload", "previous_sha256", "sha256"],
  "properties": {
    "schema": {"const": "auth-study-event/1"},
    "run_id": {"type": "string", "minLength": 1},
    "seq": {"type": "integer", "minimum": 0},
    "utc": {"type": "string", "format": "date-time"},
    "monotonic_ns": {"type": "integer", "minimum": 0},
    "event": {"type": "string", "minLength": 1},
    "role": {"enum": ["method", "fixture", "fault", "transport", "witness", "resource", "scorer", "recovery"]},
    "payload": {"type": "object"},
    "previous_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "description": "run_start payload includes phase, implementation/version, family/lineage, goal/fault, pair/seed, method/code hash, initial state ref, approval/budget and interface digest. Tokens/passwords are fingerprinted, never raw. Scorer recomputes charges from request_sent events."
}
