[Unit]
Description=DCL R6 LC inactive static preparation
[Service]
Type=exec
Slice=dclr6lc01.slice
User=dcl-r6
Group=dcl-r6
ExecStart=/usr/bin/python3.12 -I -S -B /var/lib/dcl-r6/lc01/src/guard.py --role controller --batch-root /var/lib/dcl-r6/lc01 --case C00
WorkingDirectory=/var/lib/dcl-r6/lc01
LimitAS=1073741824:1073741824
TasksMax=4
TasksAccounting=yes
MemoryAccounting=yes
MemoryMax=4294967296
MemorySwapMax=0
OOMPolicy=kill
OOMScoreAdjust=0
LimitCORE=0
Restart=no
RemainAfterExit=no
Delegate=no
NoNewPrivileges=yes
KillMode=control-group
KillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStartSec=15
TimeoutStopSec=5
RuntimeMaxSec=1740
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
PrivateDevices=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/dcl-r6/lc01/out
InaccessiblePaths=/mnt /init /dev/hugepages /usr/lib/wsl /run/systemd/private /run/dbus /run/user
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT PYTHONPATH PYTHONHOME
