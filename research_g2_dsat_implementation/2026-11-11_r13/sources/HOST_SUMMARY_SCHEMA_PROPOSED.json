{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "execution_ref",
    "status",
    "authority_revision",
    "authority_instance",
    "obligation_revision",
    "snapshot_digest",
    "read_scope_ref",
    "observed_at",
    "source_contract",
    "source_binding_status",
    "missing_fields",
    "native_currentness_status",
    "math_ready",
    "current_native_eligible",
    "global_complete",
    "authority_write_action",
    "audit"
  ],
  "properties": {
    "schema": {
      "const": "dsat-host-read-summary/1"
    },
    "execution_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "status": {
      "enum": [
        "STAGING_READY_WITH_GAPS",
        "READ_CONTEXT_REQUIRED",
        "READ_SCOPE_DENIED",
        "UNSUPPORTED_READ_REQUEST",
        "READ_SOURCE_UNAVAILABLE",
        "READ_BUDGET_DENIED",
        "SNAPSHOT_INCOMPLETE",
        "SOURCE_BINDING_CONFLICT",
        "INVALID_FIELD_TYPE",
        "RESOURCE_LIMIT",
        "BUDGET_SOURCE_CONFLICT",
        "UNSUPPORTED_SOURCE_SCHEMA",
        "HOST_IDENTITY_REQUIRED",
        "HOST_PERMISSION_DENIED",
        "HOST_PERMIT_EXPIRED",
        "HOST_PERMIT_REPLAY",
        "HOST_SOURCE_MISMATCH",
        "HOST_CONNECTION_NOT_IDLE",
        "HOST_DEADLINE_EXCEEDED",
        "INCONCLUSIVE_CONCURRENT_CHANGE",
        "HOST_SUMMARY_REFUSED"
      ]
    },
    "authority_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9223372036854776000
    },
    "authority_instance": {
      "type": "null"
    },
    "obligation_revision": {
      "type": "null"
    },
    "snapshot_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "read_scope_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "observed_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "domain",
            "epoch_ref",
            "lower",
            "upper",
            "native_validity"
          ],
          "properties": {
            "domain": {
              "const": "monotonic_ns"
            },
            "epoch_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "lower": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9223372036854776000
            },
            "upper": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9223372036854776000
            },
            "native_validity": {
              "const": "UNESTABLISHED"
            }
          }
        }
      ]
    },
    "source_contract": {
      "enum": [
        "legacy-authority-state/1",
        null
      ]
    },
    "source_binding_status": {
      "enum": [
        "MATCHED",
        "NOT_APPLICABLE_EMPTY_SCOPE",
        "UNAVAILABLE"
      ]
    },
    "missing_fields": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 80,
        "pattern": "^[A-Z0-9_]+$"
      }
    },
    "native_currentness_status": {
      "const": "UNPROVEN"
    },
    "math_ready": {
      "const": false
    },
    "current_native_eligible": {
      "const": false
    },
    "global_complete": {
      "const": false
    },
    "authority_write_action": {
      "const": "NONE"
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sql_count",
        "source_read_count",
        "source_operations_delta",
        "key_read_count",
        "key_count_basis",
        "bound_request_count",
        "world_row_unchanged",
        "authority_events_count_unchanged",
        "authority_events_max_unchanged",
        "connection_total_changes_unchanged",
        "observed_sql_schema_version",
        "secret_scan_status",
        "elapsed_ns",
        "deadline_exceeded",
        "permit_consumed"
      ],
      "properties": {
        "source_sql_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "source_read_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "source_operations_delta": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036854776000
        },
        "key_read_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "key_count_basis": {
          "enum": [
            "PINNED_PATH_BOUND",
            "MEASURED_APPROVED_TELEMETRY",
            "NOT_OBSERVED"
          ]
        },
        "bound_request_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 32
        },
        "world_row_unchanged": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "authority_events_count_unchanged": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "authority_events_max_unchanged": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "connection_total_changes_unchanged": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "observed_sql_schema_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 2147483647
        },
        "secret_scan_status": {
          "enum": [
            "CLEAN",
            "REFUSED",
            "NOT_RUN"
          ]
        },
        "elapsed_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9223372036854776000
        },
        "deadline_exceeded": {
          "type": "boolean"
        },
        "permit_consumed": {
          "type": "boolean"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Proposed H0 specification, not executed/approved/implemented; semantic fixed gap/error code allowlist and bytes<=4096 require host checks. source_binding MATCHED requires >=1 request and successful R12."
}
