     "1c6283d77d75d9617adff2b06cea39bc1658aa4b9c0d9ee2e823fcc2c8d50037"),
    ("test_request.json", BASE / "2026-11-11_r22_d1b1_closure_offline/r19_24_002/test_request.json",
     "90cf2149c79ccd43caa82aa8da51d6542b5776ac8bd9ec5ecc01cb163f9f0c69"),
)
HISTORICAL_READ_ONLY_LINKS = frozenset((
    BASE / "2026-11-11_r22_d1b1_closure_offline/new54_001/T33/one.txt",
    BASE / "2026-11-11_r22_d1b1_closure_offline/new54_001/T33/alias.txt",
    BASE / "2026-11-12_r24/verification_runs/r24_new54_001/T33/one.txt",
    BASE / "2026-11-12_r24/verification_runs/r24_new54_001/T33/alias.txt",
))
WRITE_NAMES = frozenset(("RUN_APPROVAL_RECEIPT.json", "SUITE_INVOCATION_01.json", "TEST_RUNS.json",
    "COMMAND_stdout.log", "COMMAND_stderr.log", RUN_ID + "/RUN_START.json", RUN_ID + "/stdout.log",
    RUN_ID + "/RESULTS.json", RUN_ID + "/RESOURCE_LEDGER.json", RUN_ID + "/MODULE_ORIGINS.json",
