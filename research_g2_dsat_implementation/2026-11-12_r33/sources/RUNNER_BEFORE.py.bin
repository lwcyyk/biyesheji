LOGICAL = BASE / "2026-11-11_r19_offline" / ("r31_projection_" + RUN_ID)
PHASES = (("A1", "ActivationCases"), ("H1", "H1Cases"), ("D1A", "D1ACases"))
FORBIDDEN_IMPORTS = ("cryptography", "auth_lifecycle.online_state.services",
    "auth_lifecycle.online_state.storage", "auth_lifecycle.online_state.materials")
ALLOWED_D24_INPUTS = (
