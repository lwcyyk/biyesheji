+ROOT = Path(__file__).resolve().parents[1]
+FIXTURES = Path(__file__).parent / "fixtures" / "dsat"
+spec = importlib.util.spec_from_file_location("dsat_independent_checker", ROOT / "scripts" / "check_dsat_certificate.py")
