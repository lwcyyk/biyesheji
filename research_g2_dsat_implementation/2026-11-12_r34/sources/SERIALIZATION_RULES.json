{
  "schema": "r34-serialization-rules/1",
  "canonical_string_bound": "<=12*n+2 ASCII bytes for n Python codepoints",
  "canonical_object_rule": "2+sum(JSON(key)+1+JSON(value))+(entry_count-1),empty object2",
  "canonical_array_rule": "2+sum(JSON(value))+(entry_count-1),empty array2",
  "packed_length_formula": "147+digits(raw_bytes)-1+4*ceil(zlib_bytes/3)",
  "artifact_file_length_formula": "48+packed_length",
  "checkpoint_wire_length_conditional_upper": "336+packed_length",
  "checkpoint_fixed_fields": {
    "maximum_literal_stage": "PROVENANCE_SNAPSHOT_FINISHED",
    "stage_chars": 28,
    "phase_chars_max": 9,
    "test_id_chars_max": 3,
    "UTC_chars_max": 32,
    "SHA_chars": 64,
    "sequence_decimal_digits_max": 7,
    "sequence_bound_scope": "acknowledged persistent prefix plus next attempt;no external mutation/reentrant bookkeeping"
  },
  "checkpoint_label_literals": [
    "FAILED",
    "FINALIZATION_READY",
    "FINALIZED",
    "ORIGIN_CLASSIFIED",
    "ORIGIN_OBSERVED",
    "PHASE_ASSERTIONS_FINISHED",
    "PRECHECK",
    "PROVENANCE_CHECK",
    "PROVENANCE_SNAPSHOT_FINISHED",
    "PROVENANCE_SNAPSHOT_STARTED",
    "RECOVERY_REQUIRED",
    "RESOURCE_AUDIT",
    "RUN_STARTED",
    "TESTS_FINISHED",
    "TESTS_RUNNING",
    "TEST_ASSERTION",
    "WRAPPED_ORIGIN_OBSERVED"
  ],
  "LF_bytes": 1,
  "pretty_printing": false,
  "compression_ratio_assumed": false,
  "zlib_output_z_upper": "UNKNOWN without bounded input/raw length and verified implementation bound",
  "source_schema_file": "STRING_FLOW_AND_SCHEMA_MAP.json",
  "receipt_outer_base_bytes": {
    "FAILED": 97,
    "FINALIZED": 99
  },
  "receipt_length_formula": "receipt_outer_base[status]+packed_length"
}
