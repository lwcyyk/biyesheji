+class FakeConnection:
+    def __init__(self):
+        self.in_transaction = False
+        self.total_changes = 0
+        self.forbidden = 0
+
+    def execute(self, *args):
+        self.forbidden += 1
+        raise AssertionError("REAL_SQL_PATH_FORBIDDEN")
+
+    commit = rollback = execute
