+class HostAudit:
+    def __init__(self, secret):
+        self.rows, self.attempts, self.failure, self.secret = [], 0, False, secret
+
+    def __call__(self, row):
+        self.attempts += 1
+        if self.failure:
+            raise RuntimeError(self.secret)
+        self.rows.append(copy.deepcopy(row))
