+            if AUDIT["threads_created"]>16:raise RuntimeError("THREAD_COUNT_LIMIT")
+            if threading.active_count()>=4:raise RuntimeError("THREAD_PEAK_LIMIT")
+            result=original_start(thread,*args,**kwargs)
