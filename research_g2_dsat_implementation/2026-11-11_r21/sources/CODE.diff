+        threading.Thread.start=thread_start
+    cleanup_projection=lambda:None
+    try:
+        sys.path.insert(0,str(PROJECT/"src"))
+        with (RUN/"stdout.log").open("w",encoding="utf-8") as log:
+            if suite=="new52":
+                cases=module_at("r21_new52",PROJECT/"tests/test_dsat_authority_live_lifecycle.py")
+                plan=load(R20/"D1B_TEST_PLAN.json");cases.configure(plan,fixture,RUN)
+                results=[run_class(cases.LiveLifecycleCases,[x["id"] for x in plan["B1_new_cases"]],log)]
+                for child in cases.CONFIG["children"]:
+                    if child["result"] is None:
+                        child["result"]=cases.w.finish_owned_child(cases.CONFIG["scope"],child["process"])
+                details=cases.DETAILS;SECRETS.update(cases.CONFIG["private_values"])
+                scope_counts=cases.CONFIG["scope"].counts()
+                children=[{k:v for k,v in x.items() if k!="process"} for x in cases.CONFIG["children"]]
+                peak=cases.w.self_peak_memory(cases.CONFIG["scope"])
+            elif suite=="r19_24":
+                output,cleanup_projection=install_R19_path_projection(RUN)
+                cases=module_at("r21_r19_24",PROJECT/"tests/test_dsat_authority_runtime.py")
+                plan=load(BASE/"2026-11-11_r19/D1A_TEST_PLAN.json")
+                cases.configure(plan,old_D,memory_connection,output)
+                results=[run_class(cases.D1ACases,[x["id"] for x in plan["new_cases"]],log)]
+                details=cases.DETAILS;scope_counts={};children=[];peak={"status":"NOT_MEASURED"}
+            else:
+                PHASE="legacy_A1"
+                a=module_at("r21_original_A1",PROJECT/"tests/test_dsat_authority_host_activation.py")
+                a.configure(load(BASE/"2026-11-11_r15/H2_HOST_ACTIVATION_PLAN.json"),old_A,memory_connection)
+                first=run_class(a.ActivationCases,["A%02d"%i for i in range(1,21)],log)
+                PHASE="legacy_H1"
+                h=module_at("r21_original_H1",PROJECT/"tests/test_dsat_authority_read_host.py")
+                h.configure(load(BASE/"2026-11-11_r13/REAL_READONLY_TEST_PLAN.json"),old_H)
+                second=run_class(h.H1Cases,["H%02d"%i for i in range(1,25)],log)
+                results,details=[first,second],a.DETAILS+h.DETAILS
+                scope_counts={};children=[];peak={"status":"NOT_MEASURED"}
+        PHASE="POSTCHECK";preflight(suite)
+        rows=[x for r in results for x in r.rows]
+        counts={s:sum(x["status"]==s for x in rows) for s in ["PASS","FAIL","ERROR","SKIP","BLOCKED","NOT_RUN"]}
+        text=(RUN/"stdout.log").read_text(encoding="utf-8")+json.dumps(details)
+        clean=all(v not in text for v in SECRETS)
