+        disk=sum(p.stat().st_size for p in case_files)
+        expected={"new52":52,"r19_24":24,"legacy44":44}[suite]
+        modules=[n for n in sys.modules if n in {"auth_lifecycle.online_state.services","auth_lifecycle.online_state.storage","auth_lifecycle.online_state.materials"}]
+        result={"schema":"r21-actual-suite/1","suite":suite,"run":str(RUN),"argv_interpreter":sys.orig_argv,
+            "executable":sys.executable,"python":sys.version,"started_utc":started_utc,
+            "finished_utc":datetime.datetime.now(datetime.timezone.utc).isoformat(),"elapsed_ns":time.perf_counter_ns()-clock,
+            "counts":counts,"executed":len(rows),"cases":rows,"details":details,"code":filelock["executed_code"],
+            "inputs":filelock["inputs"],
