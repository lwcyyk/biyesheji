+            "production_or_deployed_service_resources":0,"D1B2_P1_P2_S3B2_S5":False,"real_deployment_cost":"NOT_MEASURED"}
+        limits_ok=len(dirs)<=64 and len(case_files)<=512 and disk<=67108864
+        result["passed"]=counts=={"PASS":expected,"FAIL":0,"ERROR":0,"SKIP":0,"BLOCKED":0,"NOT_RUN":0} and clean and limits_ok and not AUDIT["unexpected_violations"]
+        write(RUN/"RESULTS.json",result)
