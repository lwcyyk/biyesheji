+def main(suite):
+    global PHASE, RUN
+    started_utc = datetime.datetime.now(datetime.timezone.utc).isoformat()
+    clock = time.perf_counter_ns()
+    baseline, filelock, modified = preflight(suite)
+    target(OUTPUT).mkdir(exist_ok=True)
+    n = 1
+    while (OUTPUT / (suite + "_%03d" % n)).exists(): n += 1
+    if n > 2: raise RuntimeError("SUITE_RERUN_BUDGET_EXHAUSTED")
+    RUN = target(OUTPUT / (suite + "_%03d" % n)); RUN.mkdir()
+    snapshot = RUN / "code_snapshot"; snapshot.mkdir()
+    for row in filelock["executed_code"]:
+        (snapshot / (Path(row["path"]).name + ".txt")).write_bytes(Path(row["path"]).read_bytes())
+    write(RUN / "RUN_START.json", {"suite":suite,"argv_interpreter":sys.orig_argv,"executable":sys.executable,
+        "python":sys.version,"started_utc":started_utc,"code":filelock["executed_code"]})
+    sqlite3.connect = guarded_connect
+    PHASE = suite
+    fixture = PROJECT / "tests/fixtures/dsat_authority_live_lifecycle"
+    old_D = PROJECT / "tests/fixtures/dsat_authority_runtime"
+    old_A = PROJECT / "tests/fixtures/dsat_authority_host_activation"
+    old_H = PROJECT / "tests/fixtures/dsat_authority_read_host"
+    roots = [fixture] if suite=="new52" else [old_D] if suite=="r19_24" else [old_A,old_H]
+    for root in roots:SECRETS.update(load(root/"CANARIES.json")["values"].values())
+    timer = threading.Timer(300, _thread.interrupt_main);timer.daemon=True;timer.start()
+    original_start=threading.Thread.start
+    if suite=="new52":
+        def thread_start(thread,*args,**kwargs):
