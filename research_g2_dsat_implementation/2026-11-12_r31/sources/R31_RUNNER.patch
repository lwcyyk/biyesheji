+    def checkpoint(self, stage, value):
+        """One owned, hash-chained JSONL journal in the existing failure path.
+
+        Only a complete fsynced line advances the in-memory head. A torn last
+        line has no evidentiary claim. No existing bytes are truncated/replaced.
+        """
+        path = checked(RUN / "EARLY_FAILURE.json", output=True)
+        with self.io_lock:
+            require(not self.journal_closed, "JOURNAL_ALREADY_CLOSED")
+            if self.journal is None:
+                self.reserve_bytes(0)
+                self.journal = path.open("xb")
+                stat = os.fstat(self.journal.fileno())
+                self.journal_identity = (stat.st_dev, stat.st_ino)
+            stat = path.stat()
+            require((stat.st_dev, stat.st_ino) == self.journal_identity
+                and stat.st_size == self.journal_bytes
+                and self.journal.tell() == self.journal_bytes, "JOURNAL_IDENTITY_CHANGED")
+            event = {"schema": "r31-checkpoint-jsonl/1", "seq": self.journal_sequence + 1,
+                "previous_sha256": self.journal_head, "stage": stage, "phase": self.phase,
+                "test_id": self.current, "utc": datetime.datetime.now(datetime.timezone.utc).isoformat(),
+                "value": value}
+            digest = hashlib.sha256(canonical(event)).hexdigest()
+            data = canonical({**event, "sha256": digest}) + b"\n"
+            require(all(v.encode() not in data for v in self.secrets), "PUBLIC_SINK_REFUSED")
+            self.reserve_bytes(len(data))
+            require(self.journal.write(data) == len(data), "JOURNAL_SHORT_WRITE")
+            self.journal.flush(); os.fsync(self.journal.fileno())
+            self.journal_sequence += 1; self.journal_head = digest
+            self.journal_bytes += len(data)
+
+    def failure(self, stage, error):
+        code = str(error) if isinstance(error, Refusal) else type(error).__name__
+        if stage.startswith(("PERSIST", "CHECKPOINT")): category = "OUTPUT_PERSISTENCE_ERROR"
+        elif code == "DEPENDENCY_CHANGED": category = "FILE_DIGEST_ERROR"
+        elif isinstance(error, PermissionError) or code == "READ_SCOPE_REFUSED":
+            category = "READ_PERMISSION_ERROR"
+        elif code in {"DEPENDENCY_ORIGIN_MISMATCH", "MODULE_ORIGIN_MISMATCH"}:
+            category = "DEPENDENCY_PROVENANCE_ERROR"
+        elif code == "ORIGIN_UNRESOLVED": category = "ORIGIN_INFORMATION_INSUFFICIENT"
+        else: category = "AUDIT_OR_EXECUTION_ERROR"
+        row = {"stage": stage, "category": category, "exception_type": type(error).__name__,
+            "errno": getattr(error, "errno", None), "code": self.redact(code),
+            "traceback": self.redact("".join(traceback.format_exception(type(error), error, error.__traceback__)))}
+        self.errors.append(row)
+        return row
+
+    def safe_checkpoint(self, stage, value):
+        try:
+            self.checkpoint(stage, value)
+            return True
+        except BaseException as error:
+            self.persistence_ok = False
+            self.failure("CHECKPOINT_" + stage, error)
+            return False
