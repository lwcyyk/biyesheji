+        _require(doc["environment_fully_locked"] is False and doc["real_operations_status"] == "NOT_RUN")
+        actual_paths = doc["all_candidate_paths"]
+        _require(type(actual_paths) is dict and set(actual_paths) == set(PATHS), "PATH_DENIED")
+        for key, rel in PATHS.items():
+            _require(_path(actual_paths[key]) == _path(ntpath.join(ROOT, rel)), "PATH_DENIED")
+        normalized = {"environment_id": ENVIRONMENT, "root": ROOT, "python": PYTHON,
+            "source_basis": SOURCE_BASIS, "scope": SCOPE, "port": port, "max_session_reads": 1}
+        return cls(ENVIRONMENT, ROOT, PYTHON, SOURCE_BASIS, digest(normalized))
+
+    def plan(self):
+        return {"schema": "d1a-bootstrap-plan/1", "status": "DEPLOYMENT_PREPARED_OFFLINE",
+            "environment_id": self.environment_id, "config_digest": self.config_digest,
+            "root": self.deployment_root, "python": self.python_executable,
+            "bind_address": "127.0.0.1", "port": 27443, "TLS_REQUIRED": True,
+            "dormant": True, "max_session_reads": 1, "approved_reads": 0,
+            "D1B_authorized": False, "P1_authorized": False, "P2_authorized": False,
+            "INSTANCE_RUNNING": False, "runtime_verification": "PENDING"}
+
+
+def validate_path_facts(config, facts):
+    """Trusted offline/provisioner facts, never inferred from request booleans."""
+    _require(type(facts) is dict and set(facts) == {"root", "root_exists", "ancestor_reparse", "source_isolation", "producer"}, "PATH_DENIED")
+    _require(_path(facts["root"]) == _path(config.deployment_root) and facts["root_exists"] is False
+         and facts["ancestor_reparse"] is False and facts["source_isolation"] is True
+         and facts["producer"] == "OFFLINE_PATH_PROVIDER", "PATH_DENIED")
+
+
+def check_dependency_facts(facts):
+    _require(type(facts) is dict and set(facts) == {"python", "architecture", "crypto", "sqlite", "imported"}, "DEPENDENCY_RUNTIME_GAP")
+    _require(facts["python"] == "3.12.14" and facts["architecture"] == "AMD64"
+        and facts["crypto"] == "50.0.2" and type(facts["imported"]) is bool, "DEPENDENCY_RUNTIME_GAP")
+    try:
+        version = tuple(int(x) for x in facts["sqlite"].split("."))
+    except Exception:
+        raise RuntimeRefusal("DEPENDENCY_RUNTIME_GAP") from None
+    _require(version >= (3, 16, 0), "DEPENDENCY_RUNTIME_GAP")
+    return {**facts, "status": "PACKAGE_IMPORTABLE" if facts["imported"] else "METADATA_PRESENT",
+            "Authority_runtime_compatible": False}
+
+
+def probe_offline_dependencies():
+    import sys
+    import struct
+    import sqlite3
+    import cryptography
+    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+    _require(callable(AESGCM), "DEPENDENCY_RUNTIME_GAP")
+    return check_dependency_facts({"python": ".".join(map(str, sys.version_info[:3])),
+        "architecture": "AMD64" if struct.calcsize("P") == 8 else "OTHER",
+        "crypto": cryptography.__version__, "sqlite": sqlite3.sqlite_version, "imported": True})
+
+
+def build_synthetic_seed(config, *, grant_id, handle, material):
+    _id(grant_id); _id(handle)
+    _require(type(material) is str and material.startswith("synthetic_") and 1 <= len(material) <= 4096)
+    scope = dict(SCOPE)
+    origin = {"grant_id": grant_id, **{k: scope[k] for k in ("caller", "task", "account", "audience", "generation")}}
+    approval = {"approval_op": "h2_approval_001", **{k: scope[k] for k in ("caller", "task", "account", "audience", "generation")},
+                "operations": ["issue"], "budget": 1, "material": material}
+    grant = {**origin, "operations": ["issue"], "handle": handle, "material": material,
+             "active": True, "limit": 1, "reserved": 1, "spent": 0}
+    request = normalized_request({"rid": scope["rid"], "handle": handle,
+        **{k: scope[k] for k in ("task", "account", "audience", "generation")}, "operation": "issue", "payload": {}})
+    saved = {"rid": scope["rid"], "digest": digest({"caller": scope["caller"], "request": request}),
+             "origin": origin, "request": request, "phase": "QUEUED", "attempt_id": None,
+             "release_version": None, "result_digest": None, "result_material": None}
+    state = {"grants": {grant_id: grant}, "requests": {scope["rid"]: saved},
+        "grant_ops": {"h2_approval_001": {"digest": digest(approval), "grant_id": grant_id}},
+        "revoke_ops": {}, "disposals": {}, "reconciliation_windows": {}}
+    return {"state": state, "version": 2, "history": [{"version": 1, "operation": "synthetic_grant_prepare"},
+        {"version": 2, "operation": "synthetic_admit_prepare"}], "provenance": "NEW_SYNTHETIC_PROVISIONING_NOT_AS_HISTORY"}
+
+
+def encrypt_public_test_seed(seed, key, nonce):
+    """Offline public vector only. No key generation/loading/persistence."""
+    _require(type(key) is bytes and len(key) == 32 and type(nonce) is bytes and len(nonce) == 12)
+    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+    return nonce + AESGCM(key).encrypt(nonce, canonical(seed["state"]), b"auth-lifecycle/online-state/schema-1")
+
+
+def public_test_seed_roundtrip(blob, key):
+    from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+    try:
+        return json.loads(AESGCM(key).decrypt(blob[:12], blob[12:], b"auth-lifecycle/online-state/schema-1"))
+    except Exception:
+        raise RuntimeRefusal("CONFIG_INVALID") from None
+
+
+def prepare_public_memory_database(connection, seed, ciphertext):
+    """Schema2 preparation on an explicitly owned memory DB; no file DB path."""
+    try:
+        locations = connection.execute("PRAGMA database_list").fetchall()
+        _require(len(locations) == 1 and locations[0][2] == "", "PATH_DENIED")
+        existing = connection.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()
+        _require(not existing and type(seed) is dict and type(seed["version"]) is int and seed["version"] == 2)
+        _require(type(ciphertext) is bytes and len(ciphertext) >= 28)
+        connection.execute("BEGIN IMMEDIATE")
+        connection.execute("CREATE TABLE authority_state(id INTEGER PRIMARY KEY CHECK(id=1),version INTEGER NOT NULL,ciphertext BLOB NOT NULL)")
+        connection.execute("CREATE TABLE authority_events(version INTEGER PRIMARY KEY,operation TEXT NOT NULL,projection TEXT NOT NULL)")
+        connection.execute("PRAGMA user_version=2")
+        connection.execute("INSERT INTO authority_state VALUES(1,?,?)", (2, ciphertext))
+        for event in seed["history"]:
+            connection.execute("INSERT INTO authority_events VALUES(?,?,?)", (event["version"], event["operation"],
+                               canonical({"provenance": seed["provenance"]}).decode()))
+        connection.execute("COMMIT")
+        return {"schema_version": 2, "state_version": 2, "history_count": 2, "source": "PUBLIC_MEMORY_FIXTURE_ONLY"}
+    except RuntimeRefusal:
+        raise
+    except Exception:
+        if connection.in_transaction:
+            connection.rollback()
+        raise RuntimeRefusal("CONFIG_INVALID") from None
+
+
+class RuntimeContext:
+    __slots__ = ("__weakref__",)
+
+    def __init__(self, *args, **kwargs):
+        raise RuntimeRefusal("CONTEXT_REQUIRED")
+
+    @classmethod
+    def from_offline_host(cls, config, *, process, source_digest):
+        _require(type(config) is RuntimeConfig and type(process) is dict and set(process) == {"pid", "created_at", "epoch", "python", "source_kind"})
+        _require(type(process["pid"]) is int and 1 <= process["pid"] <= 2147483647
+             and process["source_kind"] == "OFFLINE_SIMULATION" and _path(process["python"]) == _path(PYTHON))
+        _id(process["created_at"]); _id(process["epoch"])
+        _require(type(source_digest) is str and re.fullmatch(r"[0-9a-f]{64}", source_digest) is not None, "SOURCE_MISMATCH")
+        context = object.__new__(cls)
+        _CONTEXTS[context] = {"config": config, "process": dict(process), "source_digest": source_digest,
+            "store": None, "connection": None, "lock": None, "server": None,
+            "closed": False, "bound": False, "events": [], "registrations": 0}
+        return context
+
+    def _record(self):
+        rec = _CONTEXTS.get(self)
+        _require(rec is not None, "CONTEXT_REQUIRED")
+        _require(not rec["closed"], "CONTEXT_CLOSED")
+        return rec
+
+    def validate_service_entry(self, role, root, ticket=None):
+        self._record()
+        # No live context issuer is provided in D1-A. Fail before config I/O.
+        raise RuntimeRefusal("D1B_NOT_AUTHORIZED")
+
+    def bind_store(self, store):
+        rec = self._record()
+        _require(not rec["bound"], "CONTEXT_ALREADY_BOUND")
+        rec.update(store=store, connection=store.connection, lock=store.lock, bound=True)
+        rec["registrations"] += 1
+        rec["events"].append("dormant_bind")
+
+    def _bound(self, store=None):
+        rec = self._record()
+        _require(rec["bound"] and (store is None or store is rec["store"]), "SOURCE_MISMATCH")
+        _require(rec["store"].connection is rec["connection"] and rec["store"].lock is rec["lock"], "SOURCE_MISMATCH")
+        return rec
+
+    def on_listener_ready(self, server, store):
+        rec = self._bound(store)
+        _require(rec["server"] is None or rec["server"] is server, "SOURCE_MISMATCH")
+        # Adopt an owned adapter result before policy validation, so failure
+        # still closes it through the enclosing lifecycle finally.
+        rec["server"] = server
+        _require(server.server_address == ("127.0.0.1", 27443) and server.TLS_REQUIRED is True, "PORT_CONFLICT")
+        rec["events"].append("listener_simulated")
+
+    def metadata(self):
+        rec = self._bound()
+        return {"schema": META_SCHEMA, "environment_id": ENVIRONMENT, "service_role": "authority",
+            "source_kind": "OFFLINE_SIMULATION", "process": dict(rec["process"]),
+            "source_digest": rec["source_digest"], "config_digest": rec["config"].config_digest,
+            "endpoint": {"address": "127.0.0.1", "port": 27443, "TLS_REQUIRED": True},
+            "references": {"DB": "authority/authority.db", "key": "secure/authority.key", "key_type": "NEW_TEST_STATE_KEY"},
+            "mount_state": "DORMANT_SOURCE_BOUND", "P2_read_enabled": False, "permits_issued": 0,
+            "session_reads": 0, "registrations": rec["registrations"], "missing_fields": list(GAPS),
+            "INSTANCE_RUNNING": False}
+
+    def issue_permit(self):
+        self._record()
+        raise RuntimeRefusal("P2_NOT_AUTHORIZED")
+
+    read_state = issue_permit
+
+    def close_owned(self):
+        rec = _CONTEXTS.get(self)
+        _require(rec is not None, "CONTEXT_REQUIRED")
+        if rec["closed"]:
+            return
+        rec["closed"] = True
+        failed = False
+        try:
+            if rec["server"] is not None:
+                try:
+                    rec["server"].shutdown()
+                except Exception:
+                    failed = True
+                finally:
+                    try:
+                        rec["server"].server_close()
+                    except Exception:
+                        failed = True
+        finally:
+            if rec["connection"] is not None:
+                try:
+                    rec["connection"].close()
+                except Exception:
+                    failed = True
+        if failed:
+            raise RuntimeRefusal("OFFLINE_ADAPTER_FAILED") from None
+
+    def counters(self):
+        rec = _CONTEXTS.get(self)
+        _require(rec is not None, "CONTEXT_REQUIRED")
+        return {"registrations": rec["registrations"], "closed": rec["closed"],
+                "permits": 0, "session_reads": 0, "events": list(rec["events"])}
+
+    def __repr__(self):
+        return "<AuthorityRuntimeContext redacted>"
+
+    def __reduce_ex__(self, protocol):
+        raise TypeError("RUNTIME_CONTEXT_NOT_SERIALIZABLE")
+
+
+def validate_runtime_context(context, role, root, ticket=None):
+    _require(type(context) is RuntimeContext, "CONTEXT_REQUIRED")
+    return context.validate_service_entry(role, root, ticket)
+
+
+def simulate_bootstrap(config, context, adapters):
+    _require(type(config) is RuntimeConfig and type(context) is RuntimeContext, "CONTEXT_REQUIRED")
+    rec = context._record()
+    _require(rec["config"] == config, "SOURCE_MISMATCH")
+    validate_path_facts(config, adapters.path_facts(config))
+    check_dependency_facts(adapters.dependency_facts())
+    schema = adapters.schema_facts()
+    _require(type(schema) is dict and schema == {"user_version": 2, "state_present": True, "producer": "OFFLINE_SCHEMA_PROVIDER"}, "CONFIG_INVALID")
+    _require(type(schema["user_version"]) is int and schema["state_present"] is True)
+    rec["events"].extend(["config_preflight", "dependency_preflight", "schema_preflight"])
+    try:
+        store = adapters.construct_store(config)
+        rec["events"].append("store_constructed")
+        context.bind_store(store)
+        try:
+            server = adapters.prepare_listener("127.0.0.1", 27443, TLS_REQUIRED=True)
+        except Exception:
+            raise RuntimeRefusal("PORT_CONFLICT") from None
+        context.on_listener_ready(server, store)
+        return context.metadata()
+    except RuntimeRefusal:
+        raise
+    except Exception:
+        raise RuntimeRefusal("OFFLINE_ADAPTER_FAILED") from None
+    finally:
+        context.close_owned()
+
+
+def validate_metadata(value):
+    fields = {"schema", "environment_id", "service_role", "source_kind", "process", "source_digest", "config_digest",
+        "endpoint", "references", "mount_state", "P2_read_enabled", "permits_issued", "session_reads",
+        "registrations", "missing_fields", "INSTANCE_RUNNING"}
+    _require(type(value) is dict and set(value) == fields and value["schema"] == META_SCHEMA, "METADATA_INVALID")
+    _require(value["environment_id"] == ENVIRONMENT and value["service_role"] == "authority"
+        and value["source_kind"] == "OFFLINE_SIMULATION" and value["P2_read_enabled"] is False
+        and value["INSTANCE_RUNNING"] is False and value["permits_issued"] == 0 and value["session_reads"] == 0
+        and value["registrations"] == 1 and value["mount_state"] == "DORMANT_SOURCE_BOUND", "METADATA_INVALID")
+    _require(all(type(value[k]) is int for k in ("permits_issued", "session_reads", "registrations")), "METADATA_INVALID")
+    _require(value["endpoint"] == {"address": "127.0.0.1", "port": 27443, "TLS_REQUIRED": True}, "METADATA_INVALID")
+    _require(value["references"] == {"DB": "authority/authority.db", "key": "secure/authority.key", "key_type": "NEW_TEST_STATE_KEY"}, "METADATA_INVALID")
+    p = value["process"]
+    _require(type(p) is dict and set(p) == {"pid", "created_at", "epoch", "python", "source_kind"}
+        and type(p["pid"]) is int and p["pid"] > 0 and p["source_kind"] == "OFFLINE_SIMULATION"
+        and _path(p["python"]) == _path(PYTHON), "METADATA_INVALID")
+    _id(p["created_at"]); _id(p["epoch"])
+    _require(value["missing_fields"] == list(GAPS), "METADATA_INVALID")
+    _require(all(type(value[k]) is str and re.fullmatch(r"[0-9a-f]{64}", value[k]) for k in ("source_digest", "config_digest")), "METADATA_INVALID")
+    _require(len(canonical(value)) <= 16384, "METADATA_INVALID")
+    return json.loads(canonical(value))
+
+
+def inspect_offline_metadata(request, provider):
+    _require(type(request) is dict and set(request) == {"environment_id", "pid", "created_at", "epoch", "source_digest", "config_digest"}, "TARGET_MISMATCH")
+    _require(request["environment_id"] == ENVIRONMENT and type(request["pid"]) is int, "TARGET_MISMATCH")
+    try:
+        observed = provider.read_one(request["pid"])
+    except Exception:
+        raise RuntimeRefusal("METADATA_INVALID") from None
+    value = validate_metadata(observed)
+    p = value["process"]
+    _require(all(request[k] == p[k] for k in ("pid", "created_at", "epoch"))
+        and all(request[k] == value[k] for k in ("source_digest", "config_digest")), "TARGET_MISMATCH")
+    return value
+
+
+def p1b_static_contract():
+    return {"statements": list(P1B_STATEMENTS), "maximum": 2, "mode": "ro", "immutable": False,
+            "world_SELECT": 0, "key": 0, "decrypt": 0, "authorized": False, "executed": False}
