{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vdns.local/schemas/g7/dataset-manifest.schema.json",
  "title": "VDNS-PM G7 dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetVersion",
    "generator",
    "seed",
    "classification",
    "containsRealUserData",
    "warmupRepetitions",
    "measuredRepetitions",
    "datasets",
    "generationRules"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "datasetVersion": {
      "const": "vdns-pm-g7-datasets-v1"
    },
    "generator": {
      "const": "cmd/g7-research-runner"
    },
    "seed": {
      "const": 20260723
    },
    "classification": {
      "const": "TEST_ONLY"
    },
    "containsRealUserData": {
      "const": false
    },
    "warmupRepetitions": {
      "type": "integer",
      "minimum": 1
    },
    "measuredRepetitions": {
      "type": "integer",
      "minimum": 30
    },
    "datasets": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description"
        ]
      }
    },
    "generationRules": {
      "type": "object"
    }
  }
}
