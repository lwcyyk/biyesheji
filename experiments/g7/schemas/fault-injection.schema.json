{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vdns.local/schemas/g7/fault-injection.schema.json",
  "title": "VPass G7 fault injection evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "seed",
    "startedAt",
    "finishedAt",
    "scenarios",
    "passed"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "seed": {
      "const": 20260723
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scenarios": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "component",
          "fault",
          "expected",
          "command",
          "exitCode",
          "outputDigest",
          "outputPath",
          "passed"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "fault": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exitCode": {
            "type": "integer"
          },
          "outputDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "outputPath": {
            "type": "string"
          },
          "durationNanoseconds": {
            "type": "integer",
            "minimum": 0
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "passed": {
      "type": "boolean"
    }
  }
}
