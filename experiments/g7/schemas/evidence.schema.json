{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vdns.local/schemas/g7/evidence.schema.json",
  "title": "VPass G7 experiment evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetVersion",
    "datasetDigest",
    "seed",
    "environment",
    "metrics",
    "experiments",
    "claimBoundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "datasetVersion": {
      "const": "vdns-pm-g7-datasets-v1"
    },
    "datasetDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "seed": {
      "const": 20260723
    },
    "environment": {
      "type": "object"
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "experiments": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8
    },
    "claimBoundary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment",
        "name",
        "unit",
        "samples",
        "p50",
        "p95",
        "p99",
        "mean",
        "standardDeviation",
        "bootstrap95Low",
        "bootstrap95High",
        "allocatedBytes",
        "cpuUserNanoseconds",
        "cpuSystemNanoseconds",
        "maxRssBytes",
        "target",
        "passed"
      ],
      "properties": {
        "experiment": {
          "pattern": "^E[1-8]$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "unit": {
          "const": "nanoseconds"
        },
        "samples": {
          "type": "integer",
          "minimum": 30
        },
        "p50": {
          "type": "integer",
          "minimum": 0
        },
        "p95": {
          "type": "integer",
          "minimum": 0
        },
        "p99": {
          "type": "integer",
          "minimum": 0
        },
        "mean": {
          "type": "number",
          "minimum": 0
        },
        "standardDeviation": {
          "type": "number",
          "minimum": 0
        },
        "bootstrap95Low": {
          "type": "number",
          "minimum": 0
        },
        "bootstrap95High": {
          "type": "number",
          "minimum": 0
        },
        "allocatedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "cpuUserNanoseconds": {
          "type": "integer",
          "minimum": 0
        },
        "cpuSystemNanoseconds": {
          "type": "integer",
          "minimum": 0
        },
        "maxRssBytes": {
          "type": "integer",
          "minimum": 0
        },
        "target": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
