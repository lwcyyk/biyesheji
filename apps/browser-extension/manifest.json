{
  "manifest_version": 3,
  "name": "VDNS-PM",
  "version": "0.5.0",
  "description": "VDNS 可验证密码生命周期管理器研究原型",
  "action": {
    "default_title": "VDNS-PM",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
