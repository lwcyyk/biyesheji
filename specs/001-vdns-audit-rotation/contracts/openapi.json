{
  "openapi": "3.1.0",
  "info": {
    "title": "VPass Local Client API",
    "version": "2.1.0",
    "description": "VPass 本地客户端接口的 Spec 2.1.0 / G6 研究原型合同。主密码、网站密码、RecoverySecret 与根秘密不得作为普通 JSON 值传输；secretHandle 由受信 secure-input/Native Messaging 通道创建。E0-E5 已进入领域模型和接口。真实 E4 Connector 与 SCOPE-ZK 仍为 NOT_IMPLEMENTED。可信状态解析只有配置完整 L1-L5 验证器时才返回结果。服务端兼容冻结的 VDNS-PM v2 路径和头字段，它们不再作为当前产品名称。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}/api/v2",
      "description": "Random authenticated loopback port",
      "variables": {
        "port": { "default": "43821" }
      }
    }
  ],
  "security": [
    { "InstallToken": [] }
  ],
  "tags": [
    { "name": "Vault" },
    { "name": "Passwords" },
    { "name": "Credentials" },
    { "name": "Lifecycle" },
    { "name": "Sync" },
    { "name": "Devices" },
    { "name": "State Verification" },
    { "name": "Audit" },
    { "name": "Optional Remediation" }
  ],
  "paths": {
    "/vault-sessions": {
      "post": {
        "tags": ["Vault"],
        "operationId": "createVaultSession",
        "summary": "用本地安全输入句柄解锁当前设备密码库",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/RequestNonce" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateVaultSessionRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Vault unlocked",
            "headers": { "Location": { "schema": { "type": "string" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/VaultSession" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/Validation" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/vault-sessions/{sessionId}": {
      "delete": {
        "tags": ["Vault"],
        "operationId": "deleteVaultSession",
        "summary": "锁定密码库并销毁活动 secret handles",
        "parameters": [
          { "$ref": "#/components/parameters/SessionId" },
          { "$ref": "#/components/parameters/RequestNonce" }
        ],
        "responses": {
          "204": { "description": "Vault locked" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/password-generations": {
      "post": {
        "tags": ["Passwords"],
        "operationId": "createPasswordGeneration",
        "summary": "按站点策略生成一次性密码句柄",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/VaultSessionHeader" },
          { "$ref": "#/components/parameters/RequestNonce" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordGenerationRequest" } } }
        },
        "responses": {
          "201": { "description": "Generated handle", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SecretHandle" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/Validation" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/credential-route-resolutions": {
      "post": {
        "tags": ["Credentials"],
        "operationId": "createCredentialRouteResolution",
        "summary": "由规范 Origin 和账号选择解析本地 CredentialID",
        "parameters": [
          { "$ref": "#/components/parameters/VaultSessionHeader" },
          { "$ref": "#/components/parameters/RequestNonce" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RouteResolutionRequest" } } }
        },
        "responses": {
          "200": { "description": "Resolved local route", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RouteResolution" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/Validation" }
        }
      }
    },
    "/credentials": {
      "get": {
        "tags": ["Credentials"],
        "operationId": "listCredentials",
        "summary": "分页列出本地可见凭据摘要",
        "parameters": [
          { "$ref": "#/components/parameters/VaultSessionHeader" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": { "description": "Credential page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CredentialPage" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "tags": ["Credentials"],
        "operationId": "createCredential",
        "summary": "创建字段级加密凭据 v1",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/VaultSessionHeader" },
          { "$ref": "#/components/parameters/RequestNonce" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateCredentialRequest" } } }
        },
        "responses": {
          "201": { "description": "Credential created or pending global proof", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Credential" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/Validation" }
        }
      }
    },
    "/credentials/{credentialId}": {
      "get": {
        "tags": ["Credentials"],
        "operationId": "getCredential",
        "summary": "读取凭据摘要及当前可信版本，不返回字段明文",
        "parameters": [
          { "$ref": "#/components/parameters/CredentialId" },
          { "$ref": "#/components/parameters/VaultSessionHeader" }
        ],
        "responses": {
          "200": { "description": "Credential summary", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Credential" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/credentials/{credentialId}/autofill-authorizations": {
      "post": {
        "tags": ["Credentials", "State Verification"],
        "operationId": "createAutofillAuthorization",
        "summary": "验证可信状态、对象和 Origin 后创建单次密码句柄",
        "parameters": [
          { "$ref": "#/components/parameters/CredentialId" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/VaultSessionHeader" },
          { "$ref": "#/components/parameters/RequestNonce" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AutofillAuthorizationRequest" } } }
        },
        "responses": {
          "201": { "description": "Authorized one-time handle", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AutofillAuthorization" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/Validation" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/credentials/{credentialId}/versions": {
      "get": {
        "tags": ["Lifecycle"],
        "operationId": "listCredentialVersions",
        "summary": "分页读取版本和证明状态",
        "parameters": [
          { "$ref": "#/components/parameters/CredentialId" },
          { "$ref": "#/components/parameters/VaultSessionHeader" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": { "description": "Version page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CredentialVersionPage" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["Lifecycle"],
        "operationId": "createCredentialVersion",
        "summary": "创建本地耐久更新候选",
        "parameters": [
          { "$ref": "#/components/parameters/CredentialId" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/VaultSessionHeader" },
          { "$ref": "#/components/parameters/RequestNonce" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateVersionRequest" } } } },
        "responses": {
          "201": { "description": "Candidate persisted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CredentialVersion" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/Validation" }
        }
      }
    },
    "/credentials/{credentialId}/site-confirmations": {
      "post": {
        "tags": ["Lifecycle"],
        "operationId": "createSiteConfirmation",
        "summary": "提交网站回执或用户签名确认",
        "parameters": [
          { "$ref": "#/components/parameters/CredentialId" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/VaultSessionHeader" },
          { "$ref": "#/components/parameters/RequestNonce" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SiteConfirmationRequest" } } } },
        "responses": {
          "201": { "description": "Confirmation recorded", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CredentialVersion" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/Validation" }
        }
      }
    },
    "/sync-publications": {
      "post": {
        "tags": ["Sync"],
        "operationId": "createSyncPublication",
        "summary": "发布签名 manifest 和加密对象",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/VaultSessionHeader" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SyncPublicationRequest" } } } },
        "responses": {
          "202": { "description": "Publication queued", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationStatus" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/sync-pulls": {
      "post": {
        "tags": ["Sync"],
        "operationId": "createSyncPull",
        "summary": "拉取并验证候选对象，不信任云端 current 指针",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/VaultSessionHeader" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SyncPullRequest" } } } },
        "responses": {
          "202": { "description": "Pull accepted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationStatus" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/device-enrollments": {
      "post": {
        "tags": ["Devices"],
        "operationId": "createDeviceEnrollment",
        "summary": "批准一次性挑战并为新设备封装根包",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/VaultSessionHeader" },
          { "$ref": "#/components/parameters/RequestNonce" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceEnrollmentRequest" } } } },
        "responses": {
          "201": { "description": "Enrollment created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationStatus" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/device-revocations": {
      "post": {
        "tags": ["Devices"],
        "operationId": "createDeviceRevocation",
        "summary": "撤销设备并排队新秘密代际",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/VaultSessionHeader" },
          { "$ref": "#/components/parameters/RequestNonce" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceRevocationRequest" } } } },
        "responses": {
          "202": { "description": "Revocation queued", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationStatus" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/recovery-sessions": {
      "post": {
        "tags": ["Devices", "Vault"],
        "operationId": "createRecoverySession",
        "summary": "使用本地 RecoverySecret 句柄开始恢复",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/RequestNonce" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecoverySessionRequest" } } } },
        "responses": {
          "201": { "description": "Recovery verification started", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationStatus" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/state-resolutions": {
      "post": {
        "tags": ["State Verification"],
        "operationId": "createStateResolution",
        "summary": "执行 L1-L5 并返回本地 Verdict",
        "parameters": [
          { "$ref": "#/components/parameters/VaultSessionHeader" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StateResolutionRequest" } } } },
        "responses": {
          "200": { "description": "Resolution verdict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StateResolution" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "501": { "$ref": "#/components/responses/OptionalUnavailable" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/vdns-resolutions": {
      "post": {
        "deprecated": true,
        "tags": ["State Verification"],
        "operationId": "createLegacyVdnsResolution",
        "summary": "兼容冻结 VDNS-PM v2 客户端的旧状态解析路径",
        "parameters": [
          { "$ref": "#/components/parameters/VaultSessionHeader" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StateResolutionRequest" } } } },
        "responses": {
          "200": { "description": "Resolution verdict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StateResolution" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "501": { "$ref": "#/components/responses/OptionalUnavailable" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/audit-events": {
      "post": {
        "tags": ["Audit"],
        "operationId": "createAuditEvent",
        "summary": "发布加密使用证据",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/VaultSessionHeader" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuditEventRequest" } } } },
        "responses": {
          "202": { "description": "Audit event durable and queued", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationStatus" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/Validation" }
        }
      }
    },
    "/security-analyses": {
      "post": {
        "tags": ["Audit"],
        "operationId": "createSecurityAnalysis",
        "summary": "执行重复、异常设备、陈旧和冲突安全检查",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/VaultSessionHeader" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SecurityAnalysisRequest" } } } },
        "responses": {
          "202": { "description": "Analysis queued", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationStatus" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/exposure-analyses": {
      "post": {
        "tags": ["Optional Remediation"],
        "operationId": "createExposureAnalysis",
        "summary": "可选：固定事故快照并运行 SCOPE-ZK",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/VaultSessionHeader" },
          { "$ref": "#/components/parameters/RequestNonce" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExposureAnalysisRequest" } } } },
        "responses": {
          "202": { "description": "Optional analysis queued", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationStatus" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "501": { "$ref": "#/components/responses/OptionalUnavailable" }
        }
      }
    },
    "/remediation-campaigns": {
      "post": {
        "tags": ["Optional Remediation"],
        "operationId": "createRemediationCampaign",
        "summary": "可选：为已固定影响集合创建修复计划",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/VaultSessionHeader" },
          { "$ref": "#/components/parameters/RequestNonce" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RemediationCampaignRequest" } } } },
        "responses": {
          "201": { "description": "Campaign created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationStatus" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "501": { "$ref": "#/components/responses/OptionalUnavailable" }
        }
      }
    },
    "/operations/{operationId}": {
      "get": {
        "tags": ["Lifecycle"],
        "operationId": "getOperation",
        "summary": "读取异步操作状态",
        "parameters": [
          { "$ref": "#/components/parameters/OperationId" },
          { "$ref": "#/components/parameters/VaultSessionHeader" }
        ],
        "responses": {
          "200": { "description": "Operation status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationStatus" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "InstallToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "random-local-installation-token",
        "description": "仅存本机受限文件/OS key store；不作为 vault 解锁凭据。"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 16, "maxLength": 128 }
      },
      "RequestNonce": {
        "name": "X-VPass-Request-Nonce",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 22, "maxLength": 128 },
        "description": "绑定扩展安装和短期会话的一次性 nonce。服务端仍兼容 deprecated X-VDNS-Request-Nonce。"
      },
      "VaultSessionHeader": {
        "name": "X-VPass-Vault-Session",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "format": "uuid" },
        "description": "VPass 密码库会话。服务端仍兼容 deprecated X-VDNS-Vault-Session。"
      },
      "SessionId": { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "CredentialId": { "name": "credentialId", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/Identifier32" } },
      "OperationId": { "name": "operationId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "Cursor": { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 512 } },
      "Limit": { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 } }
    },
    "schemas": {
      "Identifier16": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$", "description": "16 bytes, unpadded base64url" },
      "Identifier32": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$", "description": "32 bytes, unpadded base64url" },
      "Digest32": { "$ref": "#/components/schemas/Identifier32" },
      "CreateVaultSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deviceId", "masterPasswordHandle"],
        "properties": {
          "deviceId": { "$ref": "#/components/schemas/Identifier16" },
          "masterPasswordHandle": { "type": "string", "format": "uuid", "description": "由本机 secure-input 通道产生；不是主密码值。" }
        }
      },
      "VaultSession": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId", "deviceId", "state", "expiresAt"],
        "properties": {
          "sessionId": { "type": "string", "format": "uuid" },
          "deviceId": { "$ref": "#/components/schemas/Identifier16" },
          "state": { "type": "string", "enum": ["UNLOCKED"] },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "PasswordGenerationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["origin", "accountId", "policyVersion"],
        "properties": {
          "origin": { "type": "string", "format": "uri", "maxLength": 2048 },
          "accountId": { "type": "string", "minLength": 1, "maxLength": 512 },
          "policyVersion": { "type": "integer", "minimum": 1 },
          "length": { "type": "integer", "minimum": 12, "maximum": 256 }
        }
      },
      "SecretHandle": {
        "type": "object",
        "additionalProperties": false,
        "required": ["secretHandle", "fieldType", "singleUse", "expiresAt"],
        "properties": {
          "secretHandle": { "type": "string", "format": "uuid" },
          "fieldType": { "type": "string", "enum": ["PASSWORD", "USERNAME", "TOTP", "RECOVERY_CODES", "NOTE"] },
          "singleUse": { "const": true },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "RouteResolutionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["origin"],
        "properties": {
          "origin": { "type": "string", "format": "uri", "maxLength": 2048 },
          "accountId": { "type": "string", "maxLength": 512 },
          "topFrame": { "type": "boolean", "default": true }
        }
      },
      "RouteResolution": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credentialId", "accountLabel", "originVerified"],
        "properties": {
          "credentialId": { "$ref": "#/components/schemas/Identifier32" },
          "accountLabel": { "type": "string" },
          "originVerified": { "type": "boolean" }
        }
      },
      "CreateCredentialRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["origin", "accountId", "usernameHandle", "passwordHandle", "cryptoPolicyHash"],
        "properties": {
          "origin": { "type": "string", "format": "uri", "maxLength": 2048 },
          "accountId": { "type": "string", "minLength": 1, "maxLength": 512 },
          "usernameHandle": { "type": "string", "format": "uuid" },
          "passwordHandle": { "type": "string", "format": "uuid" },
          "totpHandle": { "type": "string", "format": "uuid" },
          "recoveryCodesHandle": { "type": "string", "format": "uuid" },
          "notesHandle": { "type": "string", "format": "uuid" },
          "cryptoPolicyHash": { "$ref": "#/components/schemas/Digest32" }
        }
      },
      "Credential": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credentialId", "activeVersion", "lifecycleStatus", "verdict", "descriptorHash"],
        "properties": {
          "credentialId": { "$ref": "#/components/schemas/Identifier32" },
          "accountLabel": { "type": "string" },
          "activeVersion": { "type": "integer", "minimum": 1 },
          "lifecycleStatus": { "type": "string", "enum": ["ACTIVE", "UPDATE_PENDING", "SITE_CONFIRM_PENDING", "SUSPENDED", "SUPERSEDED", "REVOKED", "CONFLICTED"] },
          "verdict": { "$ref": "#/components/schemas/Verdict" },
          "descriptorHash": { "$ref": "#/components/schemas/Digest32" }
        }
      },
      "CredentialPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "maxItems": 200, "items": { "$ref": "#/components/schemas/Credential" } },
          "nextCursor": { "type": "string" }
        }
      },
      "AutofillAuthorizationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["origin", "fieldType", "expectedVersion"],
        "properties": {
          "origin": { "type": "string", "format": "uri", "maxLength": 2048 },
          "fieldType": { "type": "string", "enum": ["USERNAME", "PASSWORD", "TOTP"] },
          "expectedVersion": { "type": "integer", "minimum": 1 },
          "allowCachedDegradedRead": { "type": "boolean", "default": false }
        }
      },
      "AutofillAuthorization": {
        "allOf": [
          { "$ref": "#/components/schemas/SecretHandle" },
          {
            "type": "object",
            "required": ["credentialId", "credentialVersion", "verdict", "originVerified"],
            "properties": {
              "credentialId": { "$ref": "#/components/schemas/Identifier32" },
              "credentialVersion": { "type": "integer", "minimum": 1 },
              "verdict": { "$ref": "#/components/schemas/Verdict" },
              "originVerified": { "const": true }
            }
          }
        ]
      },
      "CreateVersionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedVersion", "previousDescriptorHash", "fieldUpdates"],
        "properties": {
          "expectedVersion": { "type": "integer", "minimum": 1 },
          "previousDescriptorHash": { "$ref": "#/components/schemas/Digest32" },
          "fieldUpdates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fieldType", "secretHandle"],
              "properties": {
                "fieldType": { "type": "string", "enum": ["ORIGIN", "USERNAME", "PASSWORD", "TOTP", "RECOVERY_CODES", "NOTE"] },
                "secretHandle": { "type": "string", "format": "uuid" }
              }
            }
          }
        }
      },
      "CredentialVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credentialId", "version", "state", "descriptorHash"],
        "properties": {
          "credentialId": { "$ref": "#/components/schemas/Identifier32" },
          "version": { "type": "integer", "minimum": 1 },
          "state": { "type": "string", "enum": ["CANDIDATE_LOCAL", "SITE_CHANGE_IN_PROGRESS", "SITE_CHANGED_LOCAL_COMMIT_PENDING", "SITE_CONFIRM_PENDING", "REVIEW_REQUIRED", "ACTIVE", "SUPERSEDED", "FAILED", "UNKNOWN", "ABORTED"] },
          "descriptorHash": { "$ref": "#/components/schemas/Digest32" },
          "evidenceLevel": { "$ref": "#/components/schemas/EvidenceLevel" }
        }
      },
      "CredentialVersionPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "maxItems": 200, "items": { "$ref": "#/components/schemas/CredentialVersion" } },
          "nextCursor": { "type": "string" }
        }
      },
      "SiteConfirmationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["expectedVersion", "candidateVersion", "outcome", "evidenceLevel"],
        "properties": {
          "expectedVersion": { "type": "integer", "minimum": 1 },
          "candidateVersion": { "type": "integer", "minimum": 2 },
          "outcome": { "type": "string", "enum": ["SUCCEEDED", "FAILED", "MFA_REQUIRED", "POLICY_REJECTED", "UNKNOWN"] },
          "evidenceLevel": { "$ref": "#/components/schemas/EvidenceLevel" },
          "receiptDigest": { "$ref": "#/components/schemas/Digest32" }
        }
      },
      "EvidenceLevel": {
        "type": "string",
        "description": "v2.1 evidence level. E0-E2 never activate; E3 is conditional; E4/E5 require policy verification. Legacy v2.0 values are not silently reinterpreted.",
        "enum": ["AUTOFILL_OBSERVED", "SUBMIT_OBSERVED", "PAGE_SUCCESS_INDICATED", "NEW_PASSWORD_RELOGIN_CONFIRMED", "SITE_SIGNED_RECEIPT", "USER_SIGNED_CONFIRMATION"]
      },
      "Verdict": { "type": "string", "enum": ["ACCEPT", "DEGRADED_OFFLINE", "DEGRADED_PENDING_LOG", "REVIEW_REQUIRED", "REJECT_IDENTITY", "REJECT_CAPABILITY", "REJECT_REVOKED", "REJECT_CAUSAL", "REJECT_PROOF", "REJECT_ORIGIN", "REJECT_POLICY", "REJECT_OBJECT"] },
      "SyncPublicationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["baseCheckpointHash"],
        "properties": { "baseCheckpointHash": { "$ref": "#/components/schemas/Digest32" }, "maxObjects": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 1000 } }
      },
      "SyncPullRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trustedCheckpointHash"],
        "properties": { "trustedCheckpointHash": { "$ref": "#/components/schemas/Digest32" }, "cursor": { "type": "string", "maxLength": 512 }, "limit": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 1000 } }
      },
      "DeviceEnrollmentRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["challengeId", "newDeviceId", "authPublicKey", "hpkePublicKey", "requestedCapabilities", "shortCodeConfirmed"],
        "properties": {
          "challengeId": { "type": "string", "format": "uuid" },
          "newDeviceId": { "$ref": "#/components/schemas/Identifier16" },
          "authPublicKey": { "$ref": "#/components/schemas/Identifier32" },
          "hpkePublicKey": { "$ref": "#/components/schemas/Identifier32" },
          "requestedCapabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["READ", "AUTOFILL", "PUBLISH_AUDIT", "CREATE", "UPDATE", "ROTATE", "MIGRATE", "REVOKE", "DEVICE_ENROLL", "RELATION_PUBLISH", "AUDIT_ANALYZE"] } },
          "shortCodeConfirmed": { "const": true }
        }
      },
      "DeviceRevocationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deviceId", "reason", "expectedIssuanceCounter"],
        "properties": {
          "deviceId": { "$ref": "#/components/schemas/Identifier16" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
          "expectedIssuanceCounter": { "type": "integer", "minimum": 1 }
        }
      },
      "RecoverySessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespaceId", "newDeviceId", "recoverySecretHandle"],
        "properties": {
          "namespaceId": { "$ref": "#/components/schemas/Identifier16" },
          "newDeviceId": { "$ref": "#/components/schemas/Identifier16" },
          "recoverySecretHandle": { "type": "string", "format": "uuid" }
        }
      },
      "StateResolutionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credentialId", "operation", "trustedCheckpointHash"],
        "properties": {
          "credentialId": { "$ref": "#/components/schemas/Identifier32" },
          "operation": { "type": "string", "enum": ["RESOLVE", "AUTOFILL", "CREATE", "UPDATE_PREPARE", "UPDATE_CONFIRM", "SYNC_ACCEPT", "ROTATE", "MIGRATE", "REVOKE", "AUDIT_ANALYZE"] },
          "trustedCheckpointHash": { "$ref": "#/components/schemas/Digest32" },
          "allowCachedDegradedRead": { "type": "boolean", "default": false }
        }
      },
      "StateResolution": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resolutionId", "credentialId", "activeVersion", "activeEnvelopeHash", "descriptorHash", "verdict", "layerResults"],
        "properties": {
          "resolutionId": { "type": "string", "format": "uuid" },
          "credentialId": { "$ref": "#/components/schemas/Identifier32" },
          "activeVersion": { "type": "integer", "minimum": 1 },
          "activeEnvelopeHash": { "$ref": "#/components/schemas/Digest32" },
          "descriptorHash": { "$ref": "#/components/schemas/Digest32" },
          "verdict": { "$ref": "#/components/schemas/Verdict" },
          "layerResults": { "type": "object", "required": ["l1", "l2", "l3", "l4", "l5"], "properties": { "l1": { "type": "string" }, "l2": { "type": "string" }, "l3": { "type": "string" }, "l4": { "type": "string" }, "l5": { "type": "string" } } },
          "proofBundleDigest": { "$ref": "#/components/schemas/Digest32" }
        }
      },
      "AuditEventRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credentialId", "evidenceLevel", "encryptedPayloadDigest", "epoch"],
        "properties": {
          "credentialId": { "$ref": "#/components/schemas/Identifier32" },
          "evidenceLevel": { "$ref": "#/components/schemas/EvidenceLevel" },
          "encryptedPayloadDigest": { "$ref": "#/components/schemas/Digest32" },
          "epoch": { "type": "integer", "minimum": 0 }
        }
      },
      "SecurityAnalysisRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["analysisTypes", "sourceCheckpointHash"],
        "properties": {
          "analysisTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["PASSWORD_REUSE", "HISTORICAL_USE", "STALE_CREDENTIAL", "ANOMALOUS_DEVICE", "ROLLBACK", "CONFLICT"] } },
          "sourceCheckpointHash": { "$ref": "#/components/schemas/Digest32" },
          "windowStart": { "type": "string", "format": "date-time" },
          "windowEnd": { "type": "string", "format": "date-time" }
        }
      },
      "ExposureAnalysisRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["incidentSecretHandle", "snapshotRoot", "windowStart", "windowEnd"],
        "properties": {
          "incidentSecretHandle": { "type": "string", "format": "uuid" },
          "snapshotRoot": { "$ref": "#/components/schemas/Digest32" },
          "windowStart": { "type": "string", "format": "date-time" },
          "windowEnd": { "type": "string", "format": "date-time" },
          "proofSystem": { "type": "string", "enum": ["SCOPE_ZK", "GENERIC_ZKVM"] }
        }
      },
      "RemediationCampaignRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exposureAnalysisId", "costPolicyHash", "actions"],
        "properties": {
          "exposureAnalysisId": { "type": "string", "format": "uuid" },
          "costPolicyHash": { "$ref": "#/components/schemas/Digest32" },
          "actions": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "type": "string", "enum": ["ROTATE_PASSWORD", "REVOKE_SESSION", "CHANGE_RECOVERY_CHANNEL", "REMOVE_SSO_BINDING", "RESET_MFA", "REVOKE_DEVICE", "REVOKE_API_TOKEN"] } }
        }
      },
      "OperationStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "state"],
        "properties": {
          "operationId": { "type": "string", "format": "uuid" },
          "state": { "type": "string", "enum": ["QUEUED", "RUNNING", "COMPLETED", "PENDING", "FAILED", "UNKNOWN"] },
          "resultReference": { "type": "string" },
          "error": { "$ref": "#/components/schemas/Error" }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "requestId"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
          "message": { "type": "string", "maxLength": 1024 },
          "requestId": { "type": "string", "format": "uuid" },
          "details": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "responses": {
      "Unauthorized": { "description": "Installation token, vault session or local nonce invalid", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "Capability, scope, Origin or local policy rejected", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Resource not found within authorized scope", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "CAS, idempotency, version, descriptor or lifecycle conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Validation": { "description": "Canonicalization, schema, size or policy validation failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "RateLimited": { "description": "Rate or resource limit reached", "headers": { "Retry-After": { "schema": { "type": "integer", "minimum": 1 } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unavailable": { "description": "Required proof/object unavailable; no unverified state accepted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "OptionalUnavailable": { "description": "Optional SCOPE-ZK/remediation module is not enabled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}
