from Compiler.types import sgf2n, cgf2n
from Compiler.library import print_ln, check_point, runtime_error_if

# Both parties provide synthetic inputs; 0x8000...00 times 2 must reduce to 0x87.
a = sgf2n.get_input_from(0)
b = sgf2n.get_input_from(1)
check_point()
z = (a * b).reveal()
check_point()
runtime_error_if(z != cgf2n(0x87), 'GF2_128_REDUCTION_MISMATCH')
rho, rho_inv = sgf2n.get_random_inverse()
one = (rho * rho_inv).reveal()
check_point()
runtime_error_if(one != cgf2n(1), 'INVERSE_PREPROCESSING_MISMATCH')
print_ln('SMOKE_OK field=GF2_128 active_backend=mascot')
