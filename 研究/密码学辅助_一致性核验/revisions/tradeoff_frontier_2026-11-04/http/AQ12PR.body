  <entry>
    <id>http://arxiv.org/abs/2101.09590v4</id>
    <title>The density of polynomials of degree $n$ over $\mathbb{Z}_p$ having exactly $r$ roots in $\mathbb{Q}_p$</title>
    <updated>2022-03-25T19:10:20Z</updated>
    <link href="https://arxiv.org/abs/2101.09590v4" rel="alternate" type="text/html"/>
    <link href="https://arxiv.org/pdf/2101.09590v4" rel="related" type="application/pdf" title="pdf"/>
    <summary>We determine the probability that a random polynomial of degree $n$ over $\mathbb{Z}_p$ has exactly $r$ roots in $\mathbb{Q}_p$, and show that it is given by a rational function of $p$ that is invariant under replacing $p$ by $1/p$.</summary>
    <category term="math.NT" scheme="http://arxiv.org/schemas/atom"/>
    <published>2021-01-23T21:47:17Z</published>
    <arxiv:comment>22 pages; to appear in the Proceedings of the London Mathematical Society; this version includes further details in the proof of Lemma 3.5</arxiv:comment>
    <arxiv:primary_category term="math.NT"/>
    <author>
      <name>Manjul Bhargava</name>
    </author>
