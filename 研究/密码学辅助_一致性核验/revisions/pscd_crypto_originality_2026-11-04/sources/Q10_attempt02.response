503-9_14"}},"issued":{"date-parts":[[null]]},"ISBN":["9780387362328"],"references-count":12,"URL":"https:\/\/doi.org\/10.1007\/978-0-387-36503-9_14"},{"indexed":{"date-parts":[[2026,10,16]],"date-time":"2026-10-16T15:54:30Z","timestamp":1792166070219,"version":"4.4.0"},"reference-count":0,"publisher":"The Intelligent Networks and Systems Society","issue":"11","content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["IJIES"],"DOI":"10.22266\/ijies2026.1130.35","type":"journal-article","created":{"date-parts":[[2026,10,16]],"date-time":"2026-10-16T15:26:06Z","timestamp":1792164366000},"page":"668-681","source":"Crossref","is-referenced-by-count":0,"title":["ZKP-PAC: Accountable and Attribute-private Access Control for EHRs with Batch-verifiable Zero-knowledge Proofs and Provably Secure Revocation on Hyperledger Fabric"],"prefix":"10.22266","volume":"19","author":[{"given":"Komal","family":"Patiyal","sequence":"first","affiliation":[{"name":"Department of Computer Science and Engineering, CT University, Ludhiana, Punjab 142024, India"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Rupali","family":"Dhir","sequence":"additional","affiliation":[{"name":"Department of Computer Science and Engineering, CT University, Ludhiana, Punjab 142024, India"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"9527","published-online":{"date-parts":[[2026,11,30]]},"container-title":["International Journal of Intelligent Engineering and Systems"],"deposited":{"date-parts":[[2026,10,16]],"date-time":"2026-10-16T15:26:16Z","timestamp":1792164376000},"score":27.079792,"resource":{"primary":{"URL":"https:\/\/inass.org\/wp-content\/uploads\/2026\/08\/2026113035-1.pdf"}},"issued":{"date-parts":[[2026,11,30]]},"references-count":0,"journal-issue":{"issue":"11","published-online":{"date-parts":[[2026,11,30]]}},"URL":"https:\/\/doi.org\/10.22266\/ijies2026.1130.35","ISSN":["2185-3118"],"issn-type":[{"value":"2185-3118","type":"electronic"}],"published":{"date-parts":[[2026,11,30]]}},{"indexed":{"date-parts":[[2026,7,29]],"date-time":"2026-07-29T14:07:05Z","timestamp":1785334025621,"version":"3.55.0"},"posted":{"date-parts":[[2026]]},"group-title":"SSRN","reference-count":0,"publisher":"Elsevier BV","license":[{"start":{"date-parts":[[2026,1,1]],"date-time":"2026-01-01T00:00:00Z","timestamp":1767225600000},"content-version":"unspecified","delay-in-days":0,"URL":"https:\/\/www.uspto.gov\/ip-policy\/copyright-policy\/copyright-basics"}],"content-domain":{"domain":[],"crossmark-restriction":false},"abstract":"<jats:p>&lt;span&gt;This paper presents a zero-knowledge credential framework for secure and privacy-preserving attribute verification across multiple independent systems. The framework enables users to prove statements about their attributes without revealing the underlying values, while preventing cross-domain tracking by eliminating globally stable identifiers.&lt;\/span&gt;\n&lt;br&gt;\n&lt;br&gt;&lt;span&gt;The construction combines commitment schemes, digital signatures, zero-knowledge proofs, scoped pseudonyms, and accumulator-based revocation into a unified and modular design. Scoped identifiers ensure that user activity cannot be linked across different verification domains, while predicate proofs allow verification of conditions such as threshold checks without disclosing sensitive data. Revocation is supported through an efficient accumulator mechanism that enables verification without revealing credential identities and without increasing cost with the size of the revoked set.&lt;\/span&gt;\n&lt;br&gt;\n&lt;br&gt;&lt;span&gt;The system follows a complete lifecycle including credential issuance, proof generation, verification, and revocation checking. All proofs are non-interactive and bound to verifier-specific challenges, ensuring resistance to replay attacks. Security is based on standard cryptographic assumptions, providing guarantees for attribute privacy, proof soundness, unlinkability, and resistance to collusion.&lt;\/span&gt;\n&lt;br&gt;\n&lt;br&gt;&lt;span&gt;Experimental evaluation demonstrates that the framework achieves practical performance, with low verification latency, compact proof size, and stable scalability. The results show that strong privacy, verifiable authenticity, and efficient revocation can be achieved simultaneously without relying on trusted setup or pairing-based cryptography. The modular structure further supports integration with decentralized identity systems and real-world deployment scenarios.&lt;\/span&gt;<\/jats:p>","DOI":"10.2139\/ssrn.6677000","type":"posted-content","created":{"date-parts":[[2026,7,29]],"date-time":"2026-07-29T13:26:23Z","timestamp":1785331583000},"source":"Crossref","is-referenced-by-count":0,"title":["A Modular Zero-Knowledge Credential Framework for Multi-System Attribute Verification with Scoped Unlinkability and Efficient Accumulator-Based Revocation"],"prefix":"10.2139","author":[{"given":"Sayan","family":"Bairagi","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"78","deposited":{"date-parts":[[2026,7,29]],"date-time":"2026-07-29T13:26:23Z","timestamp":1785331583000},"score":26.998293,"resource":{"primary":{"URL":"https:\/\/www.ssrn.com\/abstract=6677000"}},"issued":{"date-parts":[[2026]]},"references-count":0,"URL":"https:\/\/doi.org\/10.2139\/ssrn.6677000","published":{"date-parts":[[2026]]},"subtype":"preprint"}],"items-per-page":5,"query":{"start-index":0,"search-terms":null}}}