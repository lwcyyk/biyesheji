+def wait_file(path, seconds=15):
+    deadline = time.monotonic() + seconds
+    while not path.exists() and time.monotonic() < deadline:
+        time.sleep(0.01)
+    if not path.exists():
+        raise TimeoutError("CONTROLLED_BARRIER_NOT_REACHED")
